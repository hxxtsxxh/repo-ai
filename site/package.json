    "qa": "npm run build && npm run check:links && npm run qa:a11y"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.5",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/starlight": "0.42.7",
    "astro": "7.4.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@resvg/resvg-js": "2.6.2",
    "playwright": "1.64.1"
