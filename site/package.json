{
  "name": "repo-ai-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Landing page and documentation for repo-ai (Astro + Starlight).",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
