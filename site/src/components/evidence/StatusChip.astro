---
/** A status label (evidence status or provider label). The text is always visible; colour only reinforces it. */
import type { Tone } from '../../data/facts';

interface Props {
  label: string;
  tone: Tone;
  dashed?: boolean;
}
const { label, tone, dashed = false } = Astro.props;
---

<span class:list={['ri-status', `ri-status--${tone}`, { 'ri-status--dashed': dashed }]}>{label.replace(/_/g, ' ')}</span>

<style>
  .ri-status {
    display: inline-block;
    font-family: var(--ri-font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.5;
    padding: 0.05rem 0.45rem;
    border: 1px solid currentColor;
    border-radius: 4px;
    white-space: nowrap;
    letter-spacing: 0.01em;
  }
  .ri-status--dashed {
    border-style: dashed;
  }
  .ri-status--pass {
    color: var(--ri-pass);
  }
  .ri-status--fail {
    color: var(--ri-fail);
  }
  .ri-status--pre {
    color: var(--ri-pre);
  }
  .ri-status--abstain {
    color: var(--ri-abstain);
  }
  .ri-status--unknown {
    color: var(--ri-unknown);
  }
</style>
