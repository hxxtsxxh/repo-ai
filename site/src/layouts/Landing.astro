---
/**
 * Layout for the non-Starlight pages (landing, 404). Self-contained: system
 * fonts, inline theme bootstrap, no third-party requests.
 */
import '../styles/tokens.css';
import '../styles/landing.css';
import logo from '../assets/logo.svg?raw';
import { site, sourceLabel } from '../config';

interface Props {
  title: string;
  description: string;
  /** Path relative to the base, e.g. "" for the home page. */
  path?: string;
  noindex?: boolean;
}
const { title, description, path = '', noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const siteUrl = (Astro.site?.toString() ?? 'https://hxxtsxxh.github.io/').replace(/\/?$/, '');
const canonical = `${siteUrl}${base}${path}`;
const ogImage = `${siteUrl}${base}og.png`;
const docs = `${base}docs/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}favicon-32.png`} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <meta name="theme-color" content="#0e1211" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f6f5f0" media="(prefers-color-scheme: light)" />
    <meta name="color-scheme" content="dark light" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="repo-ai" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="repo-ai: context before the change, evidence after it. A pass means the tests observed a pass." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>
      // Same storage key and values as Starlight's theme picker, so the choice carries across the site.
      (function () {
        try {
          var t = localStorage.getItem('starlight-theme');
          if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="brand" href={base} aria-label="repo-ai home">
          <span class="brand__mark" set:html={logo} aria-hidden="true" />
          <span class="brand__word">repo<span class="brand__dash">-</span>ai</span>
        </a>
        <nav class="site-nav" aria-label="Primary">
          <ul>
            <li class="site-nav__inpage"><a href={`${base}#how`}>How it works</a></li>
            <li class="site-nav__inpage"><a href={`${base}#evidence`}>Evidence</a></li>
            <li><a href={docs}>Docs</a></li>
          </ul>
        </nav>
        <div class="theme-picker">
          <label for="theme-select" class="visually-hidden">Color theme</label>
          <select id="theme-select" data-theme-select>
            <option value="auto">Auto</option>
            <option value="dark">Dark</option>
            <option value="light">Light</option>
          </select>
        </div>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <div class="site-footer__brand">
          <span class="brand__mark brand__mark--sm" set:html={logo} aria-hidden="true" />
          <p>
            repo-ai {site.version} · MIT licence · facts on this page checked {site.factsAsOf}
          </p>
        </div>
        <nav aria-label="Footer">
          <ul class="site-footer__links">
            <li><a href={docs}>Documentation</a></li>
            <li><a href={`${docs}status/`}>Status matrix</a></li>
            <li><a href={`${docs}security/`}>Security &amp; privacy</a></li>
            <li><a href={`${docs}evaluation/`}>Evaluation</a></li>
            <li><a href={`${docs}changelog/`}>Changelog</a></li>
            <li>
              {site.repoPublic ? <a href={site.githubRepo} rel="noopener">{sourceLabel}</a> : <span>{sourceLabel}</span>}
            </li>
          </ul>
        </nav>
      </div>
    </footer>

    <script>
      const select = document.querySelector<HTMLSelectElement>('[data-theme-select]');
      if (select) {
        let stored = '';
        try {
          stored = localStorage.getItem('starlight-theme') ?? '';
        } catch {}
        select.value = stored === 'light' || stored === 'dark' ? stored : 'auto';
        select.addEventListener('change', () => {
          const value = select.value;
          if (value === 'light' || value === 'dark') {
            document.documentElement.dataset.theme = value;
          } else {
            delete document.documentElement.dataset.theme;
          }
          try {
            localStorage.setItem('starlight-theme', value === 'auto' ? '' : value);
          } catch {}
        });
      }
    </script>
  </body>
</html>
