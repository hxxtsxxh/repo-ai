+
+
+def split_amount(cents, parts):
+    """Split integer cents into `parts` shares that differ by at most one cent.
+
+    The remainder cents go to the first shares, so the shares always sum to
+    `cents`: split_amount(100, 3) == [34, 33, 33].
+    """
+    if isinstance(parts, bool) or not isinstance(parts, int) or parts < 1:
+        raise InvoiceError(f"parts must be a positive integer: {parts!r}")
+    base, remainder = divmod(int(cents), parts)
+    return [base + 1] * remainder + [base] * (parts - remainder)
