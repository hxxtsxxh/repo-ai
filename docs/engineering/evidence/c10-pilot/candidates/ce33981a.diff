+def apply_discount(cents, percent):
+    """Return integer cents after taking `percent` percent off, rounded half-even."""
+    if not 0 <= percent <= 100:
+        raise InvoiceError(f"discount out of range: {percent!r}")
+    remaining = Decimal(int(cents)) * (100 - Decimal(str(percent))) / 100
+    return int(remaining.quantize(Decimal(1), rounding=ROUND_HALF_EVEN))
