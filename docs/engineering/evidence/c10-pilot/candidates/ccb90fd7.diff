+from decimal import ROUND_HALF_EVEN, Decimal
+
 from invoicekit.errors import InvoiceError
 
 
@@ -6,3 +8,20 @@ def line_total(qty, unit_cents):
     if qty < 0:
         raise InvoiceError("quantity must not be negative")
     return int(qty) * int(unit_cents)
+
+
+def invoice_total(lines, tax_rate):
+    """Invoice total including tax, in integer cents.
+
+    `lines` is a list of (qty, unit_cents) tuples and `tax_rate` is a
+    percentage from 0 to 100. Tax is rounded per line, then summed.
+    """
+    if not isinstance(tax_rate, (int, float)) or not 0 <= tax_rate <= 100:
+        raise InvoiceError("tax rate must be a percentage from 0 to 100")
+    rate = Decimal(str(tax_rate))
+    total = 0
+    for qty, unit_cents in lines:
+        subtotal = line_total(qty, unit_cents)
+        tax = (Decimal(subtotal) * rate / 100).quantize(Decimal(1), rounding=ROUND_HALF_EVEN)
+        total += subtotal + int(tax)
+    return total
