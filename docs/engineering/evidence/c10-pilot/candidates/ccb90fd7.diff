+def test_invoice_total_rounds_tax_per_line():
+    # Per line: 0 + 0 tax. On the subtotal it would be 1 cent.
+    assert invoice_total([(1, 50), (1, 50)], 1) == 100
+
+
+def test_invoice_total_rounds_half_to_even():
+    assert invoice_total([(1, 50)], 1) == 50    # 0.5 tax -> 0
+    assert invoice_total([(1, 150)], 1) == 152  # 1.5 tax -> 2
+
+
+@pytest.mark.parametrize("rate", [-1, 100.5, "8", None])
