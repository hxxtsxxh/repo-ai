+def split_amount(cents, parts):
+    """Split integer cents into `parts` near-equal shares that sum exactly to `cents`.
+
+    Leftover cents go to the earliest shares, so the list is non-increasing.
+    """
+    if isinstance(cents, bool) or not isinstance(cents, int):
+        raise InvoiceError(f"amount must be integer cents: {cents!r}")
+    if isinstance(parts, bool) or not isinstance(parts, int) or parts < 1:
+        raise InvoiceError(f"parts must be a positive integer: {parts!r}")
+    sign = -1 if cents < 0 else 1
+    base, extra = divmod(abs(cents), parts)
+    return [sign * (base + 1 if i < extra else base) for i in range(parts)]
+
