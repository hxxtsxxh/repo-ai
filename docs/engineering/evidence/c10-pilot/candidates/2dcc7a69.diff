+
+
+def invoice_total(lines, tax_rate):
+    """Invoice total in integer cents, including tax.
+
+    `lines` is a list of (qty, unit_cents) tuples; `tax_rate` is a percentage
+    such as 8.25. Tax is rounded to the nearest cent (half-even, as in money.py).
+    """
+    subtotal = sum(line_total(qty, unit_cents) for qty, unit_cents in lines)
+    tax = Decimal(subtotal) * Decimal(str(tax_rate)) / 100
+    return subtotal + int(tax.quantize(Decimal(1), rounding=ROUND_HALF_EVEN))
