     return int((value * 100).quantize(Decimal(1), rounding=ROUND_HALF_EVEN))
 
 
+def apply_discount(cents, percent):
+    """Return integer cents left after taking `percent` percent off `cents`."""
+    if isinstance(cents, bool) or not isinstance(cents, int):
+        raise InvoiceError(f"not an amount in cents: {cents!r}")
+    try:
+        rate = Decimal(str(percent).strip())
+    except InvalidOperation:
+        raise InvoiceError(f"not a percentage: {percent!r}") from None
+    if not rate.is_finite() or not 0 <= rate <= 100:
+        raise InvoiceError(f"percentage out of range: {percent!r}")
+    off = (Decimal(cents) * rate / 100).quantize(Decimal(1), rounding=ROUND_HALF_EVEN)
+    return cents - int(off)
+
+
