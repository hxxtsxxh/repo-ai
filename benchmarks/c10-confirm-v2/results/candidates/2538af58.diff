diff --git a/tests/test_resolve_config.py b/tests/test_resolve_config.py
new file mode 100644
index 0000000..f73c947
--- /dev/null
+++ b/tests/test_resolve_config.py
@@ -0,0 +1,63 @@
+import pytest
+
+from logsift.config import Config, resolve_config
+from logsift.errors import ConfigError
+
+
+def _write(tmp_path, content):
+    path = tmp_path / "logsift.toml"
+    path.write_text(content, encoding="utf-8")
+    return str(path)
+
+
+def test_no_file_and_no_environment_gives_defaults():
+    assert resolve_config(None, {}) == Config()
+
+
+def test_file_only(tmp_path):
+    path = _write(tmp_path, '[logsift]\nignore = ["healthcheck", "metrics"]\n')
+    assert resolve_config(path, {}) == Config(ignore=("healthcheck", "metrics"))
+
+
+def test_environment_only_without_file():
+    assert resolve_config(None, {"LOGSIFT_IGNORE": "healthcheck,metrics"}) == Config(
+        ignore=("healthcheck", "metrics")
+    )
+
+
+def test_environment_is_added_to_file_entries(tmp_path):
+    path = _write(tmp_path, '[logsift]\nignore = ["healthcheck"]\n')
+    config = resolve_config(path, {"LOGSIFT_IGNORE": "metrics,debug"})
+    assert config == Config(ignore=("healthcheck", "metrics", "debug"))
+
+
+def test_duplicates_are_dropped_keeping_first_occurrence(tmp_path):
+    path = _write(tmp_path, '[logsift]\nignore = ["healthcheck", "metrics"]\n')
+    config = resolve_config(path, {"LOGSIFT_IGNORE": "metrics,web,healthcheck,web"})
+    assert config == Config(ignore=("healthcheck", "metrics", "web"))
+
+
+def test_environment_items_are_stripped_and_empty_items_skipped():
+    config = resolve_config(None, {"LOGSIFT_IGNORE": " web , ,metrics,,"})
+    assert config == Config(ignore=("web", "metrics"))
+
+
+@pytest.mark.parametrize("value", ["", "  ", " , "])
+def test_blank_environment_value_changes_nothing(tmp_path, value):
+    path = _write(tmp_path, '[logsift]\nignore = ["web"]\n')
+    assert resolve_config(path, {"LOGSIFT_IGNORE": value}) == Config(ignore=("web",))
+
+
+def test_other_environment_variables_are_ignored():
+    assert resolve_config(None, {"LOGSIFT_COLOUR": "web", "PATH": "/bin"}) == Config()
+
+
+def test_missing_file_raises_config_error(tmp_path):
+    with pytest.raises(ConfigError, match="cannot read"):
+        resolve_config(str(tmp_path / "missing.toml"), {"LOGSIFT_IGNORE": "web"})
+
+
+def test_invalid_file_raises_config_error(tmp_path):
+    path = _write(tmp_path, '[logsift]\nignore = "web"\n')
+    with pytest.raises(ConfigError, match="'ignore' must be a list of strings"):
+        resolve_config(path, {"LOGSIFT_IGNORE": "metrics"})
