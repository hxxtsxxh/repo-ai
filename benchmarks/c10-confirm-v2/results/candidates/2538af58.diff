--- a/logsift/config.py
+++ b/logsift/config.py
@@ -1,17 +1,22 @@
-"""Loading the optional TOML configuration file.
+"""Loading the optional TOML configuration file and environment overrides.
 
 Example::
 
     [logsift]
     ignore = ["healthcheck", "metrics"]
+
+The ``LOGSIFT_IGNORE`` environment variable adds to the ``ignore`` list, as a
+comma-separated list such as ``healthcheck,metrics``.
 """
 
 import tomllib
+from collections.abc import Mapping
 from dataclasses import dataclass
 
 from .errors import ConfigError
 
 _KNOWN_KEYS = {"ignore"}
+ENV_IGNORE = "LOGSIFT_IGNORE"
 
 
 @dataclass(frozen=True)
@@ -40,3 +45,22 @@ def load_config(path: str) -> Config:
     if not isinstance(ignore, list) or not all(isinstance(item, str) for item in ignore):
         raise ConfigError(f"{path}: 'ignore' must be a list of strings")
     return Config(ignore=tuple(ignore))
+
+
+def _split_list(value: str) -> list[str]:
+    return [item.strip() for item in value.split(",") if item.strip()]
+
+
+def resolve_config(path: str | None, environ: Mapping[str, str]) -> Config:
+    """Return the effective settings from the config file and the environment.
+
+    The file at ``path`` is read when it is not None. ``ignore`` entries from
+    ``LOGSIFT_IGNORE`` are appended to the file's entries; duplicates are dropped
+    and the original order is kept.
+    """
+    config = load_config(path) if path is not None else Config()
+    ignore = list(config.ignore)
+    for item in _split_list(environ.get(ENV_IGNORE, "")):
+        if item not in ignore:
+            ignore.append(item)
+    return Config(ignore=tuple(ignore))
