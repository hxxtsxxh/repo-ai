diff --git a/tests/test_cli.py b/tests/test_cli.py
index 0b4b1b5..eff8b00 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -114,6 +114,67 @@ def test_malformed_line_is_an_error(tmp_path, capsys):
     assert captured.err == f"logsift: error: cannot parse {path} line 2: 'broken'\n"
 
 
+def test_summary_malformed_line_without_skip_invalid_is_error(tmp_path, capsys):
+    path = tmp_path / "trunc.log"
+    path.write_text("2026-03-04T10:00:00Z INFO web: ok\nbroken\n", encoding="utf-8")
+    assert main(["summary", str(path)]) == 1
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert captured.err == f"logsift: error: cannot parse {path} line 2: 'broken'\n"
+
+
+def test_summary_skip_invalid_counts_remaining_records(tmp_path, capsys):
+    path = tmp_path / "trunc.log"
+    path.write_text(
+        "2026-03-04T10:00:00Z INFO web: ok\n"
+        "2026-03-04T10:0\n"
+        "\n"
+        "2026-03-04T10:01:00Z ERROR db: connection lost\n"
+        "broken\n",
+        encoding="utf-8",
+    )
+    assert main(["summary", str(path), "--skip-invalid", "--format", "json"]) == 3
+    captured = capsys.readouterr()
+    assert json.loads(captured.out) == [
+        {"count": 1, "level": "ERROR"},
+        {"count": 1, "level": "INFO"},
+    ]
+    assert captured.err == (
+        f"logsift: warning: {path}:2: skipped unparseable line\n"
+        f"logsift: warning: {path}:5: skipped unparseable line\n"
+    )
+
+
+def test_summary_skip_invalid_warns_for_each_file(tmp_path, capsys):
+    first = tmp_path / "a.log"
+    second = tmp_path / "b.log"
+    first.write_text("2026-03-04T10:00:00Z INFO web: ok\nnope\n", encoding="utf-8")
+    second.write_text("bad line\n2026-03-04T10:00:00Z INFO web: ok\n", encoding="utf-8")
+    assert main(["summary", str(first), str(second), "--skip-invalid", "--format", "json"]) == 3
+    captured = capsys.readouterr()
+    assert json.loads(captured.out) == [{"count": 2, "level": "INFO"}]
+    assert captured.err == (
+        f"logsift: warning: {first}:2: skipped unparseable line\n"
+        f"logsift: warning: {second}:1: skipped unparseable line\n"
+    )
+
+
+def test_summary_skip_invalid_with_all_lines_invalid(tmp_path, capsys):
+    path = tmp_path / "junk.log"
+    path.write_text("junk\nmore junk\n", encoding="utf-8")
+    assert main(["summary", str(path), "--skip-invalid", "--format", "json"]) == 3
+    captured = capsys.readouterr()
+    assert json.loads(captured.out) == []
+    assert captured.err.count("skipped unparseable line") == 2
+
+
+def test_summary_skip_invalid_with_clean_input_is_success(sample_log, capsys):
+    assert main(["summary", str(sample_log), "--skip-invalid"]) == 0
+    captured = capsys.readouterr()
+    assert captured.err == ""
+    assert "ERROR         3" in captured.out
+
+
 def test_config_ignore_applies_to_reports(sample_log, tmp_path, capsys):
     config = tmp_path / "logsift.toml"
     config.write_text('[logsift]\nignore = ["healthcheck"]\n', encoding="utf-8")
