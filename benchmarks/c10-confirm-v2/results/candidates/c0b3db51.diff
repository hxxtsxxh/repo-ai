diff --git a/tests/test_span.py b/tests/test_span.py
new file mode 100644
index 0000000..031ceeb
--- /dev/null
+++ b/tests/test_span.py
@@ -0,0 +1,61 @@
+from datetime import timedelta
+
+from logsift.records import parse_line
+from logsift.render import format_duration, format_timestamp, format_timestamp_json, whole_seconds
+from logsift.stats import component_spans
+
+
+def _records(*lines):
+    return [parse_line(line, "t.log", n) for n, line in enumerate(lines, start=1)]
+
+
+def test_format_duration():
+    assert format_duration(0) == "0:00:00"
+    assert format_duration(3725) == "1:02:05"
+    assert format_duration(90000) == "25:00:00"
+
+
+def test_whole_seconds_truncates_fraction():
+    assert whole_seconds(timedelta(seconds=3725.9)) == 3725
+
+
+def test_timestamp_formats():
+    value = parse_line("2026-01-31T23:05:09.250Z INFO web: ok").time
+    assert format_timestamp(value) == "2026-01-31 23:05:09"
+    assert format_timestamp_json(value) == "2026-01-31T23:05:09Z"
+
+
+def test_component_spans_use_earliest_and_latest_time():
+    spans = component_spans(
+        _records(
+            "2026-03-04T10:05:00Z INFO web: late",
+            "2026-03-04T10:00:00Z INFO web: early",
+            "2026-03-04T10:02:00Z INFO web: middle",
+        )
+    )
+    assert len(spans) == 1
+    assert spans[0].count == 3
+    assert format_timestamp(spans[0].first) == "2026-03-04 10:00:00"
+    assert format_timestamp(spans[0].last) == "2026-03-04 10:05:00"
+    assert whole_seconds(spans[0].duration) == 300
+
+
+def test_component_spans_order_by_count_then_name():
+    spans = component_spans(
+        _records(
+            "2026-03-04T10:00:00Z INFO zeta: a",
+            "2026-03-04T10:00:00Z INFO alpha: a",
+            "2026-03-04T10:00:00Z INFO mid: a",
+            "2026-03-04T10:00:00Z INFO mid: b",
+        )
+    )
+    assert [span.component for span in spans] == ["mid", "alpha", "zeta"]
+
+
+def test_component_spans_of_no_records_is_empty():
+    assert component_spans([]) == []
+
+
+def test_single_record_has_zero_duration():
+    (span,) = component_spans(_records("2026-03-04T10:00:00Z INFO web: a"))
+    assert span.duration == timedelta(0)
