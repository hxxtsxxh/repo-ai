--- a/logsift/render.py
+++ b/logsift/render.py
@@ -2,6 +2,7 @@
 
 import json
 from collections.abc import Sequence
+from datetime import datetime, timedelta
 from typing import Any
 
 
@@ -32,3 +33,25 @@ def rows_to_objects(headers: Sequence[str], rows: Sequence[Sequence[Any]]) -> li
 def render_json(value: Any) -> str:
     """Render a value as indented JSON with sorted keys."""
     return json.dumps(value, indent=2, sort_keys=True, ensure_ascii=False) + "\n"
+
+
+def format_timestamp(value: datetime) -> str:
+    """Format a UTC time for text output, such as ``2026-01-31 23:05:09``."""
+    return value.strftime("%Y-%m-%d %H:%M:%S")
+
+
+def format_timestamp_json(value: datetime) -> str:
+    """Format a UTC time for JSON output, such as ``2026-01-31T23:05:09Z``."""
+    return value.strftime("%Y-%m-%dT%H:%M:%SZ")
+
+
+def whole_seconds(value: timedelta) -> int:
+    """Return a duration as whole seconds, dropping any fraction."""
+    return value // timedelta(seconds=1)
+
+
+def format_duration(seconds: int) -> str:
+    """Format whole seconds as ``H:MM:SS``; hours are not padded and may exceed 24."""
+    hours, rest = divmod(seconds, 3600)
+    minutes, secs = divmod(rest, 60)
+    return f"{hours}:{minutes:02d}:{secs:02d}"
diff --git a/logsift/stats.py b/logsift/stats.py
index 8962111..c0a93a7 100644
--- a/logsift/stats.py
+++ b/logsift/stats.py
@@ -3,12 +3,40 @@
 import re
 from collections import Counter
 from collections.abc import Iterable
+from dataclasses import dataclass
+from datetime import datetime, timedelta
 
 from .records import LogRecord
 
 _DIGITS_RE = re.compile(r"\d+")
 
 
+@dataclass(frozen=True)
+class ComponentSpan:
+    """How many records a component has and when they start and end (UTC)."""
+
+    component: str
+    count: int
+    first: datetime
+    last: datetime
+
+    @property
+    def duration(self) -> timedelta:
+        return self.last - self.first
+
+
+def component_spans(records: Iterable[LogRecord]) -> list[ComponentSpan]:
+    """Summarize each component's records; ordered by count, highest first, then by component name."""
+    times: dict[str, list[datetime]] = {}
+    for record in records:
+        times.setdefault(record.component, []).append(record.time)
+    spans = [
+        ComponentSpan(component=name, count=len(stamps), first=min(stamps), last=max(stamps))
+        for name, stamps in times.items()
+    ]
+    return sorted(spans, key=lambda span: (-span.count, span.component))
+
+
 def sort_counts(counts: Counter[str]) -> list[tuple[str, int]]:
     """Order counted keys by count, highest first, then by key."""
     return sorted(counts.items(), key=lambda item: (-item[1], item[0]))
