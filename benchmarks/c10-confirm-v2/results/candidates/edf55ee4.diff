+def test_span_text(sample_log, capsys):
+    assert main(["span", str(sample_log)]) == 0
+    captured = capsys.readouterr()
+    lines = [line.split() for line in captured.out.splitlines()]
+    assert lines == [
+        ["component", "count", "first", "last", "duration"],
+        ["db", "4", "2026-03-04T10:00:05+00:00", "2026-03-04T10:02:30+00:00", "145.0"],
+        ["healthcheck", "1", "2026-03-04T10:03:00+00:00", "2026-03-04T10:03:00+00:00", "0.0"],
+        ["web", "3", "2026-03-04T10:00:00+00:00", "2026-03-04T10:05:00+00:00", "300.0"],
+    ]
+    assert captured.err == ""
+
+
+def test_span_json(sample_log, capsys):
+    assert main(["span", str(sample_log), "--format", "json"]) == 0
+    assert json.loads(capsys.readouterr().out) == [
+        {
+            "component": "db",
+            "count": 4,
+            "first": "2026-03-04T10:00:05+00:00",
+            "last": "2026-03-04T10:02:30+00:00",
+            "duration": 145.0,
+        },
+        {
+            "component": "healthcheck",
+            "count": 1,
+            "first": "2026-03-04T10:03:00+00:00",
+            "last": "2026-03-04T10:03:00+00:00",
+            "duration": 0.0,
+        },
+        {
+            "component": "web",
+            "count": 3,
+            "first": "2026-03-04T10:00:00+00:00",
+            "last": "2026-03-04T10:05:00+00:00",
+            "duration": 300.0,
+        },
+    ]
+
+
+def test_span_across_files_uses_earliest_and_latest_times(sample_log, tmp_path, capsys):
+    other = tmp_path / "other.log"
+    other.write_text("2026-03-04T09:59:00Z INFO web: early start\n", encoding="utf-8")
+    assert main(["span", str(other), str(sample_log), "--format", "json"]) == 0
+    web = next(item for item in json.loads(capsys.readouterr().out) if item["component"] == "web")
+    assert web == {
+        "component": "web",
+        "count": 4,
+        "first": "2026-03-04T09:59:00+00:00",
+        "last": "2026-03-04T10:05:00+00:00",
+        "duration": 360.0,
+    }
+
+
+def test_span_respects_config_ignore(sample_log, tmp_path, capsys):
+    config = tmp_path / "logsift.toml"
+    config.write_text('[logsift]\nignore = ["healthcheck", "web"]\n', encoding="utf-8")
+    assert main(["--config", str(config), "span", str(sample_log), "--format", "json"]) == 0
+    assert [item["component"] for item in json.loads(capsys.readouterr().out)] == ["db"]
+
+
+def test_span_with_everything_ignored_is_empty(sample_log, tmp_path, capsys):
+    config = tmp_path / "logsift.toml"
+    config.write_text('[logsift]\nignore = ["db", "healthcheck", "web"]\n', encoding="utf-8")
+    assert main(["--config", str(config), "span", str(sample_log), "--format", "json"]) == 0
+    assert json.loads(capsys.readouterr().out) == []
+
+
