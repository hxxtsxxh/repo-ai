diff --git a/logsift/stats.py b/logsift/stats.py
index 8962111..2638f99 100644
--- a/logsift/stats.py
+++ b/logsift/stats.py
@@ -3,12 +3,47 @@
 import re
 from collections import Counter
 from collections.abc import Iterable
+from dataclasses import dataclass
+from datetime import datetime
 
 from .records import LogRecord
 
 _DIGITS_RE = re.compile(r"\d+")
 
 
+@dataclass
+class ComponentSpan:
+    """How many records a component logged, and when its first and last records were."""
+
+    component: str
+    count: int
+    first: datetime
+    last: datetime
+
+    @property
+    def duration(self) -> float:
+        """Seconds from the first record to the last."""
+        return (self.last - self.first).total_seconds()
+
+
+def component_spans(records: Iterable[LogRecord]) -> list[ComponentSpan]:
+    """Summarize each component's records by timestamp, ordered by component name.
+
+    ``first`` and ``last`` are the earliest and latest timestamps, so the order
+    of the records (within or across files) does not matter.
+    """
+    spans: dict[str, ComponentSpan] = {}
+    for record in records:
+        span = spans.get(record.component)
+        if span is None:
+            spans[record.component] = ComponentSpan(record.component, 1, record.time, record.time)
+        else:
+            span.count += 1
+            span.first = min(span.first, record.time)
+            span.last = max(span.last, record.time)
+    return [spans[name] for name in sorted(spans)]
+
+
 def sort_counts(counts: Counter[str]) -> list[tuple[str, int]]:
     """Order counted keys by count, highest first, then by key."""
     return sorted(counts.items(), key=lambda item: (-item[1], item[0]))
