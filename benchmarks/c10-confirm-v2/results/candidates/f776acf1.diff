diff --git a/tests/test_records.py b/tests/test_records.py
index faeb458..f15a995 100644
--- a/tests/test_records.py
+++ b/tests/test_records.py
@@ -3,7 +3,7 @@ from datetime import datetime, timezone
 import pytest
 
 from logsift.errors import LogsiftError, ParseError
-from logsift.records import level_rank, parse_line, read_records
+from logsift.records import level_rank, parse_line, read_records, read_records_skipping_invalid
 
 
 def test_parse_line_fields():
@@ -64,3 +64,29 @@ def test_read_records_rejects_invalid_utf8(tmp_path):
     path.write_bytes(b"2026-03-04T10:15:00Z INFO db: \xff\n")
     with pytest.raises(LogsiftError, match="not valid UTF-8"):
         read_records([str(path)])
+
+
+def test_read_records_raises_on_first_unparseable_line(tmp_path):
+    path = tmp_path / "bad.log"
+    path.write_text("broken\n2026-03-04T10:00:00Z INFO web: ok\n", encoding="utf-8")
+    with pytest.raises(ParseError) as excinfo:
+        read_records([str(path)])
+    assert (excinfo.value.path, excinfo.value.lineno) == (str(path), 1)
+
+
+def test_read_records_skipping_invalid_collects_skipped_lines(tmp_path):
+    first = tmp_path / "a.log"
+    second = tmp_path / "b.log"
+    first.write_text("2026-03-04T10:00:00Z INFO web: ok\nbroken\n\n", encoding="utf-8")
+    second.write_text("truncated 2026-03-04T1\n2026-03-04T10:01:00Z ERROR db: lost\n", encoding="utf-8")
+    records, skipped = read_records_skipping_invalid([str(first), str(second)])
+    assert [(r.source, r.lineno, r.level) for r in records] == [
+        (str(first), 1, "INFO"),
+        (str(second), 2, "ERROR"),
+    ]
+    assert [(e.path, e.lineno) for e in skipped] == [(str(first), 2), (str(second), 1)]
+
+
+def test_read_records_skipping_invalid_still_fails_on_missing_file(tmp_path):
+    with pytest.raises(LogsiftError, match="cannot read"):
+        read_records_skipping_invalid([str(tmp_path / "missing.log")])
