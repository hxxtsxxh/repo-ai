-                records.append(parse_line(line, path, lineno))
-    return records
+                yield path, lineno, line
+
+
+def read_records(paths: list[str]) -> list[LogRecord]:
+    """Read and parse every line of the given files, in the order given.
+
+    Blank lines are ignored. The first unparseable line raises ``ParseError``.
+    """
+    return [parse_line(line, path, lineno) for path, lineno, line in _non_blank_lines(paths)]
+
+
+def read_records_skipping_invalid(paths: list[str]) -> tuple[list[LogRecord], list[ParseError]]:
+    """Like ``read_records``, but unparseable lines are collected instead of raising.
+
+    Returns the records that parsed, in order, and one ``ParseError`` per skipped line, in order.
+    """
+    records: list[LogRecord] = []
+    skipped: list[ParseError] = []
+    for path, lineno, line in _non_blank_lines(paths):
+        try:
+            records.append(parse_line(line, path, lineno))
+        except ParseError as exc:
+            skipped.append(exc)
+    return records, skipped
diff --git a/tests/test_cli.py b/tests/test_cli.py
index 0b4b1b5..ba7d3a9 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -114,6 +114,62 @@ def test_malformed_line_is_an_error(tmp_path, capsys):
     assert captured.err == f"logsift: error: cannot parse {path} line 2: 'broken'\n"
 
 
+def test_summary_malformed_line_fails_without_skip_invalid(tmp_path, capsys):
+    path = tmp_path / "bad.log"
+    path.write_text("2026-03-04T10:00:00Z INFO web: ok\ntruncated 2026-03-04T1\n", encoding="utf-8")
+    assert main(["summary", str(path)]) == 1
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert captured.err == f"logsift: error: cannot parse {path} line 2: 'truncated 2026-03-04T1'\n"
+
+
+def test_summary_skip_invalid_counts_valid_records_and_warns(tmp_path, capsys):
+    path = tmp_path / "corrupt.log"
+    path.write_text(
+        "2026-03-04T10:00:00Z INFO web: ok\n"
+        "broken\n"
+        "2026-03-04T10:00:01Z ERROR db: lost\n"
+        "\n"
+        "2026-03-04T10:00:0\n",
+        encoding="utf-8",
+    )
+    assert main(["summary", str(path), "--skip-invalid"]) == 3
+    captured = capsys.readouterr()
+    assert captured.out == "level     count\nERROR         1\nINFO          1\n"
+    assert captured.err == (
+        f"logsift: warning: {path}:2: skipped unparseable line\n"
+        f"logsift: warning: {path}:5: skipped unparseable line\n"
+    )
+
+
+def test_summary_skip_invalid_without_bad_lines_returns_zero(sample_log, capsys):
+    assert main(["summary", str(sample_log), "--skip-invalid"]) == 0
+    captured = capsys.readouterr()
+    assert captured.out == (
+        "level     count\n"
+        "ERROR         3\n"
+        "INFO          2\n"
+        "CRITICAL      1\n"
+        "DEBUG         1\n"
+        "WARNING       1\n"
+    )
+    assert captured.err == ""
+
+
+def test_summary_skip_invalid_json_report(tmp_path, capsys):
+    path = tmp_path / "corrupt.log"
+    path.write_text("2026-03-04T10:00:00Z WARNING db: slow\nnope\n", encoding="utf-8")
+    assert main(["summary", str(path), "--skip-invalid", "--by", "component", "--format", "json"]) == 3
+    captured = capsys.readouterr()
+    assert json.loads(captured.out) == [{"component": "db", "count": 1}]
+    assert captured.err == f"logsift: warning: {path}:2: skipped unparseable line\n"
+
+
+def test_skip_invalid_is_not_a_filter_option(sample_log, capsys):
+    assert main(["filter", str(sample_log), "--skip-invalid"]) == 2
+    assert "unrecognized arguments: --skip-invalid" in capsys.readouterr().err
+
+
 def test_config_ignore_applies_to_reports(sample_log, tmp_path, capsys):
