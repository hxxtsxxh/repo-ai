+def test_span_text(sample_log, capsys):
+    assert main(["span", str(sample_log)]) == 0
+    captured = capsys.readouterr()
+    assert [line.split() for line in captured.out.splitlines()] == [
+        ["component", "count", "first", "last", "duration"],
+        ["db", "4", "2026-03-04T10:00:05+00:00", "2026-03-04T10:02:30+00:00", "0:02:25"],
+        ["web", "3", "2026-03-04T10:00:00+00:00", "2026-03-04T10:05:00+00:00", "0:05:00"],
+        ["healthcheck", "1", "2026-03-04T10:03:00+00:00", "2026-03-04T10:03:00+00:00", "0:00:00"],
+    ]
+    assert captured.err == ""
+
+
