diff --git a/logsift/stats.py b/logsift/stats.py
index 8962111..1b68976 100644
--- a/logsift/stats.py
+++ b/logsift/stats.py
@@ -3,17 +3,51 @@
 import re
 from collections import Counter
 from collections.abc import Iterable
+from dataclasses import dataclass
+from datetime import datetime, timedelta
 
 from .records import LogRecord
 
 _DIGITS_RE = re.compile(r"\d+")
 
 
+@dataclass(frozen=True)
+class ComponentSpan:
+    """How many records a component has and when they start and end."""
+
+    component: str
+    count: int
+    first: datetime
+    last: datetime
+
+    @property
+    def duration(self) -> timedelta:
+        return self.last - self.first
+
+
 def sort_counts(counts: Counter[str]) -> list[tuple[str, int]]:
     """Order counted keys by count, highest first, then by key."""
     return sorted(counts.items(), key=lambda item: (-item[1], item[0]))
 
 
+def component_spans(records: Iterable[LogRecord]) -> list[ComponentSpan]:
+    """Summarize each component's records, busiest component first.
+
+    ``first`` and ``last`` are the earliest and latest record times, regardless
+    of the order the records appear in.
+    """
+    counts: Counter[str] = Counter()
+    first: dict[str, datetime] = {}
+    last: dict[str, datetime] = {}
+    for record in records:
+        name = record.component
+        counts[name] += 1
+        first[name] = min(first.get(name, record.time), record.time)
+        last[name] = max(last.get(name, record.time), record.time)
+    spans = [ComponentSpan(name, counts[name], first[name], last[name]) for name in counts]
+    return sorted(spans, key=lambda span: (-span.count, span.component))
+
+
 def count_by(records: Iterable[LogRecord], field: str) -> list[tuple[str, int]]:
     """Count records by the value of one field, such as ``level`` or ``component``."""
     return sort_counts(Counter(getattr(record, field) for record in records))
