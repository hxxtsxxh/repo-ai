+def test_traffic_text(tmp_path, capsys):
+    log = tmp_path / "edge.log"
+    log.write_text(
+        "2026-03-04T10:00:00Z INFO cdn: GET /assets/app.js 200 bytes=48213\n"
+        "2026-03-04T10:00:01Z INFO api: GET /users 200 bytes=250\n"
+        "2026-03-04T10:00:02Z INFO cdn: GET /assets/logo.png 200 bytes=1000\n"
+        "2026-03-04T10:00:03Z INFO worker: job 7 finished\n",
+        encoding="utf-8",
+    )
+    assert main(["traffic", str(log)]) == 0
+    captured = capsys.readouterr()
+    assert captured.out == (
+        "component  bytes\n"
+        "cdn        49213\n"
+        "api          250\n"
+    )
+    assert captured.err == ""
+
+
+def test_traffic_json(tmp_path, capsys):
+    log = tmp_path / "edge.log"
+    log.write_text(
+        "2026-03-04T10:00:00Z INFO cdn: GET /assets/app.js 200 bytes=48213\n"
+        "2026-03-04T10:00:01Z INFO api: GET /users 200 bytes=250\n",
+        encoding="utf-8",
+    )
+    assert main(["traffic", str(log), "--format", "json"]) == 0
+    assert json.loads(capsys.readouterr().out) == [
+        {"component": "cdn", "bytes": 48213},
+        {"component": "api", "bytes": 250},
+    ]
+
+
+def test_traffic_with_no_bytes_records_prints_only_header(sample_log, capsys):
