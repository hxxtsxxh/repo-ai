@@ -1,6 +1,6 @@
 from logsift.filters import filter_records
-from logsift.records import read_records
-from logsift.stats import count_by, normalize_message, top_messages
+from logsift.records import parse_line, read_records
+from logsift.stats import bytes_by_component, count_by, normalize_message, top_messages
 
 
 def test_filter_by_min_level(sample_log):
@@ -31,6 +31,52 @@ def test_normalize_message_replaces_digit_runs():
     assert normalize_message("request 991 failed after 3 tries") == "request # failed after # tries"
 
 
+def _line(component, message):
+    return parse_line(f"2026-03-04T10:00:00Z INFO {component}: {message}")
+
+
+def test_bytes_by_component_sums_bytes_values():
+    records = [
+        _line("cdn", "GET /assets/app.js 200 bytes=48213"),
+        _line("cdn", "GET /assets/logo.png 200 bytes=1000"),
+        _line("api", "GET /users 200 bytes=250"),
+    ]
+    assert bytes_by_component(records) == {"cdn": 49213, "api": 250}
+
+
+def test_bytes_by_component_ignores_records_without_bytes():
+    records = [
+        _line("cdn", "GET /assets/app.js 200 bytes=48213"),
+        _line("cdn", "cache miss for /assets/app.js"),
+        _line("worker", "job 7 finished"),
+    ]
+    assert bytes_by_component(records) == {"cdn": 48213}
+
+
+def test_bytes_by_component_needs_whole_word_bytes_key():
+    records = [
+        _line("api", "payload sent_bytes=999"),
+        _line("api", "payload bytes=12"),
+    ]
+    assert bytes_by_component(records) == {"api": 12}
+
+
+def test_bytes_by_component_empty_input():
+    assert bytes_by_component([]) == {}
+
+
+def test_bytes_by_component_from_file(tmp_path):
+    path = tmp_path / "edge.log"
+    path.write_text(
+        "2026-03-04T10:00:00Z INFO cdn: GET /a.js 200 bytes=100\n"
+        "2026-03-04T10:00:01Z INFO api: GET /v1/x 200 bytes=7\n"
+        "2026-03-04T10:00:02Z INFO cdn: GET /b.js 304 bytes=0\n"
+        "2026-03-04T10:00:03Z WARNING db: slow\n",
+        encoding="utf-8",
+    )
+    assert bytes_by_component(read_records([str(path)])) == {"cdn": 100, "api": 7}
+
+
