diff --git a/logsift/stats.py b/logsift/stats.py
index 8962111..37a7bd8 100644
--- a/logsift/stats.py
+++ b/logsift/stats.py
@@ -7,6 +7,7 @@ from collections.abc import Iterable
 from .records import LogRecord
 
 _DIGITS_RE = re.compile(r"\d+")
+_BYTES_RE = re.compile(r"\bbytes=(\d+)\b")
 
 
 def sort_counts(counts: Counter[str]) -> list[tuple[str, int]]:
@@ -19,6 +20,21 @@ def count_by(records: Iterable[LogRecord], field: str) -> list[tuple[str, int]]:
     return sort_counts(Counter(getattr(record, field) for record in records))
 
 
+def bytes_by_component(records: Iterable[LogRecord]) -> dict[str, int]:
+    """Sum the ``bytes=<n>`` values in each component's messages.
+
+    Records whose message has no ``bytes=<n>`` are ignored, and components
+    without any such record are left out of the result.
+    """
+    totals: dict[str, int] = {}
+    for record in records:
+        match = _BYTES_RE.search(record.message)
+        if match is None:
+            continue
+        totals[record.component] = totals.get(record.component, 0) + int(match.group(1))
+    return totals
+
+
 def normalize_message(message: str) -> str:
     """Replace every run of digits with ``#`` so that similar messages group together."""
     return _DIGITS_RE.sub("#", message)
