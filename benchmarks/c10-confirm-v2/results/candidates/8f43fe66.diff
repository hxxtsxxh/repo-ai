index 8962111..d9573e4 100644
--- a/logsift/stats.py
+++ b/logsift/stats.py
@@ -3,12 +3,43 @@
 import re
 from collections import Counter
 from collections.abc import Iterable
+from dataclasses import dataclass
+from datetime import datetime, timedelta
 
 from .records import LogRecord
 
 _DIGITS_RE = re.compile(r"\d+")
 
 
+@dataclass(frozen=True)
+class ComponentSpan:
+    """How many records a component has and the time range they cover."""
+
+    component: str
+    count: int
+    first: datetime
+    last: datetime
+
+    @property
+    def duration(self) -> timedelta:
+        return self.last - self.first
+
+
+def span_by_component(records: Iterable[LogRecord]) -> list[ComponentSpan]:
+    """Return one span per component, highest count first, then by component name."""
+    totals: dict[str, list] = {}
+    for record in records:
+        entry = totals.get(record.component)
+        if entry is None:
+            totals[record.component] = [1, record.time, record.time]
+        else:
+            entry[0] += 1
+            entry[1] = min(entry[1], record.time)
+            entry[2] = max(entry[2], record.time)
+    spans = [ComponentSpan(name, count, first, last) for name, (count, first, last) in totals.items()]
+    return sorted(spans, key=lambda span: (-span.count, span.component))
+
+
 def sort_counts(counts: Counter[str]) -> list[tuple[str, int]]:
     """Order counted keys by count, highest first, then by key."""
     return sorted(counts.items(), key=lambda item: (-item[1], item[0]))
