 import json
 from collections.abc import Sequence
+from datetime import datetime, timedelta
 from typing import Any
 
+_ONE_SECOND = timedelta(seconds=1)
+
+
+def format_time(value: datetime) -> str:
+    """Format a UTC time for text output, such as ``2026-01-31 23:05:09``."""
+    return value.strftime("%Y-%m-%d %H:%M:%S")
+
+
+def format_time_json(value: datetime) -> str:
+    """Format a UTC time for JSON output, such as ``2026-01-31T23:05:09Z``."""
+    return value.strftime("%Y-%m-%dT%H:%M:%SZ")
+
+
+def duration_seconds(value: timedelta) -> int:
+    """Whole seconds in a duration, with any fraction dropped."""
+    return value // _ONE_SECOND
+
+
+def format_duration(value: timedelta) -> str:
+    """Format a duration as ``H:MM:SS``; hours are not padded and may exceed 24."""
+    hours, rest = divmod(duration_seconds(value), 3600)
+    minutes, seconds = divmod(rest, 60)
+    return f"{hours}:{minutes:02d}:{seconds:02d}"
+
 
