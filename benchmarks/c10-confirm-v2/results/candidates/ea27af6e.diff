diff --git a/tests/test_cli.py b/tests/test_cli.py
index 0b4b1b5..d85fea0 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -36,6 +36,89 @@ def test_summary_of_several_files(sample_log, tmp_path, capsys):
     ]
 
 
+def _one_record_log(tmp_path, name="other.log"):
+    path = tmp_path / name
+    path.write_text("2026-03-05T08:00:00Z CRITICAL db: disk full\n", encoding="utf-8")
+    return path
+
+
+def test_sources_text_counts_each_file(sample_log, tmp_path, capsys):
+    other = _one_record_log(tmp_path)
+    assert main(["sources", str(sample_log), str(other)]) == 0
+    captured = capsys.readouterr()
+    width = max(len("file"), len(str(sample_log)), len(str(other)))
+    assert captured.out == (
+        f"{'file'.ljust(width)}  count\n"
+        f"{str(sample_log).ljust(width)}      8\n"
+        f"{str(other).ljust(width)}      1\n"
+    )
+    assert captured.err == ""
+
+
+def test_sources_orders_by_count_then_file_name(sample_log, tmp_path, capsys):
+    other = _one_record_log(tmp_path)
+    b = tmp_path / "b.log"
+    a = tmp_path / "a.log"
+    b.write_text("2026-03-05T08:00:00Z INFO web: one\n", encoding="utf-8")
+    a.write_text("2026-03-05T08:00:00Z INFO web: two\n", encoding="utf-8")
+    # Given as b, other, a: the 8-record file comes first, then the two 1-record files by name.
+    assert main(["sources", str(b), str(sample_log), str(other), str(a), "--format", "json"]) == 0
+    assert json.loads(capsys.readouterr().out) == [
+        {"count": 8, "file": str(sample_log)},
+        {"count": 1, "file": str(a)},
+        {"count": 1, "file": str(b)},
+        {"count": 1, "file": str(other)},
+    ]
+
+
+def test_sources_no_header_leaves_out_header_line(sample_log, tmp_path, capsys):
+    other = _one_record_log(tmp_path)
+    assert main(["sources", str(sample_log), str(other), "--no-header"]) == 0
+    captured = capsys.readouterr()
+    width = max(len(str(sample_log)), len(str(other)))
+    assert captured.out == (
+        f"{str(sample_log).ljust(width)}  8\n"
+        f"{str(other).ljust(width)}  1\n"
+    )
+    assert captured.err == ""
+
+
+def test_sources_json_output(sample_log, tmp_path, capsys):
+    other = _one_record_log(tmp_path)
+    assert main(["sources", str(sample_log), str(other), "--format", "json"]) == 0
+    assert json.loads(capsys.readouterr().out) == [
+        {"count": 8, "file": str(sample_log)},
+        {"count": 1, "file": str(other)},
+    ]
+
+
+def test_sources_empty_file_counts_zero(sample_log, tmp_path, capsys):
+    empty = tmp_path / "empty.log"
+    empty.write_text("", encoding="utf-8")
+    assert main(["sources", str(sample_log), str(empty), "--no-header"]) == 0
+    lines = capsys.readouterr().out.splitlines()
+    assert lines[-1].endswith("  0")
+    assert lines[-1].startswith(str(empty))
+
+
+def test_sources_repeated_file_gets_one_row(sample_log, capsys):
+    assert main(["sources", str(sample_log), str(sample_log), "--format", "json"]) == 0
+    assert json.loads(capsys.readouterr().out) == [{"count": 8, "file": str(sample_log)}]
+
+
+def test_sources_missing_file_is_an_error(sample_log, tmp_path, capsys):
+    missing = tmp_path / "nope.log"
+    assert main(["sources", str(sample_log), str(missing)]) == 1
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert captured.err == f"logsift: error: cannot read {missing}: No such file or directory\n"
+
+
+def test_sources_requires_a_file(capsys):
+    assert main(["sources"]) == 2
+    assert "usage: logsift" in capsys.readouterr().err
+
+
