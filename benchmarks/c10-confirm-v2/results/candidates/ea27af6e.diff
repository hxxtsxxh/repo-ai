 import argparse
 import sys
+from collections import Counter
 from collections.abc import Sequence
 
 from .config import Config, load_config
@@ -68,6 +69,20 @@ def cmd_top(args: argparse.Namespace, config: Config) -> int:
     return 0
 
 
+def cmd_sources(args: argparse.Namespace, config: Config) -> int:
+    # Every record is counted; config.ignore applies to reports, not to file totals.
+    counts = Counter(record.source for record in read_records(args.files))
+    # One row per distinct file, ordered by count (highest first), then by file name.
+    rows = [(path, counts[path]) for path in dict.fromkeys(args.files)]
+    rows.sort(key=lambda row: (-row[1], row[0]))
+    headers = ["file", "count"]
+    if args.format == "json":
+        sys.stdout.write(render_json(rows_to_objects(headers, rows)))
+    else:
+        sys.stdout.write(render_table(headers, rows, header=not args.no_header))
+    return 0
+
+
 def cmd_export(args: argparse.Namespace, config: Config) -> int:
     records = filter_records(read_records(args.files), min_level=args.level, ignore=config.ignore)
     write_text(args.output, records_to_jsonl(records), force=args.force)
