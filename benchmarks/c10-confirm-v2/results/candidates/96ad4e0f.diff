diff --git a/tests/test_cli.py b/tests/test_cli.py
index 0b4b1b5..035560a 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -114,6 +114,55 @@ def test_malformed_line_is_an_error(tmp_path, capsys):
     assert captured.err == f"logsift: error: cannot parse {path} line 2: 'broken'\n"
 
 
+def test_summary_fails_on_malformed_line(tmp_path, capsys):
+    path = tmp_path / "bad.log"
+    path.write_text("2026-03-04T10:00:00Z INFO web: ok\nbroken\n", encoding="utf-8")
+    assert main(["summary", str(path)]) == 1
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert captured.err == f"logsift: error: cannot parse {path} line 2: 'broken'\n"
+
+
+def test_summary_skip_invalid_counts_good_lines_and_reports_each_skip(tmp_path, capsys):
+    path = tmp_path / "damaged.log"
+    path.write_text(
+        "2026-03-04T10:00:00Z INFO web: ok\n"
+        "2026-03-04T10:00:0\n"
+        "2026-03-04T10:00:05Z ERROR db: lost\n"
+        "\x00\x00garbage\n"
+        "2026-03-04T10:00:09Z ERROR db: lost again\n",
+        encoding="utf-8",
+    )
+    assert main(["summary", str(path), "--skip-invalid"]) == 0
+    captured = capsys.readouterr()
+    assert captured.out == "level     count\nERROR         2\nINFO          1\n"
+    assert captured.err == (
+        f"logsift: skipped invalid line: cannot parse {path} line 2: '2026-03-04T10:00:0'\n"
+        f"logsift: skipped invalid line: cannot parse {path} line 4: '\\x00\\x00garbage'\n"
+    )
+
+
+def test_summary_skip_invalid_json_keeps_stdout_clean(tmp_path, capsys):
+    path = tmp_path / "damaged.log"
+    path.write_text("2026-03-04T10:00:00Z INFO web: ok\nbroken\n", encoding="utf-8")
+    assert main(["summary", str(path), "--skip-invalid", "--format", "json"]) == 0
+    captured = capsys.readouterr()
+    assert json.loads(captured.out) == [{"level": "INFO", "count": 1}]
+    assert captured.err == f"logsift: skipped invalid line: cannot parse {path} line 2: 'broken'\n"
+
+
+def test_summary_skip_invalid_without_bad_lines_reports_nothing(sample_log, capsys):
+    assert main(["summary", str(sample_log), "--skip-invalid"]) == 0
+    captured = capsys.readouterr()
+    assert captured.err == ""
+    assert captured.out.splitlines()[0] == "level     count"
+
+
+def test_skip_invalid_is_only_for_summary(sample_log, capsys):
+    assert main(["filter", str(sample_log), "--skip-invalid"]) == 2
+    assert "unrecognized arguments: --skip-invalid" in capsys.readouterr().err
+
+
