+def test_read_records_collects_skipped_lines(tmp_path):
+    path = tmp_path / "damaged.log"
+    path.write_text(
+        "2026-03-04T10:00:00Z INFO web: ok\n"
+        "2026-03-04T10:00:0\n"
+        "\n"
+        "2026-03-04T10:00:05Z ERROR db: lost\n"
+        "garbage\n",
+        encoding="utf-8",
+    )
+    skipped: list[ParseError] = []
+    records = read_records([str(path)], skipped)
+    assert [record.lineno for record in records] == [1, 4]
+    assert [error.lineno for error in skipped] == [2, 5]
+    assert skipped[1].line == "garbage"
+    assert str(skipped[0]) == f"cannot parse {path} line 2: '2026-03-04T10:00:0'"
+
+
+def test_read_records_raises_without_skipped_list(tmp_path):
+    path = tmp_path / "bad.log"
+    path.write_text("garbage\n", encoding="utf-8")
+    with pytest.raises(ParseError):
+        read_records([str(path)])
+
+
