diff --git a/logsift/render.py b/logsift/render.py
index 68a77f3..69f2396 100644
--- a/logsift/render.py
+++ b/logsift/render.py
@@ -29,6 +29,21 @@ def rows_to_objects(headers: Sequence[str], rows: Sequence[Sequence[Any]]) -> li
     return [dict(zip(headers, row)) for row in rows]
 
 
+_BYTE_UNITS = ("KiB", "MiB", "GiB", "TiB")
+
+
+def format_bytes(count: int) -> str:
+    """Format a byte count for text output, such as ``512 B`` or ``1.5 KiB``."""
+    if count < 1024:
+        return f"{count} B"
+    value = float(count)
+    for unit in _BYTE_UNITS[:-1]:
+        value /= 1024
+        if value < 1024:
+            return f"{value:.1f} {unit}"
+    return f"{value / 1024:.1f} {_BYTE_UNITS[-1]}"
+
+
 def render_json(value: Any) -> str:
     """Render a value as indented JSON with sorted keys."""
     return json.dumps(value, indent=2, sort_keys=True, ensure_ascii=False) + "\n"
diff --git a/logsift/stats.py b/logsift/stats.py
index 8962111..66cf70e 100644
--- a/logsift/stats.py
+++ b/logsift/stats.py
@@ -7,6 +7,7 @@ from collections.abc import Iterable
 from .records import LogRecord
 
 _DIGITS_RE = re.compile(r"\d+")
+_BYTES_RE = re.compile(r"(?<!\w)bytes=(\d+)(?!\w)")
 
 
 def sort_counts(counts: Counter[str]) -> list[tuple[str, int]]:
@@ -28,3 +29,17 @@ def top_messages(records: Iterable[LogRecord], limit: int) -> list[tuple[str, in
     """Return the ``limit`` most frequent normalized messages."""
     counts = Counter(normalize_message(record.message) for record in records)
     return sort_counts(counts)[:limit]
+
+
+def bytes_by_component(records: Iterable[LogRecord]) -> dict[str, int]:
+    """Sum the ``bytes=<n>`` values in each component's messages.
+
+    Records whose message has no ``bytes=<n>`` are ignored, and components
+    without any such record do not appear in the result.
+    """
+    totals: dict[str, int] = {}
+    for record in records:
+        match = _BYTES_RE.search(record.message)
+        if match is not None:
+            totals[record.component] = totals.get(record.component, 0) + int(match[1])
+    return totals
diff --git a/tests/test_cli.py b/tests/test_cli.py
index 0b4b1b5..c939bf2 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -148,3 +148,78 @@ def test_unknown_level_is_usage_error(sample_log, capsys):
 def test_help_returns_zero(capsys):
     assert main(["--help"]) == 0
     assert "summary" in capsys.readouterr().out
+
+
+TRAFFIC = """\
+2026-03-04T10:00:00Z INFO cdn: GET /assets/app.js 200 bytes=48213
+2026-03-04T10:00:01Z INFO cdn: GET /assets/logo.png 200 bytes=1000
+2026-03-04T10:00:02Z INFO api: GET /users 200 bytes=7
+2026-03-04T10:00:03Z INFO api: GET /health 200
+2026-03-04T10:00:04Z WARNING db: slow query took 1200 ms
+"""
+
+
+def test_traffic_text_sums_bytes_by_component(tmp_path, capsys):
+    log = tmp_path / "traffic.log"
+    log.write_text(TRAFFIC, encoding="utf-8")
+    assert main(["traffic", str(log)]) == 0
+    captured = capsys.readouterr()
+    assert captured.out == (
+        "component  bytes\n"
+        "cdn        48.1 KiB\n"
+        "api        7 B\n"
+    )
+    assert captured.err == ""
+
+
+def test_traffic_json_sums_bytes_by_component(tmp_path, capsys):
+    log = tmp_path / "traffic.log"
+    log.write_text(TRAFFIC, encoding="utf-8")
+    assert main(["traffic", str(log), "--format", "json"]) == 0
+    captured = capsys.readouterr()
+    assert captured.out == (
+        "[\n"
+        "  {\n"
+        '    "bytes": 49213,\n'
+        '    "component": "cdn"\n'
+        "  },\n"
+        "  {\n"
+        '    "bytes": 7,\n'
+        '    "component": "api"\n'
+        "  }\n"
+        "]\n"
+    )
+
+
+def test_traffic_orders_ties_by_component_and_has_no_rows_without_bytes(tmp_path, capsys):
+    log = tmp_path / "traffic.log"
+    log.write_text(
+        "2026-03-04T10:00:00Z INFO web: ok bytes=5\n"
+        "2026-03-04T10:00:01Z INFO api: ok bytes=5\n"
+        "2026-03-04T10:00:02Z INFO worker: no size here\n",
+        encoding="utf-8",
+    )
+    assert main(["traffic", str(log), "--format", "json"]) == 0
+    assert json.loads(capsys.readouterr().out) == [
+        {"bytes": 5, "component": "api"},
+        {"bytes": 5, "component": "web"},
+    ]
+
+
+def test_traffic_with_no_sized_records_prints_only_header(sample_log, capsys):
+    assert main(["traffic", str(sample_log)]) == 0
+    assert capsys.readouterr().out == "component  bytes\n"
+
+
+def test_format_bytes_boundaries():
+    from logsift.render import format_bytes
+
+    assert format_bytes(0) == "0 B"
+    assert format_bytes(1023) == "1023 B"
+    assert format_bytes(1024) == "1.0 KiB"
+    assert format_bytes(1536) == "1.5 KiB"
+    assert format_bytes(1024**2 - 1) == "1024.0 KiB"
+    assert format_bytes(1024**2) == "1.0 MiB"
+    assert format_bytes(1024**3) == "1.0 GiB"
+    assert format_bytes(1024**4) == "1.0 TiB"
+    assert format_bytes(1024**5) == "1024.0 TiB"
