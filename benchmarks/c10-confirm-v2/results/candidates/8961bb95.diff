+def cmd_sources(args: argparse.Namespace, config: Config) -> int:
+    # Each file is counted on its own so that a file with no records still gets a row.
+    rows = [(path, len(read_records([path]))) for path in args.files]
+    sys.stdout.write(render_table(["file", "count"], rows, header=not args.no_header))
+    return 0
+
