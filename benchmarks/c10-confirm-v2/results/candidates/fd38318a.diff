diff --git a/tests/test_cli.py b/tests/test_cli.py
index 0b4b1b5..5f97c2e 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -114,6 +114,58 @@ def test_malformed_line_is_an_error(tmp_path, capsys):
     assert captured.err == f"logsift: error: cannot parse {path} line 2: 'broken'\n"
 
 
+def test_summary_malformed_line_is_an_error_without_skip_invalid(tmp_path, capsys):
+    path = tmp_path / "bad.log"
+    path.write_text("2026-03-04T10:00:00Z INFO web: ok\nbroken\n", encoding="utf-8")
+    assert main(["summary", str(path)]) == 1
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert captured.err == f"logsift: error: cannot parse {path} line 2: 'broken'\n"
+
+
+def test_summary_skip_invalid_counts_valid_records_and_reports_skips(tmp_path, capsys):
+    path = tmp_path / "noisy.log"
+    path.write_text(
+        "2026-03-04T10:00:00Z INFO web: ok\n"
+        "2026-03-04T10:0\n"  # truncated line
+        "\n"  # blank lines are not skipped lines
+        "2026-03-04T10:01:00Z ERROR db: lost\n",
+        encoding="utf-8",
+    )
+    assert main(["summary", str(path), "--skip-invalid", "--by", "component"]) == 3
+    captured = capsys.readouterr()
+    assert [line.split() for line in captured.out.splitlines()] == [
+        ["component", "count"],
+        ["db", "1"],
+        ["web", "1"],
+    ]
+    assert captured.err == f"logsift: warning: {path}:2: skipped unparseable line\n"
+
+
+def test_summary_skip_invalid_reports_every_skipped_line_in_order(tmp_path, capsys):
+    first = tmp_path / "a.log"
+    first.write_text("garbage\n2026-03-04T10:00:00Z INFO web: ok\n", encoding="utf-8")
+    second = tmp_path / "b.log"
+    second.write_text("2026-03-04T10:00:00Z INFO web: ok\nxx\n", encoding="utf-8")
+    assert main(["summary", str(first), str(second), "--skip-invalid", "--by", "component"]) == 3
+    captured = capsys.readouterr()
+    assert [line.split() for line in captured.out.splitlines()] == [["component", "count"], ["web", "2"]]
+    assert captured.err == (
+        f"logsift: warning: {first}:1: skipped unparseable line\n"
+        f"logsift: warning: {second}:2: skipped unparseable line\n"
+    )
+
+
+def test_summary_skip_invalid_on_clean_file_returns_zero(sample_log, capsys):
+    assert main(["summary", str(sample_log), "--skip-invalid"]) == 0
+    assert capsys.readouterr().err == ""
+
+
+def test_filter_has_no_skip_invalid_option(sample_log, capsys):
+    assert main(["filter", str(sample_log), "--skip-invalid"]) == 2
+    assert "unrecognized arguments: --skip-invalid" in capsys.readouterr().err
+
+
 def test_config_ignore_applies_to_reports(sample_log, tmp_path, capsys):
     config = tmp_path / "logsift.toml"
     config.write_text('[logsift]\nignore = ["healthcheck"]\n', encoding="utf-8")
