+def read_name_list(path: str) -> list[str]:
+    """Read component names, one per line, in file order.
+
+    Surrounding whitespace is removed. Blank lines and lines whose first
+    non-space character is ``#`` are skipped.
+    """
+    try:
+        with open(path, encoding="utf-8") as handle:
+            lines = handle.read().split("\n")
+    except UnicodeDecodeError:
+        raise LogsiftError(f"cannot read {path}: not valid UTF-8") from None
+    except OSError as exc:
+        raise LogsiftError(f"cannot read {path}: {exc.strerror}") from exc
+
+    names: list[str] = []
+    for line in lines:
+        name = line.strip()
+        if name and not name.startswith("#"):
+            names.append(name)
+    return names
+
