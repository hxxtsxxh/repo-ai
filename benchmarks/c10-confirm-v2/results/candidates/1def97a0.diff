@@ -0,0 +1,61 @@
+import pytest
+
+from logsift.config import read_name_list
+from logsift.errors import LogsiftError
+
+
+def test_read_name_list_keeps_file_order(tmp_path):
+    path = tmp_path / "names.txt"
+    path.write_text("web\ndb\nhealthcheck\n", encoding="utf-8")
+    assert read_name_list(str(path)) == ["web", "db", "healthcheck"]
+
+
+def test_read_name_list_strips_surrounding_whitespace(tmp_path):
+    path = tmp_path / "names.txt"
+    path.write_text("  web  \n\tdb\t\n   metrics\r\n", encoding="utf-8")
+    assert read_name_list(str(path)) == ["web", "db", "metrics"]
+
+
+def test_read_name_list_skips_blank_lines(tmp_path):
+    path = tmp_path / "names.txt"
+    path.write_text("\nweb\n\n   \n\t\ndb\n", encoding="utf-8")
+    assert read_name_list(str(path)) == ["web", "db"]
+
+
+def test_read_name_list_skips_comment_lines(tmp_path):
+    path = tmp_path / "names.txt"
+    path.write_text("# ignored components\nweb\n   # indented comment\ndb\n", encoding="utf-8")
+    assert read_name_list(str(path)) == ["web", "db"]
+
+
+def test_read_name_list_keeps_hash_inside_a_name(tmp_path):
+    path = tmp_path / "names.txt"
+    path.write_text("web#1\n  db # trailing text\n", encoding="utf-8")
+    assert read_name_list(str(path)) == ["web#1", "db # trailing text"]
+
+
+def test_read_name_list_empty_file(tmp_path):
+    path = tmp_path / "names.txt"
+    path.write_bytes(b"")
+    assert read_name_list(str(path)) == []
+
+
+def test_read_name_list_reads_utf8(tmp_path):
+    path = tmp_path / "names.txt"
+    path.write_text("café\nservice-ü\n", encoding="utf-8")
+    assert read_name_list(str(path)) == ["café", "service-ü"]
+
+
+def test_read_name_list_missing_file(tmp_path):
+    missing = tmp_path / "missing.txt"
+    with pytest.raises(LogsiftError) as info:
+        read_name_list(str(missing))
+    assert str(info.value) == f"cannot read {missing}: No such file or directory"
+
+
+def test_read_name_list_rejects_invalid_utf8(tmp_path):
+    path = tmp_path / "bad.txt"
+    path.write_bytes(b"web\n\xff\n")
+    with pytest.raises(LogsiftError) as info:
+        read_name_list(str(path))
+    assert str(info.value) == f"cannot read {path}: not valid UTF-8"
