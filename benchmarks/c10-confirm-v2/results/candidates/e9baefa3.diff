+def read_name_list(path: str) -> list[str]:
+    """Return component names from a UTF-8 file, one per line, in file order.
+
+    Surrounding whitespace is removed. Blank lines and lines whose first
+    non-space character is ``#`` are skipped.
+    """
+    with open(path, encoding="utf-8") as handle:
+        names = []
+        for line in handle:
+            name = line.strip()
+            if name and not name.startswith("#"):
+                names.append(name)
+    return names
+
