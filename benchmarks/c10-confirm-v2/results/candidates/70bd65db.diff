@@ -8,14 +8,26 @@ from .errors import LogsiftError, OutputExistsError
 from .records import LogRecord
 
 
+def check_writable(path: str, *, force: bool = False) -> None:
+    """Raise if ``write_text`` would fail for ``path``, without touching the file system."""
+    target = Path(path)
+    if target.exists() and not force:
+        raise OutputExistsError(path)
+    if target.is_dir():
+        raise LogsiftError(f"cannot write {path}: Is a directory")
+    if not target.parent.exists():
+        raise LogsiftError(f"cannot write {path}: No such file or directory")
+    if not target.parent.is_dir():
+        raise LogsiftError(f"cannot write {path}: Not a directory")
+
+
 def write_text(path: str, text: str, *, force: bool = False) -> None:
     """Write text to a file as UTF-8 with ``\\n`` line endings.
 
