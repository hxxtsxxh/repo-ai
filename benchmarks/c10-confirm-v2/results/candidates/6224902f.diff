+from logsift.config import Config, load_config, read_name_list
+from logsift.errors import ConfigError, LogsiftError, OutputExistsError
 from logsift.output import write_text
 from logsift.render import render_json, render_table, rows_to_objects
 
@@ -62,3 +62,51 @@ def test_load_config_errors(tmp_path, content, message):
     path.write_text(content, encoding="utf-8")
     with pytest.raises(ConfigError, match=message):
         load_config(str(path))
+
+
+def test_read_name_list_keeps_file_order(tmp_path):
+    path = tmp_path / "names.txt"
+    path.write_text("web\nworker\ncache\n", encoding="utf-8")
+    assert read_name_list(str(path)) == ["web", "worker", "cache"]
+
+
+def test_read_name_list_strips_whitespace_and_skips_blanks_and_comments(tmp_path):
+    path = tmp_path / "names.txt"
+    path.write_text(
+        "# components to ignore\n"
+        "\n"
+        "   \n"
+        "  web  \n"
+        "\t# indented comment\n"
+        "worker # not a comment\n"
+        "\r\n"
+        "cache\r\n",
+        encoding="utf-8",
+    )
+    assert read_name_list(str(path)) == ["web", "worker # not a comment", "cache"]
+
+
+def test_read_name_list_empty_file(tmp_path):
+    path = tmp_path / "names.txt"
+    path.write_bytes(b"")
+    assert read_name_list(str(path)) == []
+
+
+def test_read_name_list_reads_utf8(tmp_path):
+    path = tmp_path / "names.txt"
+    path.write_bytes("café\n".encode("utf-8"))
+    assert read_name_list(str(path)) == ["café"]
+
+
+def test_read_name_list_missing_file(tmp_path):
+    path = tmp_path / "missing.txt"
+    with pytest.raises(LogsiftError) as info:
+        read_name_list(str(path))
+    assert str(info.value) == f"cannot read {path}: No such file or directory"
+
+
+def test_read_name_list_rejects_invalid_utf8(tmp_path):
+    path = tmp_path / "names.txt"
+    path.write_bytes(b"web\n\xff\xfe\n")
+    with pytest.raises(LogsiftError, match="not valid UTF-8"):
+        read_name_list(str(path))
