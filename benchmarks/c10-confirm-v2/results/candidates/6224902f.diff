 _KNOWN_KEYS = {"ignore"}
 
@@ -40,3 +40,26 @@ def load_config(path: str) -> Config:
     if not isinstance(ignore, list) or not all(isinstance(item, str) for item in ignore):
         raise ConfigError(f"{path}: 'ignore' must be a list of strings")
     return Config(ignore=tuple(ignore))
+
+
+def read_name_list(path: str) -> list[str]:
+    """Read component names, one per line, from a UTF-8 text file.
+
+    Surrounding whitespace is removed, blank lines and lines whose first
+    non-space character is ``#`` are skipped, and the names are returned in
+    file order.
+    """
+    try:
+        with open(path, encoding="utf-8") as handle:
+            text = handle.read()
+    except OSError as exc:
+        raise LogsiftError(f"cannot read {path}: {exc.strerror}") from exc
+    except UnicodeDecodeError as exc:
+        raise LogsiftError(f"{path}: not valid UTF-8") from exc
+
+    names = []
+    for line in text.splitlines():
+        name = line.strip()
+        if name and not name.startswith("#"):
+            names.append(name)
+    return names
