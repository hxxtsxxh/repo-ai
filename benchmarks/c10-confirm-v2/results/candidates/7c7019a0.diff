+    out.write_text("keep\n", encoding="utf-8")
+    assert main(["filter", str(sample_log), "--grep", "slow", "-o", str(out), "--dry-run", "--force"]) == 0
+    assert capsys.readouterr().out == f"would write {out}\n"
