diff --git a/logsift/output.py b/logsift/output.py
index 3671aac..647199b 100644
--- a/logsift/output.py
+++ b/logsift/output.py
@@ -8,14 +8,26 @@ from .errors import LogsiftError, OutputExistsError
 from .records import LogRecord
 
 
+def check_writable(path: str, *, force: bool = False) -> None:
+    """Raise if ``path`` could not be written, without writing anything.
+
+    An existing file is only replaced when ``force`` is true. The directory that
+    will hold the file must exist; file permissions are not checked.
+    """
+    target = Path(path)
+    if target.exists() and not force:
+        raise OutputExistsError(path)
+    if not target.parent.is_dir():
+        raise LogsiftError(f"cannot write {path}: No such file or directory")
+
+
 def write_text(path: str, text: str, *, force: bool = False) -> None:
     """Write text to a file as UTF-8 with ``\\n`` line endings.
 
     An existing file is only replaced when ``force`` is true.
     """
+    check_writable(path, force=force)
     target = Path(path)
-    if target.exists() and not force:
-        raise OutputExistsError(path)
     if text and not text.endswith("\n"):
         text += "\n"
     try:
