+def resolve_config(path: str | None, environ: Mapping[str, str]) -> Config:
+    """Return the effective settings from the config file and environment variables.
+
+    Environment variables take precedence over the file at ``path`` (when not None).
+    ``LOGSIFT_IGNORE`` is a comma-separated list; an unset or empty variable is ignored.
+    """
+    config = load_config(path) if path is not None else Config()
+    raw = environ.get(_ENV_PREFIX + "IGNORE", "")
+    if raw != "":
+        items = [item.strip() for item in raw.split(",")]
+        config = Config(ignore=tuple(item for item in items if item))
+    return config
+
