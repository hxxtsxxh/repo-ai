+TRAFFIC_LOG = """\
+2026-03-04T10:00:00Z INFO cdn: GET /assets/app.js 200 bytes=48213
+2026-03-04T10:00:01Z INFO api: GET /v1/items 200 bytes=1500
+2026-03-04T10:00:02Z INFO cdn: cache miss
+2026-03-04T10:00:03Z INFO cdn: GET /assets/logo.png 200 bytes=1024
+2026-03-04T10:00:04Z INFO api: GET /v1/items 500 bytes=12
+2026-03-04T10:00:05Z INFO healthcheck: ok
+"""
+
+
+def test_traffic_text(tmp_path, capsys):
+    log = tmp_path / "traffic.log"
+    log.write_text(TRAFFIC_LOG, encoding="utf-8")
+    assert main(["traffic", str(log)]) == 0
+    captured = capsys.readouterr()
+    assert captured.out == (
+        "component  bytes\n"
+        "cdn        48.1 KiB\n"
+        "api        1.5 KiB\n"
+    )
+    assert captured.err == ""
+
+
+def test_traffic_json(tmp_path, capsys):
+    log = tmp_path / "traffic.log"
+    log.write_text(TRAFFIC_LOG, encoding="utf-8")
+    assert main(["traffic", str(log), "--format", "json"]) == 0
+    assert json.loads(capsys.readouterr().out) == [
+        {"component": "cdn", "bytes": 49237},
+        {"component": "api", "bytes": 1512},
+    ]
+
+
+def test_traffic_sums_several_files_and_respects_ignore(tmp_path, capsys):
+    first = tmp_path / "a.log"
+    second = tmp_path / "b.log"
+    first.write_text("2026-03-04T10:00:00Z INFO cdn: GET /a 200 bytes=100\n", encoding="utf-8")
+    second.write_text(
+        "2026-03-04T10:00:00Z INFO cdn: GET /b 200 bytes=900\n"
+        "2026-03-04T10:00:00Z INFO api: GET /c 200 bytes=5\n",
+        encoding="utf-8",
+    )
+    config = tmp_path / "logsift.toml"
+    config.write_text('[logsift]\nignore = ["api"]\n', encoding="utf-8")
+    assert main(["--config", str(config), "traffic", str(first), str(second), "--format", "json"]) == 0
+    assert json.loads(capsys.readouterr().out) == [{"component": "cdn", "bytes": 1000}]
+
+
+def test_traffic_empty_when_no_bytes(sample_log, capsys):
+    assert main(["traffic", str(sample_log)]) == 0
+    assert capsys.readouterr().out == "component  bytes\n"
+
+
