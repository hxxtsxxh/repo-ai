index 68a77f3..1535453 100644
--- a/logsift/render.py
+++ b/logsift/render.py
@@ -24,6 +24,21 @@ def render_table(headers: Sequence[str], rows: Sequence[Sequence[Any]]) -> str:
     return "\n".join(lines) + "\n"
 
 
+_UNITS = ("KiB", "MiB", "GiB", "TiB")
+
+
+def format_bytes(count: int) -> str:
+    """Format a byte count for text output, such as ``512 B`` or ``1.5 KiB``."""
+    if count < 1024:
+        return f"{count} B"
+    value = float(count)
+    for unit in _UNITS[:-1]:
+        value /= 1024
+        if value < 1024:
+            return f"{value:.1f} {unit}"
+    return f"{value / 1024:.1f} {_UNITS[-1]}"
+
+
 def rows_to_objects(headers: Sequence[str], rows: Sequence[Sequence[Any]]) -> list[dict[str, Any]]:
     """Turn rows into a list of objects keyed by the column headers."""
     return [dict(zip(headers, row)) for row in rows]
diff --git a/logsift/stats.py b/logsift/stats.py
index 8962111..4f7f6c2 100644
--- a/logsift/stats.py
+++ b/logsift/stats.py
@@ -7,6 +7,7 @@ from collections.abc import Iterable
 from .records import LogRecord
 
 _DIGITS_RE = re.compile(r"\d+")
+_BYTES_RE = re.compile(r"\bbytes=([0-9]+)")
 
 
 def sort_counts(counts: Counter[str]) -> list[tuple[str, int]]:
@@ -28,3 +29,17 @@ def top_messages(records: Iterable[LogRecord], limit: int) -> list[tuple[str, in
     """Return the ``limit`` most frequent normalized messages."""
     counts = Counter(normalize_message(record.message) for record in records)
     return sort_counts(counts)[:limit]
+
+
+def bytes_by_component(records: Iterable[LogRecord]) -> dict[str, int]:
+    """Sum the ``bytes=<n>`` values in each component's messages.
+
+    Records whose message has no ``bytes=<n>`` are ignored, and components
+    without any such record do not appear in the result.
+    """
+    totals: Counter[str] = Counter()
+    for record in records:
+        match = _BYTES_RE.search(record.message)
+        if match is not None:
+            totals[record.component] += int(match[1])
+    return dict(totals)
