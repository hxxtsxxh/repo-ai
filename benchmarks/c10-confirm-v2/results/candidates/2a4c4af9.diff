@@ -110,6 +121,12 @@ def build_parser() -> argparse.ArgumentParser:
     export.add_argument("--force", action="store_true", help="replace PATH if it exists")
     export.set_defaults(handler=cmd_export)
 
+    sources = commands.add_parser("sources", help="count the records in each file")
+    sources.add_argument("files", nargs="+", metavar="FILE", help="log files to read")
+    sources.add_argument("--format", choices=["text", "json"], default="text", help="output format")
+    sources.add_argument("--no-header", action="store_true", help="leave out the header line of the table")
+    sources.set_defaults(handler=cmd_sources)
+
     return parser
 
 
