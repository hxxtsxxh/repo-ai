diff --git a/tests/test_cli.py b/tests/test_cli.py
index 0b4b1b5..d4b8b8b 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -97,6 +97,98 @@ def test_export_force_replaces_output(sample_log, tmp_path, capsys):
     assert capsys.readouterr().err == f"logsift: wrote 8 records to {out}\n"
 
 
+def test_sources_text_counts_each_file(sample_log, tmp_path, capsys):
+    other = tmp_path / "other.log"
+    other.write_text("2026-03-05T08:00:00Z CRITICAL db: disk full\n", encoding="utf-8")
+    assert main(["sources", str(other), str(sample_log)]) == 0
+    captured = capsys.readouterr()
+    assert captured.err == ""
+    lines = captured.out.splitlines()
+    assert len(lines) == 3
+    assert lines[0].split() == ["file", "count"]
+    # Highest count first, so the 8-record file comes before the 1-record file.
+    assert lines[1].split() == [str(sample_log), "8"]
+    assert lines[2].split() == [str(other), "1"]
+
+
+def test_sources_ties_are_ordered_by_file(tmp_path, capsys):
+    first = tmp_path / "a.log"
+    second = tmp_path / "b.log"
+    line = "2026-03-05T08:00:00Z INFO db: ok\n"
+    first.write_text(line * 2, encoding="utf-8")
+    second.write_text(line * 2, encoding="utf-8")
+    assert main(["sources", str(second), str(first), "--no-header"]) == 0
+    assert [row.split() for row in capsys.readouterr().out.splitlines()] == [
+        [str(first), "2"],
+        [str(second), "2"],
+    ]
+
+
+def test_sources_no_header_leaves_out_header_line(sample_log, tmp_path, capsys):
+    other = tmp_path / "other.log"
+    other.write_text("2026-03-05T08:00:00Z CRITICAL db: disk full\n", encoding="utf-8")
+    assert main(["sources", str(sample_log), str(other), "--no-header"]) == 0
+    lines = capsys.readouterr().out.splitlines()
+    assert [row.split() for row in lines] == [[str(sample_log), "8"], [str(other), "1"]]
+
+
+def test_sources_no_header_output_is_plain_rows(sample_log, capsys):
+    assert main(["sources", str(sample_log), "--no-header"]) == 0
+    # The count column is as wide as its header, so the 8 is right-aligned in five characters.
+    assert capsys.readouterr().out == f"{sample_log}  " + "    8\n"
+
+
+def test_sources_json(sample_log, tmp_path, capsys):
+    other = tmp_path / "other.log"
+    other.write_text("2026-03-05T08:00:00Z CRITICAL db: disk full\n", encoding="utf-8")
+    assert main(["sources", str(sample_log), str(other), "--format", "json"]) == 0
+    assert json.loads(capsys.readouterr().out) == [
+        {"count": 8, "file": str(sample_log)},
+        {"count": 1, "file": str(other)},
+    ]
+
+
+def test_sources_json_ignores_no_header(sample_log, capsys):
+    assert main(["sources", str(sample_log), "--format", "json"]) == 0
+    with_flag = capsys.readouterr().out
+    assert main(["sources", str(sample_log), "--format", "json", "--no-header"]) == 0
+    assert capsys.readouterr().out == with_flag
+
+
+def test_sources_counts_empty_file_as_zero(tmp_path, capsys):
+    empty = tmp_path / "empty.log"
+    empty.write_text("", encoding="utf-8")
+    assert main(["sources", str(empty), "--format", "json"]) == 0
+    assert json.loads(capsys.readouterr().out) == [{"count": 0, "file": str(empty)}]
+
+
+def test_sources_repeated_file_gets_one_row(sample_log, capsys):
+    assert main(["sources", str(sample_log), str(sample_log), "--no-header"]) == 0
+    assert [row.split() for row in capsys.readouterr().out.splitlines()] == [[str(sample_log), "8"]]
+
+
+def test_sources_missing_file_is_an_error(sample_log, tmp_path, capsys):
+    missing = tmp_path / "nope.log"
+    assert main(["sources", str(sample_log), str(missing)]) == 1
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert captured.err == f"logsift: error: cannot read {missing}: No such file or directory\n"
+
+
+def test_sources_malformed_line_is_an_error(tmp_path, capsys):
+    path = tmp_path / "bad.log"
+    path.write_text("2026-03-04T10:00:00Z INFO web: ok\nbroken\n", encoding="utf-8")
+    assert main(["sources", str(path)]) == 1
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert captured.err == f"logsift: error: cannot parse {path} line 2: 'broken'\n"
+
+
+def test_sources_requires_a_file(capsys):
+    assert main(["sources"]) == 2
+    assert "FILE" in capsys.readouterr().err
+
+
 def test_missing_input_is_an_error(tmp_path, capsys):
     missing = tmp_path / "nope.log"
     assert main(["summary", str(missing)]) == 1
