-from .stats import count_by, top_messages
+from .stats import count_by, sort_counts, top_messages
 
 PROG = "logsift"
 
@@ -76,6 +77,16 @@ def cmd_export(args: argparse.Namespace, config: Config) -> int:
     return 0
 
 
+def cmd_sources(args: argparse.Namespace, config: Config) -> int:
+    counts = Counter({path: len(read_records([path])) for path in args.files})
+    rows = sort_counts(counts)
+    if args.format == "json":
+        sys.stdout.write(render_json(rows_to_objects(["file", "count"], rows)))
+    else:
+        sys.stdout.write(render_table(["file", "count"], rows, header=not args.no_header))
+    return 0
+
+
 def build_parser() -> argparse.ArgumentParser:
     parser = argparse.ArgumentParser(prog=PROG, description="Summarize, filter and export application log files.")
