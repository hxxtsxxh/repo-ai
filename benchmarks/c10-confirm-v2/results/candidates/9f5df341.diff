diff --git a/logsift/config.py b/logsift/config.py
index 37d1c50..0411a79 100644
--- a/logsift/config.py
+++ b/logsift/config.py
@@ -7,6 +7,7 @@ Example::
 """
 
 import tomllib
+from collections.abc import Mapping
 from dataclasses import dataclass
 
 from .errors import ConfigError
@@ -40,3 +41,24 @@ def load_config(path: str) -> Config:
     if not isinstance(ignore, list) or not all(isinstance(item, str) for item in ignore):
         raise ConfigError(f"{path}: 'ignore' must be a list of strings")
     return Config(ignore=tuple(ignore))
+
+
+def _ignore_from_environ(environ: Mapping[str, str]) -> tuple[str, ...] | None:
+    """Return ``LOGSIFT_IGNORE`` as a list, or None when it is unset or empty."""
+    raw = environ.get("LOGSIFT_IGNORE", "")
+    if raw == "":
+        return None
+    return tuple(item for item in (part.strip() for part in raw.split(",")) if item)
+
+
+def resolve_config(path: str | None, environ: Mapping[str, str]) -> Config:
+    """Return the effective settings: environment variables over the config file over defaults.
+
+    The file at ``path`` is read only when ``path`` is not None. A setting given in
+    ``environ`` replaces the value from the file rather than merging with it.
+    """
+    config = load_config(path) if path is not None else Config()
+    ignore = _ignore_from_environ(environ)
+    if ignore is None:
+        return config
+    return Config(ignore=ignore)
