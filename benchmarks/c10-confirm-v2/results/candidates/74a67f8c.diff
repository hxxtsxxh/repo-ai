diff --git a/tests/test_cli.py b/tests/test_cli.py
index 0b4b1b5..9b7b775 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -114,6 +114,67 @@ def test_malformed_line_is_an_error(tmp_path, capsys):
     assert captured.err == f"logsift: error: cannot parse {path} line 2: 'broken'\n"
 
 
+def test_summary_fails_on_malformed_line_without_skip_invalid(tmp_path, capsys):
+    path = tmp_path / "bad.log"
+    path.write_text("2026-03-04T10:00:00Z INFO web: ok\nbroken\n", encoding="utf-8")
+    assert main(["summary", str(path)]) == 1
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert captured.err == f"logsift: error: cannot parse {path} line 2: 'broken'\n"
+
+
+def test_summary_skip_invalid_counts_valid_records_and_warns(tmp_path, capsys):
+    path = tmp_path / "app.log"
+    path.write_text(
+        "2026-03-04T10:00:00Z INFO web: ok\n"
+        "\n"
+        "2026-03-04T10:0\n"
+        "2026-03-04T10:01:00Z ERROR db: lost\n"
+        "garbage line\n"
+        "2026-03-04T10:02:00Z INFO web: ok again\n",
+        encoding="utf-8",
+    )
+    assert main(["summary", str(path), "--skip-invalid"]) == 3
+    captured = capsys.readouterr()
+    assert captured.out == (
+        "level     count\n"
+        "INFO          2\n"
+        "ERROR         1\n"
+    )
+    assert captured.err == (
+        f"logsift: warning: {path}:3: skipped unparseable line\n"
+        f"logsift: warning: {path}:5: skipped unparseable line\n"
+    )
+
+
+def test_summary_skip_invalid_json_and_several_files(sample_log, tmp_path, capsys):
+    other = tmp_path / "other.log"
+    other.write_text("nonsense\n2026-03-05T08:00:00Z CRITICAL db: disk full\n", encoding="utf-8")
+    code = main(
+        ["summary", str(sample_log), str(other), "--by", "component", "--format", "json", "--skip-invalid"]
+    )
+    captured = capsys.readouterr()
+    assert code == 3
+    assert json.loads(captured.out) == [
+        {"component": "db", "count": 5},
+        {"component": "web", "count": 3},
+        {"component": "healthcheck", "count": 1},
+    ]
+    assert captured.err == f"logsift: warning: {other}:1: skipped unparseable line\n"
+
+
+def test_summary_skip_invalid_without_bad_lines_returns_zero(sample_log, capsys):
+    assert main(["summary", str(sample_log), "--skip-invalid"]) == 0
+    captured = capsys.readouterr()
+    assert captured.err == ""
+    assert captured.out.splitlines()[0] == "level     count"
+
+
+def test_skip_invalid_is_only_on_summary(sample_log, capsys):
+    assert main(["filter", str(sample_log), "--skip-invalid"]) == 2
+    assert "unrecognized arguments: --skip-invalid" in capsys.readouterr().err
+
+
