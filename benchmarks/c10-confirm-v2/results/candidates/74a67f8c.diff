+def test_read_records_skip_invalid_collects_skipped_lines(tmp_path):
+    path = tmp_path / "mixed.log"
+    path.write_text(
+        "2026-03-04T10:00:00Z INFO web: ok\nbroken\n\n2026-03-04T10:01:00Z ERROR db: lost\n",
+        encoding="utf-8",
+    )
+    skipped: list[ParseError] = []
+    records = read_records([str(path)], skip_invalid=True, skipped=skipped)
+    assert [record.lineno for record in records] == [1, 4]
+    assert [(exc.path, exc.lineno, exc.line) for exc in skipped] == [(str(path), 2, "broken")]
+
+
+def test_read_records_skip_invalid_without_collector(tmp_path):
+    path = tmp_path / "mixed.log"
+    path.write_text("broken\n2026-03-04T10:01:00Z ERROR db: lost\n", encoding="utf-8")
+    assert len(read_records([str(path)], skip_invalid=True)) == 1
+
