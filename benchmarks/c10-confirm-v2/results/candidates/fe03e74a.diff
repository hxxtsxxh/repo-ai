index 0b4b1b5..4bd9fa6 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -36,6 +36,41 @@ def test_summary_of_several_files(sample_log, tmp_path, capsys):
     ]
 
 
+def test_sources_counts_each_file_in_order(sample_log, tmp_path, capsys):
+    other = tmp_path / "other.log"
+    other.write_text("2026-03-05T08:00:00Z CRITICAL db: disk full\n", encoding="utf-8")
+    empty = tmp_path / "empty.log"
+    empty.write_text("\n", encoding="utf-8")
+    assert main(["sources", str(sample_log), str(other), str(empty)]) == 0
+    captured = capsys.readouterr()
+    assert captured.err == ""
+    lines = captured.out.splitlines()
+    assert lines[0].split() == ["file", "count"]
+    rows = [line.rsplit(None, 1) for line in lines[1:]]
+    assert [(path, int(count)) for path, count in rows] == [
+        (str(sample_log), 8),
+        (str(other), 1),
+        (str(empty), 0),
+    ]
+
+
+def test_sources_no_header_drops_only_the_header_line(sample_log, capsys):
+    assert main(["sources", str(sample_log)]) == 0
+    with_header = capsys.readouterr().out
+    assert main(["sources", str(sample_log), "--no-header"]) == 0
+    without_header = capsys.readouterr().out
+    assert without_header == "".join(with_header.splitlines(keepends=True)[1:])
+    assert without_header.splitlines()[0].rsplit(None, 1) == [str(sample_log), "8"]
+
+
+def test_sources_missing_file_is_an_error(tmp_path, capsys):
+    missing = tmp_path / "nope.log"
+    assert main(["sources", str(missing)]) == 1
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert captured.err == f"logsift: error: cannot read {missing}: No such file or directory\n"
+
+
