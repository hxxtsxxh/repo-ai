+def cmd_sources(args: argparse.Namespace, config: Config) -> int:
+    # Every file named on the command line gets a row, including files with no records.
+    # Filters and the config ignore list do not apply: this counts what each file contains.
+    records = read_records(args.files)
+    counts = Counter(record.source for record in records)
+    rows = [(path, counts.get(path, 0)) for path in dict.fromkeys(args.files)]
+    rows.sort(key=lambda row: (-row[1], row[0]))
+    _emit_report(args, ["file", "count"], rows, header=not args.no_header)
+    return 0
+
