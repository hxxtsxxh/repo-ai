diff --git a/tests/test_cli.py b/tests/test_cli.py
index 0b4b1b5..e33a35d 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -97,6 +97,79 @@ def test_export_force_replaces_output(sample_log, tmp_path, capsys):
     assert capsys.readouterr().err == f"logsift: wrote 8 records to {out}\n"
 
 
+def test_sources_counts_each_file(sample_log, tmp_path, capsys):
+    other = tmp_path / "other.log"
+    other.write_text("2026-03-05T08:00:00Z CRITICAL db: disk full\n", encoding="utf-8")
+    assert main(["sources", str(other), str(sample_log)]) == 0
+    captured = capsys.readouterr()
+    assert captured.err == ""
+    lines = captured.out.splitlines()
+    assert lines[0].split() == ["file", "count"]
+    # Highest count first, so the 8-record file comes before the 1-record file.
+    assert [line.split() for line in lines[1:]] == [[str(sample_log), "8"], [str(other), "1"]]
+
+
+def test_sources_no_header_leaves_out_header_line(sample_log, tmp_path, capsys):
+    other = tmp_path / "other.log"
+    other.write_text("2026-03-05T08:00:00Z CRITICAL db: disk full\n", encoding="utf-8")
+    assert main(["sources", "--no-header", str(sample_log), str(other)]) == 0
+    captured = capsys.readouterr()
+    assert captured.err == ""
+    assert [line.split() for line in captured.out.splitlines()] == [
+        [str(sample_log), "8"],
+        [str(other), "1"],
+    ]
+
+
+def test_sources_counts_empty_file_as_zero_and_ignores_blank_lines(tmp_path, capsys):
+    blank = tmp_path / "blank.log"
+    blank.write_text("\n   \n\n", encoding="utf-8")
+    empty = tmp_path / "empty.log"
+    empty.write_text("", encoding="utf-8")
+    assert main(["sources", "--no-header", str(empty), str(blank)]) == 0
+    assert [line.split() for line in capsys.readouterr().out.splitlines()] == [
+        [str(blank), "0"],
+        [str(empty), "0"],
+    ]
+
+
+def test_sources_ties_are_ordered_by_path(sample_log, tmp_path, capsys):
+    first = tmp_path / "a.log"
+    second = tmp_path / "b.log"
+    line = "2026-03-05T08:00:00Z CRITICAL db: disk full\n"
+    first.write_text(line, encoding="utf-8")
+    second.write_text(line, encoding="utf-8")
+    assert main(["sources", "--no-header", str(second), str(first)]) == 0
+    assert [row.split()[0] for row in capsys.readouterr().out.splitlines()] == [str(first), str(second)]
+
+
+def test_sources_json(sample_log, tmp_path, capsys):
+    other = tmp_path / "other.log"
+    other.write_text("2026-03-05T08:00:00Z CRITICAL db: disk full\n", encoding="utf-8")
+    assert main(["sources", str(other), str(sample_log), "--format", "json"]) == 0
+    assert json.loads(capsys.readouterr().out) == [
+        {"file": str(sample_log), "count": 8},
+        {"file": str(other), "count": 1},
+    ]
+
+
+def test_sources_malformed_line_is_an_error(tmp_path, capsys):
+    path = tmp_path / "bad.log"
+    path.write_text("broken\n", encoding="utf-8")
+    assert main(["sources", str(path)]) == 1
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert captured.err == f"logsift: error: cannot parse {path} line 1: 'broken'\n"
+
+
+def test_sources_missing_input_is_an_error(tmp_path, capsys):
+    missing = tmp_path / "nope.log"
+    assert main(["sources", str(missing)]) == 1
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert captured.err == f"logsift: error: cannot read {missing}: No such file or directory\n"
+
+
 def test_missing_input_is_an_error(tmp_path, capsys):
     missing = tmp_path / "nope.log"
     assert main(["summary", str(missing)]) == 1
