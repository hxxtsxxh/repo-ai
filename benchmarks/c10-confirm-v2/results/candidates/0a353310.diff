+def resolve_config(path: str | None, environ: Mapping[str, str]) -> Config:
+    """Return the effective settings: environment variables override the config file.
+
+    The file at ``path`` is read when it is not None. A ``LOGSIFT_<KEY>`` variable that is
+    set and non-empty replaces the file's value for that key; list values are comma-separated.
+    """
+    config = load_config(path) if path is not None else Config()
+    ignore = environ.get(_ENV_PREFIX + "IGNORE", "")
+    if ignore:
+        config = replace(config, ignore=_split_list(ignore))
+    return config
+
+
+def _split_list(value: str) -> tuple[str, ...]:
+    return tuple(item for item in (part.strip() for part in value.split(",")) if item)
+
