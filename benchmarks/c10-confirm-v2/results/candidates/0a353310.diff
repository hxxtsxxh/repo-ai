+++ b/tests/test_resolve_config.py
@@ -0,0 +1,74 @@
+import pytest
+
+from logsift.cli import main
+from logsift.config import Config, resolve_config
+from logsift.errors import ConfigError
+
+
+def test_no_path_and_no_environment_gives_defaults():
+    assert resolve_config(None, {}) == Config()
+
+
+def test_path_only_reads_the_file(tmp_path):
+    path = tmp_path / "logsift.toml"
+    path.write_text('[logsift]\nignore = ["healthcheck", "metrics"]\n', encoding="utf-8")
+    assert resolve_config(str(path), {}) == Config(ignore=("healthcheck", "metrics"))
+
+
+def test_environment_only_reads_ignore():
+    assert resolve_config(None, {"LOGSIFT_IGNORE": "healthcheck,metrics"}) == Config(
+        ignore=("healthcheck", "metrics")
+    )
+
+
+def test_environment_list_is_stripped_and_empty_items_dropped():
+    environ = {"LOGSIFT_IGNORE": " healthcheck , ,metrics,, "}
+    assert resolve_config(None, environ) == Config(ignore=("healthcheck", "metrics"))
+
+
+def test_environment_overrides_file(tmp_path):
+    path = tmp_path / "logsift.toml"
+    path.write_text('[logsift]\nignore = ["healthcheck"]\n', encoding="utf-8")
+    assert resolve_config(str(path), {"LOGSIFT_IGNORE": "metrics"}) == Config(ignore=("metrics",))
+
+
+def test_empty_environment_value_counts_as_unset(tmp_path):
+    path = tmp_path / "logsift.toml"
+    path.write_text('[logsift]\nignore = ["healthcheck"]\n', encoding="utf-8")
+    assert resolve_config(str(path), {"LOGSIFT_IGNORE": ""}) == Config(ignore=("healthcheck",))
+    assert resolve_config(None, {"LOGSIFT_IGNORE": ""}) == Config()
+
+
+def test_unrelated_environment_variables_are_ignored(tmp_path):
+    path = tmp_path / "logsift.toml"
+    path.write_text('[logsift]\nignore = ["healthcheck"]\n', encoding="utf-8")
+    environ = {"LOGSIFT_OTHER": "x", "PATH": "/bin", "IGNORE": "metrics"}
+    assert resolve_config(str(path), environ) == Config(ignore=("healthcheck",))
+
+
+def test_file_is_still_validated_when_environment_overrides_it(tmp_path):
+    path = tmp_path / "logsift.toml"
+    path.write_text("[logsift]\nignored = []\n", encoding="utf-8")
+    with pytest.raises(ConfigError, match="unknown setting 'ignored'"):
+        resolve_config(str(path), {"LOGSIFT_IGNORE": "metrics"})
+
+
+def test_missing_file_is_an_error(tmp_path):
+    path = tmp_path / "missing.toml"
+    with pytest.raises(ConfigError, match=r"cannot read .*missing\.toml"):
+        resolve_config(str(path), {})
+
+
+def test_main_uses_environment_ignore(sample_log, monkeypatch, capsys):
+    monkeypatch.setenv("LOGSIFT_IGNORE", "healthcheck")
+    assert main(["summary", str(sample_log), "--by", "component"]) == 0
+    assert "healthcheck" not in capsys.readouterr().out
+
+
+def test_main_reports_bad_file_with_environment_set(tmp_path, monkeypatch, capsys):
+    monkeypatch.setenv("LOGSIFT_IGNORE", "healthcheck")
+    missing = tmp_path / "missing.toml"
+    assert main(["--config", str(missing), "summary", "x.log"]) == 1
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert captured.err.startswith(f"logsift: error: cannot read {missing}: ")
