diff --git a/tests/test_cli.py b/tests/test_cli.py
index 0b4b1b5..cff4217 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -145,6 +145,63 @@ def test_unknown_level_is_usage_error(sample_log, capsys):
     assert "unknown level 'loud'" in capsys.readouterr().err
 
 
+def test_sources_text_counts_each_file(sample_log, tmp_path, capsys):
+    other = tmp_path / "other.log"
+    other.write_text("2026-03-05T08:00:00Z CRITICAL db: disk full\n", encoding="utf-8")
+    assert main(["sources", str(sample_log), str(other)]) == 0
+    captured = capsys.readouterr()
+    lines = captured.out.splitlines()
+    assert captured.err == ""
+    assert lines[0].split() == ["file", "count"]
+    # highest count first
+    assert lines[1].rsplit(None, 1) == [str(sample_log), "8"]
+    assert lines[2].rsplit(None, 1) == [str(other), "1"]
+    assert len(lines) == 3
+
+
+def test_sources_no_header(sample_log, tmp_path, capsys):
+    other = tmp_path / "other.log"
+    other.write_text("2026-03-05T08:00:00Z CRITICAL db: disk full\n", encoding="utf-8")
+    assert main(["sources", str(sample_log), str(other), "--no-header"]) == 0
+    lines = capsys.readouterr().out.splitlines()
+    assert len(lines) == 2
+    assert lines[0].rsplit(None, 1) == [str(sample_log), "8"]
+    assert lines[1].rsplit(None, 1) == [str(other), "1"]
+
+
+def test_sources_ties_are_ordered_by_path(tmp_path, capsys):
+    a = tmp_path / "a.log"
+    b = tmp_path / "b.log"
+    line = "2026-03-05T08:00:00Z INFO db: ok\n"
+    b.write_text(line, encoding="utf-8")
+    a.write_text(line, encoding="utf-8")
+    assert main(["sources", str(b), str(a), "--format", "json"]) == 0
+    assert json.loads(capsys.readouterr().out) == [
+        {"count": 1, "file": str(a)},
+        {"count": 1, "file": str(b)},
+    ]
+
+
+def test_sources_empty_file_counts_zero(tmp_path, capsys):
+    empty = tmp_path / "empty.log"
+    empty.write_text("", encoding="utf-8")
+    assert main(["sources", str(empty), "--no-header"]) == 0
+    assert capsys.readouterr().out.rsplit(None, 1) == [str(empty), "0"]
+
+
+def test_sources_json(sample_log, capsys):
+    assert main(["sources", str(sample_log), "--format", "json"]) == 0
+    assert json.loads(capsys.readouterr().out) == [{"count": 8, "file": str(sample_log)}]
+
+
+def test_sources_missing_file_is_error(tmp_path, capsys):
+    missing = tmp_path / "nope.log"
+    assert main(["sources", str(missing)]) == 1
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert captured.err == f"logsift: error: cannot read {missing}: No such file or directory\n"
+
+
 def test_help_returns_zero(capsys):
     assert main(["--help"]) == 0
     assert "summary" in capsys.readouterr().out
