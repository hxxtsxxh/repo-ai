--- a/logsift/cli.py
+++ b/logsift/cli.py
@@ -68,6 +68,17 @@ def cmd_top(args: argparse.Namespace, config: Config) -> int:
     return 0
 
 
+def cmd_sources(args: argparse.Namespace, config: Config) -> int:
+    rows = [(path, len(read_records([path]))) for path in args.files]
+    rows.sort(key=lambda row: (-row[1], row[0]))
+    headers = ["file", "count"]
+    if args.format == "json":
+        sys.stdout.write(render_json(rows_to_objects(headers, rows)))
+    else:
+        sys.stdout.write(render_table(headers, rows, header=not args.no_header))
+    return 0
+
+
 def cmd_export(args: argparse.Namespace, config: Config) -> int:
     records = filter_records(read_records(args.files), min_level=args.level, ignore=config.ignore)
     write_text(args.output, records_to_jsonl(records), force=args.force)
