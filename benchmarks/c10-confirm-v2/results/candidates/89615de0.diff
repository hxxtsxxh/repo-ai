+def test_span_text(sample_log, capsys):
+    assert main(["span", str(sample_log)]) == 0
+    captured = capsys.readouterr()
+    lines = captured.out.splitlines()
+    assert captured.err == ""
+    assert lines[0].split() == ["component", "count", "first", "last", "duration"]
+    # Timestamps contain a space, so each row splits into seven fields.
+    assert [line.split() for line in lines[1:]] == [
+        ["db", "4", "2026-03-04", "10:00:05", "2026-03-04", "10:02:30", "0:02:25"],
+        ["web", "3", "2026-03-04", "10:00:00", "2026-03-04", "10:05:00", "0:05:00"],
+        ["healthcheck", "1", "2026-03-04", "10:03:00", "2026-03-04", "10:03:00", "0:00:00"],
+    ]
+
+
+def test_span_json(sample_log, capsys):
+    assert main(["span", str(sample_log), "--format", "json"]) == 0
+    assert json.loads(capsys.readouterr().out) == [
+        {"component": "db", "count": 4, "first": "2026-03-04T10:00:05Z",
+         "last": "2026-03-04T10:02:30Z", "duration": 145},
+        {"component": "web", "count": 3, "first": "2026-03-04T10:00:00Z",
+         "last": "2026-03-04T10:05:00Z", "duration": 300},
+        {"component": "healthcheck", "count": 1, "first": "2026-03-04T10:03:00Z",
+         "last": "2026-03-04T10:03:00Z", "duration": 0},
+    ]
+
+
+def test_span_across_several_files(sample_log, tmp_path, capsys):
+    other = tmp_path / "other.log"
+    other.write_text("2026-03-05T08:00:00Z CRITICAL db: disk full\n", encoding="utf-8")
+    assert main(["span", str(sample_log), str(other), "--format", "json"]) == 0
+    db = json.loads(capsys.readouterr().out)[0]
+    assert db == {"component": "db", "count": 5, "first": "2026-03-04T10:00:05Z",
+                  "last": "2026-03-05T08:00:00Z", "duration": 79195}
+
+
+def test_span_duration_is_hours_minutes_seconds(tmp_path, capsys):
+    log = tmp_path / "api.log"
+    log.write_text(
+        "2026-03-04T10:00:00Z INFO api: start\n"
+        "2026-03-04T11:02:05Z INFO api: end\n",
+        encoding="utf-8",
+    )
+    assert main(["span", str(log)]) == 0
+    lines = capsys.readouterr().out.splitlines()
+    assert lines[1].split() == ["api", "2", "2026-03-04", "10:00:00", "2026-03-04", "11:02:05", "1:02:05"]
+
+
+def test_span_respects_config_ignore(sample_log, tmp_path, capsys):
+    config = tmp_path / "logsift.toml"
+    config.write_text('[logsift]\nignore = ["healthcheck"]\n', encoding="utf-8")
+    assert main(["--config", str(config), "span", str(sample_log)]) == 0
+    out = capsys.readouterr().out
+    assert "healthcheck" not in out
+    assert out.splitlines()[1].split()[0] == "db"
+
+
