+def read_name_list(path: str) -> list[str]:
+    """Read component names, one per line, from a UTF-8 text file.
+
+    Surrounding whitespace is removed from each name. Blank lines and lines
+    whose first non-space character is ``#`` are skipped. Names are returned
+    in file order.
+    """
+    names: list[str] = []
+    try:
+        with open(path, encoding="utf-8-sig") as handle:
+            for line in handle:
+                name = line.strip()
+                if name and not name.startswith("#"):
+                    names.append(name)
+    except OSError as exc:
+        raise LogsiftError(f"cannot read {path}: {exc.strerror}") from exc
+    except UnicodeDecodeError:
+        raise LogsiftError(f"{path}: not a UTF-8 text file") from None
+    return names
+
