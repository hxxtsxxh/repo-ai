@@ -36,6 +36,52 @@ def test_summary_of_several_files(sample_log, tmp_path, capsys):
     ]
 
 
+TRAFFIC_LOG = """\
+2026-03-04T10:00:00Z INFO cdn: GET /assets/app.js 200 bytes=48213
+2026-03-04T10:00:01Z INFO api: GET /v1/users 200 bytes=250
+2026-03-04T10:00:02Z INFO cdn: GET /assets/logo.png 200 bytes=1000
+2026-03-04T10:00:03Z INFO healthcheck: ok
+2026-03-04T10:00:04Z INFO api: GET /v1/orders 200 bytes=750
+"""
+
+
+def test_traffic_text(tmp_path, capsys):
+    path = tmp_path / "traffic.log"
+    path.write_text(TRAFFIC_LOG, encoding="utf-8")
+    assert main(["traffic", str(path)]) == 0
+    captured = capsys.readouterr()
+    assert captured.out == (
+        "component  bytes\n"
+        "cdn        49213\n"
+        "api         1000\n"
+    )
+    assert captured.err == ""
+
+
+def test_traffic_json(tmp_path, capsys):
+    path = tmp_path / "traffic.log"
+    path.write_text(TRAFFIC_LOG, encoding="utf-8")
+    assert main(["traffic", str(path), "--format", "json"]) == 0
+    assert json.loads(capsys.readouterr().out) == [
+        {"component": "cdn", "bytes": 49213},
+        {"component": "api", "bytes": 1000},
+    ]
+
+
+def test_traffic_respects_config_ignore(tmp_path, capsys):
+    path = tmp_path / "traffic.log"
+    path.write_text(TRAFFIC_LOG, encoding="utf-8")
+    config = tmp_path / "logsift.toml"
+    config.write_text('[logsift]\nignore = ["cdn"]\n', encoding="utf-8")
+    assert main(["--config", str(config), "traffic", str(path)]) == 0
+    assert "cdn" not in capsys.readouterr().out
+
+
+def test_traffic_without_bytes_prints_header_only(sample_log, capsys):
+    assert main(["traffic", str(sample_log)]) == 0
+    assert capsys.readouterr().out == "component  bytes\n"
+
+
 def test_filter_prints_matching_lines_in_order(sample_log, capsys):
     assert main(["filter", str(sample_log), "--level", "error", "--component", "web"]) == 0
     assert capsys.readouterr().out == (
