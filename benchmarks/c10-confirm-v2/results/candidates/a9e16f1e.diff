+def _lines_to_records(*lines):
+    return [parse_line(line, "<test>", n) for n, line in enumerate(lines, start=1)]
+
+
+def test_bytes_by_component_sums_per_component():
+    records = _lines_to_records(
+        "2026-03-04T10:00:00Z INFO cdn: GET /assets/app.js 200 bytes=48213",
+        "2026-03-04T10:00:01Z INFO cdn: GET /assets/logo.png 200 bytes=1000",
+        "2026-03-04T10:00:02Z INFO api: GET /v1/users 200 bytes=250",
+    )
+    assert bytes_by_component(records) == {"cdn": 49213, "api": 250}
+
+
+def test_bytes_by_component_ignores_records_without_bytes():
+    records = _lines_to_records(
+        "2026-03-04T10:00:00Z INFO api: GET /v1/users 200 bytes=10",
+        "2026-03-04T10:00:01Z ERROR api: request 991 failed",
+        "2026-03-04T10:00:02Z INFO worker: job finished",
+    )
+    assert bytes_by_component(records) == {"api": 10}
+
+
+def test_bytes_by_component_empty_when_no_bytes():
+    records = read_records([])
+    assert bytes_by_component(records) == {}
+
+
+def test_bytes_by_component_requires_word_boundary():
+    records = _lines_to_records(
+        "2026-03-04T10:00:00Z INFO api: upstream_nobytes=99 retries=2",
+    )
+    assert bytes_by_component(records) == {}
