@@ -2,6 +2,7 @@
 
 import json
 from collections.abc import Sequence
+from datetime import datetime, timedelta
 from typing import Any
 
 
@@ -32,3 +33,25 @@ def rows_to_objects(headers: Sequence[str], rows: Sequence[Sequence[Any]]) -> li
 def render_json(value: Any) -> str:
     """Render a value as indented JSON with sorted keys."""
     return json.dumps(value, indent=2, sort_keys=True, ensure_ascii=False) + "\n"
+
+
+def format_text_time(value: datetime) -> str:
+    """Format a UTC time as ``YYYY-MM-DD HH:MM:SS`` for text output."""
+    return value.strftime("%Y-%m-%d %H:%M:%S")
+
+
+def format_json_time(value: datetime) -> str:
+    """Format a UTC time as ``YYYY-MM-DDTHH:MM:SSZ`` for JSON output."""
+    return value.strftime("%Y-%m-%dT%H:%M:%SZ")
+
+
+def whole_seconds(value: timedelta) -> int:
+    """Return the duration in seconds, dropping any fraction."""
+    return value // timedelta(seconds=1)
+
+
+def format_duration(value: timedelta) -> str:
+    """Format a duration as ``H:MM:SS``; hours are not padded and may exceed 24."""
+    hours, rest = divmod(whole_seconds(value), 3600)
+    minutes, seconds = divmod(rest, 60)
+    return f"{hours}:{minutes:02d}:{seconds:02d}"
diff --git a/logsift/stats.py b/logsift/stats.py
index 8962111..970f412 100644
--- a/logsift/stats.py
+++ b/logsift/stats.py
@@ -3,12 +3,40 @@
 import re
 from collections import Counter
 from collections.abc import Iterable
+from dataclasses import dataclass
+from datetime import datetime, timedelta
 
 from .records import LogRecord
 
 _DIGITS_RE = re.compile(r"\d+")
 
 
+@dataclass(frozen=True)
+class ComponentSpan:
+    """The records of one component and the time range they cover."""
+
+    component: str
+    count: int
+    first: datetime
+    last: datetime
+
+    @property
+    def duration(self) -> timedelta:
+        return self.last - self.first
+
+
+def span_by_component(records: Iterable[LogRecord]) -> list[ComponentSpan]:
+    """Return one span per component, highest count first, then by component name."""
+    times: dict[str, list[datetime]] = {}
+    for record in records:
+        times.setdefault(record.component, []).append(record.time)
+    spans = [
+        ComponentSpan(component=name, count=len(values), first=min(values), last=max(values))
+        for name, values in times.items()
+    ]
+    return sorted(spans, key=lambda span: (-span.count, span.component))
+
+
 def sort_counts(counts: Counter[str]) -> list[tuple[str, int]]:
     """Order counted keys by count, highest first, then by key."""
     return sorted(counts.items(), key=lambda item: (-item[1], item[0]))
diff --git a/tests/test_span.py b/tests/test_span.py
new file mode 100644
index 0000000..85fbc1f
--- /dev/null
+++ b/tests/test_span.py
@@ -0,0 +1,103 @@
+import json
+
+from logsift.cli import main
+
+
+def test_span_text(sample_log, capsys):
+    assert main(["span", str(sample_log)]) == 0
+    captured = capsys.readouterr()
+    assert captured.out == (
+        "component    count  first" + " " * 16 + "last" + " " * 17 + "duration\n"
+        + "db" + " " * 15 + "4  2026-03-04 10:00:05  2026-03-04 10:02:30  0:02:25\n"
+        + "web" + " " * 14 + "3  2026-03-04 10:00:00  2026-03-04 10:05:00  0:05:00\n"
+        + "healthcheck" + " " * 6 + "1  2026-03-04 10:03:00  2026-03-04 10:03:00  0:00:00\n"
+    )
+    assert captured.err == ""
+
+
+def test_span_json(sample_log, capsys):
+    assert main(["span", str(sample_log), "--format", "json"]) == 0
+    assert json.loads(capsys.readouterr().out) == [
+        {
+            "component": "db",
+            "count": 4,
+            "first": "2026-03-04T10:00:05Z",
+            "last": "2026-03-04T10:02:30Z",
+            "duration": 145,
+        },
+        {
+            "component": "web",
+            "count": 3,
+            "first": "2026-03-04T10:00:00Z",
+            "last": "2026-03-04T10:05:00Z",
+            "duration": 300,
+        },
+        {
+            "component": "healthcheck",
+            "count": 1,
+            "first": "2026-03-04T10:03:00Z",
+            "last": "2026-03-04T10:03:00Z",
+            "duration": 0,
+        },
+    ]
+
+
+def test_span_uses_earliest_and_latest_across_files(sample_log, tmp_path, capsys):
+    other = tmp_path / "other.log"
+    other.write_text("2026-03-03T23:00:00Z WARNING db: earlier\n", encoding="utf-8")
+    assert main(["span", str(sample_log), str(other), "--format", "json"]) == 0
+    db = json.loads(capsys.readouterr().out)[0]
+    assert db == {
+        "component": "db",
+        "count": 5,
+        "first": "2026-03-03T23:00:00Z",
+        "last": "2026-03-04T10:02:30Z",
+        "duration": 39750,
+    }
+
+
+def test_span_ties_are_ordered_by_component(tmp_path, capsys):
+    path = tmp_path / "tie.log"
+    path.write_text(
+        "2026-03-04T10:00:00Z INFO beta: one\n2026-03-04T10:00:00Z INFO alpha: one\n",
+        encoding="utf-8",
+    )
+    assert main(["span", str(path), "--format", "json"]) == 0
+    assert [item["component"] for item in json.loads(capsys.readouterr().out)] == ["alpha", "beta"]
+
+
+def test_span_duration_drops_fractional_seconds(tmp_path, capsys):
+    path = tmp_path / "long.log"
+    path.write_text(
+        "2026-03-04T10:00:00Z INFO api: start\n2026-03-04T11:02:05.900000Z INFO api: stop\n",
+        encoding="utf-8",
+    )
+    assert main(["span", str(path)]) == 0
+    out = capsys.readouterr().out
+    assert "2026-03-04 10:00:00  2026-03-04 11:02:05  1:02:05\n" in out
+
+    assert main(["span", str(path), "--format", "json"]) == 0
+    assert json.loads(capsys.readouterr().out)[0]["duration"] == 3725
+
+
+def test_span_respects_config_ignore(sample_log, tmp_path, capsys):
+    config = tmp_path / "logsift.toml"
+    config.write_text('[logsift]\nignore = ["healthcheck"]\n', encoding="utf-8")
+    assert main(["--config", str(config), "span", str(sample_log), "--format", "json"]) == 0
+    components = [item["component"] for item in json.loads(capsys.readouterr().out)]
+    assert components == ["db", "web"]
+
+
+def test_span_of_missing_file_is_an_error(tmp_path, capsys):
+    missing = tmp_path / "nope.log"
+    assert main(["span", str(missing)]) == 1
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert captured.err == f"logsift: error: cannot read {missing}: No such file or directory\n"
+
+
+def test_span_rejects_unknown_format(sample_log, capsys):
+    assert main(["span", str(sample_log), "--format", "xml"]) == 2
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert "invalid choice: 'xml'" in captured.err
