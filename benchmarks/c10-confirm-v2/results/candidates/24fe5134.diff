diff --git a/tests/test_resolve_config.py b/tests/test_resolve_config.py
new file mode 100644
index 0000000..b9bdb75
--- /dev/null
+++ b/tests/test_resolve_config.py
@@ -0,0 +1,54 @@
+import pytest
+
+from logsift.config import Config, resolve_config
+from logsift.errors import ConfigError
+
+
+def test_no_path_and_no_environment_gives_defaults():
+    assert resolve_config(None, {}) == Config()
+
+
+def test_environment_alone_sets_ignore():
+    assert resolve_config(None, {"LOGSIFT_IGNORE": "healthcheck,metrics"}) == Config(
+        ignore=("healthcheck", "metrics")
+    )
+
+
+def test_environment_items_are_stripped_and_blanks_dropped():
+    environ = {"LOGSIFT_IGNORE": " healthcheck , ,metrics,"}
+    assert resolve_config(None, environ) == Config(ignore=("healthcheck", "metrics"))
+
+
+def test_empty_environment_value_is_no_setting():
+    assert resolve_config(None, {"LOGSIFT_IGNORE": ""}) == Config()
+
+
+def test_file_alone_is_loaded(tmp_path):
+    path = tmp_path / "logsift.toml"
+    path.write_text('[logsift]\nignore = ["web"]\n', encoding="utf-8")
+    assert resolve_config(str(path), {}) == Config(ignore=("web",))
+
+
+def test_file_and_environment_are_unioned_in_order(tmp_path):
+    path = tmp_path / "logsift.toml"
+    path.write_text('[logsift]\nignore = ["healthcheck", "metrics"]\n', encoding="utf-8")
+    environ = {"LOGSIFT_IGNORE": "web,metrics,healthcheck,db"}
+    assert resolve_config(str(path), environ) == Config(ignore=("healthcheck", "metrics", "web", "db"))
+
+
+def test_other_environment_variables_are_ignored():
+    environ = {"HOME": "/root", "LOGSIFT_COLOUR": "always"}
+    assert resolve_config(None, environ) == Config()
+
+
+def test_missing_file_is_an_error_even_with_environment(tmp_path):
+    missing = tmp_path / "nope.toml"
+    with pytest.raises(ConfigError, match="cannot read"):
+        resolve_config(str(missing), {"LOGSIFT_IGNORE": "web"})
+
+
+def test_invalid_file_is_an_error(tmp_path):
+    path = tmp_path / "logsift.toml"
+    path.write_text("[logsift\n", encoding="utf-8")
+    with pytest.raises(ConfigError, match="invalid TOML"):
+        resolve_config(str(path), {})
