diff --git a/logsift/config.py b/logsift/config.py
index 37d1c50..8d9742e 100644
--- a/logsift/config.py
+++ b/logsift/config.py
@@ -4,14 +4,20 @@ Example::
 
     [logsift]
     ignore = ["healthcheck", "metrics"]
+
+The same setting can come from the environment as a comma-separated list::
+
+    LOGSIFT_IGNORE=healthcheck,metrics
 """
 
 import tomllib
+from collections.abc import Mapping
 from dataclasses import dataclass
 
 from .errors import ConfigError
 
 _KNOWN_KEYS = {"ignore"}
+ENV_IGNORE = "LOGSIFT_IGNORE"
 
 
 @dataclass(frozen=True)
@@ -40,3 +46,18 @@ def load_config(path: str) -> Config:
     if not isinstance(ignore, list) or not all(isinstance(item, str) for item in ignore):
         raise ConfigError(f"{path}: 'ignore' must be a list of strings")
     return Config(ignore=tuple(ignore))
+
+
+def resolve_config(path: str | None, environ: Mapping[str, str]) -> Config:
+    """Combine the config file at ``path`` (if any) with environment settings.
+
+    List settings are unioned: file entries come first, then environment
+    entries that are not already present. Blank items are ignored.
+    """
+    base = load_config(path) if path is not None else Config()
+    ignore = list(base.ignore)
+    for name in environ.get(ENV_IGNORE, "").split(","):
+        name = name.strip()
+        if name and name not in ignore:
+            ignore.append(name)
+    return Config(ignore=tuple(ignore))
