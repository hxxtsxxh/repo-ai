--- a/logsift/config.py
+++ b/logsift/config.py
@@ -40,3 +40,20 @@ def load_config(path: str) -> Config:
     if not isinstance(ignore, list) or not all(isinstance(item, str) for item in ignore):
         raise ConfigError(f"{path}: 'ignore' must be a list of strings")
     return Config(ignore=tuple(ignore))
+
+
+def read_name_list(path: str) -> list[str]:
+    """Read component names, one per line, from a UTF-8 text file.
+
+    Surrounding whitespace is removed, blank lines are skipped, and lines
+    whose first non-space character is ``#`` are treated as comments.
+    Names are returned in file order.
+    """
+    names = []
+    with open(path, "r", encoding="utf-8") as handle:
+        for line in handle:
+            name = line.strip()
+            if not name or name.startswith("#"):
+                continue
+            names.append(name)
+    return names
