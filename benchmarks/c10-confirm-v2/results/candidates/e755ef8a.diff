+
+
+def test_read_name_list_keeps_file_order(tmp_path):
+    path = tmp_path / "ignore.txt"
+    path.write_text("web\ndb\nhealthcheck\n", encoding="utf-8")
+    assert read_name_list(str(path)) == ["web", "db", "healthcheck"]
+
+
+def test_read_name_list_strips_whitespace(tmp_path):
+    path = tmp_path / "ignore.txt"
+    path.write_text("  web  \n\tdb\t\n   metrics", encoding="utf-8")
+    assert read_name_list(str(path)) == ["web", "db", "metrics"]
+
+
+def test_read_name_list_skips_blank_lines_and_comments(tmp_path):
+    path = tmp_path / "ignore.txt"
+    path.write_text(
+        "# components to hide\n\nweb\n   \n  # indented comment\ndb # not a comment\n#web\n",
+        encoding="utf-8",
+    )
+    assert read_name_list(str(path)) == ["web", "db # not a comment"]
+
+
+def test_read_name_list_handles_crlf_and_utf8(tmp_path):
+    path = tmp_path / "ignore.txt"
+    path.write_bytes("café\r\nweb\r\n".encode("utf-8"))
+    assert read_name_list(str(path)) == ["café", "web"]
+
+
+def test_read_name_list_empty_file(tmp_path):
+    path = tmp_path / "ignore.txt"
+    path.write_text("", encoding="utf-8")
+    assert read_name_list(str(path)) == []
+
+
+def test_read_name_list_missing_file(tmp_path):
+    with pytest.raises(FileNotFoundError):
+        read_name_list(str(tmp_path / "missing.txt"))
