 from .errors import ConfigError
 
 _KNOWN_KEYS = {"ignore"}
+_ENV_PREFIX = "LOGSIFT_"
 
 
 @dataclass(frozen=True)
@@ -40,3 +42,22 @@ def load_config(path: str) -> Config:
     if not isinstance(ignore, list) or not all(isinstance(item, str) for item in ignore):
         raise ConfigError(f"{path}: 'ignore' must be a list of strings")
     return Config(ignore=tuple(ignore))
+
+
+def _split_list(value: str) -> tuple[str, ...]:
+    """Split a comma-separated environment value, dropping blank items."""
+    return tuple(item for item in (part.strip() for part in value.split(",")) if item)
+
+
+def resolve_config(path: str | None, environ: Mapping[str, str]) -> Config:
+    """Return the effective settings: environment variables over the config file over defaults.
+
+    ``path`` is the ``--config`` file, or None to skip it. An environment variable for key
+    ``<key>`` is ``LOGSIFT_<KEY>``; an empty value counts as unset. A set variable replaces
+    the value from the file for that setting.
+    """
+    config = load_config(path) if path is not None else Config()
+    raw_ignore = environ.get(_ENV_PREFIX + "IGNORE", "")
+    if raw_ignore:
+        config = replace(config, ignore=_split_list(raw_ignore))
+    return config
diff --git a/tests/test_resolve_config.py b/tests/test_resolve_config.py
new file mode 100644
index 0000000..cd2a16b
--- /dev/null
+++ b/tests/test_resolve_config.py
@@ -0,0 +1,64 @@
+import pytest
+
+from logsift.cli import main
+from logsift.config import Config, resolve_config
+from logsift.errors import ConfigError
+
+
+def _write(tmp_path, content):
+    path = tmp_path / "logsift.toml"
+    path.write_text(content, encoding="utf-8")
+    return str(path)
+
+
+def test_no_path_and_no_environment_gives_defaults():
+    assert resolve_config(None, {}) == Config()
+
+
+def test_file_is_used_when_environment_is_silent(tmp_path):
+    path = _write(tmp_path, '[logsift]\nignore = ["healthcheck", "metrics"]\n')
+    assert resolve_config(path, {}) == Config(ignore=("healthcheck", "metrics"))
+
+
+def test_environment_ignore_without_file():
+    assert resolve_config(None, {"LOGSIFT_IGNORE": "healthcheck,metrics"}) == Config(
+        ignore=("healthcheck", "metrics")
+    )
+
+
+def test_environment_overrides_file(tmp_path):
+    path = _write(tmp_path, '[logsift]\nignore = ["healthcheck"]\n')
+    assert resolve_config(path, {"LOGSIFT_IGNORE": "metrics"}) == Config(ignore=("metrics",))
+
+
+def test_environment_list_is_stripped_and_empty_items_dropped():
+    environ = {"LOGSIFT_IGNORE": " healthcheck , ,metrics,, "}
+    assert resolve_config(None, environ) == Config(ignore=("healthcheck", "metrics"))
+
+
+def test_empty_environment_value_counts_as_unset(tmp_path):
+    path = _write(tmp_path, '[logsift]\nignore = ["healthcheck"]\n')
+    assert resolve_config(path, {"LOGSIFT_IGNORE": ""}) == Config(ignore=("healthcheck",))
+    assert resolve_config(None, {"LOGSIFT_IGNORE": ""}) == Config()
+
+
+def test_other_environment_variables_are_ignored():
+    assert resolve_config(None, {"IGNORE": "x", "LOGSIFT_OTHER": "y", "PATH": "/bin"}) == Config()
+
+
+def test_main_uses_environment_ignore(sample_log, monkeypatch, capsys):
+    monkeypatch.setenv("LOGSIFT_IGNORE", "healthcheck")
+    assert main(["summary", str(sample_log), "--by", "component"]) == 0
+    assert "healthcheck" not in capsys.readouterr().out
+
+
+def test_missing_file_is_an_error(tmp_path):
+    missing = str(tmp_path / "nope.toml")
+    with pytest.raises(ConfigError, match=r"^cannot read .*nope\.toml: "):
+        resolve_config(missing, {})
+
+
+def test_bad_file_is_an_error_even_when_environment_is_set(tmp_path):
+    path = _write(tmp_path, "[logsift]\nignored = []\n")
+    with pytest.raises(ConfigError, match="unknown setting 'ignored'"):
+        resolve_config(path, {"LOGSIFT_IGNORE": "metrics"})
