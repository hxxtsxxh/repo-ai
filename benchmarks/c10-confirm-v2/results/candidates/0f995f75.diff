+def test_read_name_list_keeps_file_order(tmp_path):
+    path = tmp_path / "ignore.txt"
+    path.write_text("web\ndb\nhealthcheck\n", encoding="utf-8")
+    assert read_name_list(str(path)) == ["web", "db", "healthcheck"]
+
+
+def test_read_name_list_strips_whitespace(tmp_path):
+    path = tmp_path / "ignore.txt"
+    path.write_text("  web  \n\tdb\t\r\n", encoding="utf-8")
+    assert read_name_list(str(path)) == ["web", "db"]
+
+
+def test_read_name_list_skips_blank_and_comment_lines(tmp_path):
+    path = tmp_path / "ignore.txt"
+    path.write_text(
+        "# components to ignore\n\n   \nweb\n  # indented comment\n\tdb # not a comment\n",
+        encoding="utf-8",
+    )
+    assert read_name_list(str(path)) == ["web", "db # not a comment"]
+
+
+def test_read_name_list_reads_utf8(tmp_path):
+    path = tmp_path / "ignore.txt"
+    path.write_bytes("café\n".encode("utf-8"))
+    assert read_name_list(str(path)) == ["café"]
+
+
+def test_read_name_list_empty_file(tmp_path):
+    path = tmp_path / "ignore.txt"
+    path.write_text("", encoding="utf-8")
+    assert read_name_list(str(path)) == []
+
+
+def test_read_name_list_missing_file(tmp_path):
+    path = tmp_path / "missing.txt"
+    with pytest.raises(LogsiftError) as info:
+        read_name_list(str(path))
+    assert str(info.value) == f"cannot read {path}: No such file or directory"
+
+
+def test_read_name_list_rejects_invalid_utf8(tmp_path):
+    path = tmp_path / "ignore.txt"
+    path.write_bytes(b"web\n\xff\n")
+    with pytest.raises(LogsiftError, match="not valid UTF-8"):
+        read_name_list(str(path))
