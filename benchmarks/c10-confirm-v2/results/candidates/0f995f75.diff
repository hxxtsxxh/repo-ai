+def read_name_list(path: str) -> list[str]:
+    """Read component names, one per line, from a UTF-8 text file.
+
+    Names are returned in file order with surrounding whitespace removed.
+    Blank lines and lines whose first non-space character is ``#`` are skipped.
+    """
+    names = []
+    try:
+        with open(path, encoding="utf-8") as handle:
+            for line in handle:
+                name = line.strip()
+                if name and not name.startswith("#"):
+                    names.append(name)
+    except OSError as exc:
+        raise LogsiftError(f"cannot read {path}: {exc.strerror}") from exc
+    except UnicodeDecodeError as exc:
+        raise LogsiftError(f"cannot read {path}: not valid UTF-8") from exc
+    return names
+
