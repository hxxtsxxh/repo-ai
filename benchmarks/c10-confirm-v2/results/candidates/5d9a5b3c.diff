@@ -36,6 +36,57 @@ def test_summary_of_several_files(sample_log, tmp_path, capsys):
     ]
 
 
+TRAFFIC_LOG = """\
+2026-03-04T10:00:00Z INFO cdn: GET /assets/app.js 200 bytes=48213
+2026-03-04T10:00:01Z INFO api: GET /users 200 bytes=900
+2026-03-04T10:00:02Z INFO cdn: GET /assets/logo.png 200 bytes=1536
+2026-03-04T10:00:03Z INFO api: POST /login 204
+2026-03-04T10:00:04Z INFO healthcheck: ok bytes=10
+"""
+
+
+def test_traffic_text(tmp_path, capsys):
+    path = tmp_path / "traffic.log"
+    path.write_text(TRAFFIC_LOG, encoding="utf-8")
+    assert main(["traffic", str(path)]) == 0
+    captured = capsys.readouterr()
+    assert captured.out == (
+        "component    bytes\n"
+        "cdn          48.6 KiB\n"
+        "api          900 B\n"
+        "healthcheck  10 B\n"
+    )
+    assert captured.err == ""
+
+
+def test_traffic_json(tmp_path, capsys):
+    path = tmp_path / "traffic.log"
+    path.write_text(TRAFFIC_LOG, encoding="utf-8")
+    assert main(["traffic", str(path), "--format", "json"]) == 0
+    assert json.loads(capsys.readouterr().out) == [
+        {"component": "cdn", "bytes": 49749},
+        {"component": "api", "bytes": 900},
+        {"component": "healthcheck", "bytes": 10},
+    ]
+
+
+def test_traffic_applies_config_ignore(tmp_path, capsys):
+    path = tmp_path / "traffic.log"
+    path.write_text(TRAFFIC_LOG, encoding="utf-8")
+    config = tmp_path / "logsift.toml"
+    config.write_text('[logsift]\nignore = ["cdn"]\n', encoding="utf-8")
+    assert main(["--config", str(config), "traffic", str(path), "--format", "json"]) == 0
+    assert json.loads(capsys.readouterr().out) == [
+        {"component": "api", "bytes": 900},
+        {"component": "healthcheck", "bytes": 10},
+    ]
+
+
+def test_traffic_without_sizes_prints_only_header(sample_log, capsys):
+    assert main(["traffic", str(sample_log)]) == 0
+    assert capsys.readouterr().out == "component  bytes\n"
+
+
