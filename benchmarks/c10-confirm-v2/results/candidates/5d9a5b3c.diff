index 68a77f3..933246a 100644
--- a/logsift/render.py
+++ b/logsift/render.py
@@ -24,6 +24,21 @@ def render_table(headers: Sequence[str], rows: Sequence[Sequence[Any]]) -> str:
     return "\n".join(lines) + "\n"
 
 
+_BYTE_UNITS = ("KiB", "MiB", "GiB", "TiB")
+
+
+def format_bytes(count: int) -> str:
+    """Show a byte count as ``<n> B`` below 1024, otherwise in binary units such as ``1.5 KiB``."""
+    if count < 1024:
+        return f"{count} B"
+    value = count / 1024
+    unit_index = 0
+    while value >= 1024 and unit_index < len(_BYTE_UNITS) - 1:
+        value /= 1024
+        unit_index += 1
+    return f"{value:.1f} {_BYTE_UNITS[unit_index]}"
+
+
 def rows_to_objects(headers: Sequence[str], rows: Sequence[Sequence[Any]]) -> list[dict[str, Any]]:
     """Turn rows into a list of objects keyed by the column headers."""
     return [dict(zip(headers, row)) for row in rows]
diff --git a/logsift/stats.py b/logsift/stats.py
index 8962111..84cd73d 100644
--- a/logsift/stats.py
+++ b/logsift/stats.py
@@ -2,18 +2,33 @@
 
 import re
 from collections import Counter
-from collections.abc import Iterable
+from collections.abc import Iterable, Mapping
 
 from .records import LogRecord
 
 _DIGITS_RE = re.compile(r"\d+")
+_BYTES_RE = re.compile(r"\bbytes=(\d+)\b")
 
 
-def sort_counts(counts: Counter[str]) -> list[tuple[str, int]]:
+def sort_counts(counts: Mapping[str, int]) -> list[tuple[str, int]]:
     """Order counted keys by count, highest first, then by key."""
     return sorted(counts.items(), key=lambda item: (-item[1], item[0]))
 
 
+def bytes_by_component(records: Iterable[LogRecord]) -> dict[str, int]:
+    """Sum the ``bytes=<n>`` values in each record's message, per component.
+
+    Records without a ``bytes=<n>`` value are ignored, so components with no such
+    record do not appear in the result.
+    """
+    totals: dict[str, int] = {}
+    for record in records:
+        match = _BYTES_RE.search(record.message)
+        if match is not None:
+            totals[record.component] = totals.get(record.component, 0) + int(match[1])
+    return totals
+
+
 def count_by(records: Iterable[LogRecord], field: str) -> list[tuple[str, int]]:
     """Count records by the value of one field, such as ``level`` or ``component``."""
     return sort_counts(Counter(getattr(record, field) for record in records))
