diff --git a/logsift/render.py b/logsift/render.py
index 68a77f3..3746109 100644
--- a/logsift/render.py
+++ b/logsift/render.py
@@ -29,6 +29,18 @@ def rows_to_objects(headers: Sequence[str], rows: Sequence[Sequence[Any]]) -> li
     return [dict(zip(headers, row)) for row in rows]
 
 
+def format_bytes(count: int) -> str:
+    """Format a byte count for text output, such as ``512 B`` or ``1.5 KiB``."""
+    if count < 1024:
+        return f"{count} B"
+    value = float(count)
+    for unit in ("KiB", "MiB", "GiB"):
+        value /= 1024
+        if value < 1024:
+            return f"{value:.1f} {unit}"
+    return f"{value / 1024:.1f} TiB"
+
+
 def render_json(value: Any) -> str:
     """Render a value as indented JSON with sorted keys."""
     return json.dumps(value, indent=2, sort_keys=True, ensure_ascii=False) + "\n"
diff --git a/logsift/stats.py b/logsift/stats.py
index 8962111..0b1d4b5 100644
--- a/logsift/stats.py
+++ b/logsift/stats.py
@@ -7,6 +7,7 @@ from collections.abc import Iterable
 from .records import LogRecord
 
 _DIGITS_RE = re.compile(r"\d+")
+_BYTES_RE = re.compile(r"\bbytes=([0-9]+)")
 
 
 def sort_counts(counts: Counter[str]) -> list[tuple[str, int]]:
@@ -28,3 +29,17 @@ def top_messages(records: Iterable[LogRecord], limit: int) -> list[tuple[str, in
     """Return the ``limit`` most frequent normalized messages."""
     counts = Counter(normalize_message(record.message) for record in records)
     return sort_counts(counts)[:limit]
+
+
+def bytes_by_component(records: Iterable[LogRecord]) -> dict[str, int]:
+    """Sum the ``bytes=<n>`` values in each component's messages.
+
+    Records whose message has no ``bytes=<n>`` are ignored, and components
+    without any such record do not appear in the result.
+    """
+    totals: dict[str, int] = {}
+    for record in records:
+        match = _BYTES_RE.search(record.message)
+        if match is not None:
+            totals[record.component] = totals.get(record.component, 0) + int(match.group(1))
+    return totals
diff --git a/tests/test_cli.py b/tests/test_cli.py
index 0b4b1b5..7949f1c 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -148,3 +148,52 @@ def test_unknown_level_is_usage_error(sample_log, capsys):
 def test_help_returns_zero(capsys):
     assert main(["--help"]) == 0
     assert "summary" in capsys.readouterr().out
+
+
+TRAFFIC = """\
+2026-03-04T10:00:00Z INFO cdn: GET /assets/app.js 200 bytes=48213
+2026-03-04T10:00:01Z INFO cdn: GET /assets/logo.png 200 bytes=1000
+2026-03-04T10:00:02Z INFO api: GET /users 200 bytes=12
+2026-03-04T10:00:03Z INFO api: POST /users 201
+2026-03-04T10:00:04Z DEBUG web: started on port 8080
+"""
+
+
+def test_traffic_text(tmp_path, capsys):
+    log = tmp_path / "traffic.log"
+    log.write_text(TRAFFIC, encoding="utf-8")
+    assert main(["traffic", str(log)]) == 0
+    captured = capsys.readouterr()
+    assert captured.out == (
+        "component  bytes\n"
+        "cdn        48.1 KiB\n"
+        "api        12 B\n"
+    )
+    assert captured.err == ""
+
+
+def test_traffic_json(tmp_path, capsys):
+    log = tmp_path / "traffic.log"
+    log.write_text(TRAFFIC, encoding="utf-8")
+    assert main(["traffic", str(log), "--format", "json"]) == 0
+    assert json.loads(capsys.readouterr().out) == [
+        {"component": "cdn", "bytes": 49213},
+        {"component": "api", "bytes": 12},
+    ]
+
+
+def test_traffic_text_uses_binary_units(tmp_path, capsys):
+    log = tmp_path / "sizes.log"
+    log.write_text(
+        "2026-03-04T10:00:00Z INFO a: GET /x 200 bytes=1536\n"
+        "2026-03-04T10:00:01Z INFO b: GET /y 200 bytes=3145728\n",
+        encoding="utf-8",
+    )
+    assert main(["traffic", str(log)]) == 0
+    rows = [line.split() for line in capsys.readouterr().out.splitlines()]
+    assert rows == [["component", "bytes"], ["b", "3.0", "MiB"], ["a", "1.5", "KiB"]]
+
+
+def test_traffic_with_no_bytes_prints_only_header(sample_log, capsys):
+    assert main(["traffic", str(sample_log)]) == 0
+    assert capsys.readouterr().out == "component  bytes\n"
