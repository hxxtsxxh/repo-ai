@@ -19,6 +21,21 @@ class Config:
     ignore: tuple[str, ...] = ()
 
 
+def resolve_config(path: str | None, environ: Mapping[str, str]) -> Config:
+    """Return the effective settings from the config file and the environment.
+
+    The config file at ``path`` is read first when it is given, so its errors are
+    reported even when the environment overrides its values. An environment variable
+    that is set to a non-empty string overrides the file's value for its setting;
+    list values are comma-separated, stripped, and empty items are dropped.
+    """
+    config = load_config(path) if path is not None else Config()
+    ignore = environ.get(_ENV_IGNORE, "")
+    if ignore != "":
+        config = replace(config, ignore=tuple(item.strip() for item in ignore.split(",") if item.strip()))
+    return config
+
