diff --git a/tests/test_config.py b/tests/test_config.py
new file mode 100644
index 0000000..a558d91
--- /dev/null
+++ b/tests/test_config.py
@@ -0,0 +1,60 @@
+import pytest
+
+from logsift.config import Config, resolve_config
+from logsift.errors import ConfigError
+
+
+def _write(tmp_path, content):
+    path = tmp_path / "logsift.toml"
+    path.write_text(content, encoding="utf-8")
+    return str(path)
+
+
+def test_resolve_without_file_or_environment_is_default():
+    assert resolve_config(None, {}) == Config()
+
+
+def test_resolve_reads_ignore_from_environment():
+    assert resolve_config(None, {"LOGSIFT_IGNORE": "web,db"}) == Config(ignore=("web", "db"))
+
+
+def test_resolve_strips_items_and_drops_empty_ones():
+    environ = {"LOGSIFT_IGNORE": " web ,, db ,  , metrics,"}
+    assert resolve_config(None, environ) == Config(ignore=("web", "db", "metrics"))
+
+
+def test_resolve_uses_file_when_environment_is_absent(tmp_path):
+    path = _write(tmp_path, '[logsift]\nignore = ["healthcheck"]\n')
+    assert resolve_config(path, {}) == Config(ignore=("healthcheck",))
+
+
+def test_resolve_environment_overrides_file(tmp_path):
+    path = _write(tmp_path, '[logsift]\nignore = ["healthcheck"]\n')
+    assert resolve_config(path, {"LOGSIFT_IGNORE": "web"}) == Config(ignore=("web",))
+
+
+def test_resolve_empty_environment_variable_counts_as_unset(tmp_path):
+    path = _write(tmp_path, '[logsift]\nignore = ["healthcheck"]\n')
+    assert resolve_config(path, {"LOGSIFT_IGNORE": ""}) == Config(ignore=("healthcheck",))
+
+
+def test_resolve_environment_with_only_separators_overrides_file_with_empty_list(tmp_path):
+    path = _write(tmp_path, '[logsift]\nignore = ["healthcheck"]\n')
+    assert resolve_config(path, {"LOGSIFT_IGNORE": " , "}) == Config()
+
+
+def test_resolve_ignores_unrelated_variables():
+    environ = {"LOGSIFT_MAX_WIDTH": "80", "HOME": "/root"}
+    assert resolve_config(None, environ) == Config()
+
+
+def test_resolve_reports_file_errors_even_when_environment_is_set(tmp_path):
+    path = _write(tmp_path, "[logsift]\nignored = []\n")
+    with pytest.raises(ConfigError, match="unknown setting 'ignored'"):
+        resolve_config(path, {"LOGSIFT_IGNORE": "web"})
+
+
+def test_resolve_missing_file_is_an_error(tmp_path):
+    missing = tmp_path / "nope.toml"
+    with pytest.raises(ConfigError, match="cannot read"):
+        resolve_config(str(missing), {"LOGSIFT_IGNORE": "web"})
