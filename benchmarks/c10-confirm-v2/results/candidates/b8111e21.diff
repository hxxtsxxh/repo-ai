diff --git a/tests/test_cli.py b/tests/test_cli.py
index 0b4b1b5..5c0f9a3 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -114,6 +114,78 @@ def test_malformed_line_is_an_error(tmp_path, capsys):
     assert captured.err == f"logsift: error: cannot parse {path} line 2: 'broken'\n"
 
 
+def test_summary_fails_on_malformed_line_by_default(tmp_path, capsys):
+    path = tmp_path / "truncated.log"
+    path.write_text("2026-03-04T10:00:00Z INFO web: ok\n2026-03-04T10:0", encoding="utf-8")
+    assert main(["summary", str(path)]) == 1
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert captured.err == f"logsift: error: cannot parse {path} line 2: '2026-03-04T10:0'\n"
+
+
+def test_summary_skip_invalid_counts_valid_records_and_reports_skips(tmp_path, capsys):
+    path = tmp_path / "corrupt.log"
+    path.write_text(
+        "2026-03-04T10:00:00Z INFO web: ok\n"
+        "garbage\n"
+        "2026-03-04T10:01:00Z ERROR db: lost\n"
+        "\n"
+        "2026-03-04T10:0\n",
+        encoding="utf-8",
+    )
+    assert main(["summary", str(path), "--skip-invalid"]) == 0
+    captured = capsys.readouterr()
+    assert captured.out == (
+        "level  count\n"
+        "ERROR      1\n"
+        "INFO       1\n"
+    )
+    assert captured.err == (
+        f"logsift: skipped invalid line: cannot parse {path} line 2: 'garbage'\n"
+        f"logsift: skipped invalid line: cannot parse {path} line 5: '2026-03-04T10:0'\n"
+        "logsift: skipped 2 invalid lines\n"
+    )
+
+
+def test_summary_skip_invalid_json_keeps_stdout_clean(tmp_path, capsys):
+    path = tmp_path / "corrupt.log"
+    path.write_text("2026-03-04T10:00:00Z INFO web: ok\nbroken\n", encoding="utf-8")
+    assert main(["summary", str(path), "--skip-invalid", "--format", "json"]) == 0
+    captured = capsys.readouterr()
+    assert json.loads(captured.out) == [{"level": "INFO", "count": 1}]
+    assert captured.err == (
+        f"logsift: skipped invalid line: cannot parse {path} line 2: 'broken'\n"
+        "logsift: skipped 1 invalid line\n"
+    )
+
+
+def test_summary_skip_invalid_with_clean_input_reports_nothing(sample_log, capsys):
+    assert main(["summary", str(sample_log), "--skip-invalid"]) == 0
+    captured = capsys.readouterr()
+    assert captured.err == ""
+    assert "ERROR         3" in captured.out
+
+
+def test_summary_skip_invalid_reports_every_skipped_line_across_files(tmp_path, capsys):
+    first = tmp_path / "a.log"
+    first.write_text("junk\n2026-03-04T10:00:00Z INFO web: ok\n", encoding="utf-8")
+    second = tmp_path / "b.log"
+    second.write_text("more junk\n", encoding="utf-8")
+    assert main(["summary", str(first), str(second), "--skip-invalid", "--by", "component"]) == 0
+    captured = capsys.readouterr()
+    assert captured.out.splitlines() == ["component  count", "web            1"]
+    assert captured.err == (
+        f"logsift: skipped invalid line: cannot parse {first} line 1: 'junk'\n"
+        f"logsift: skipped invalid line: cannot parse {second} line 1: 'more junk'\n"
+        "logsift: skipped 2 invalid lines\n"
+    )
+
+
+def test_skip_invalid_is_not_available_for_other_commands(sample_log, capsys):
+    assert main(["filter", str(sample_log), "--skip-invalid"]) == 2
+    assert "unrecognized arguments: --skip-invalid" in capsys.readouterr().err
+
+
