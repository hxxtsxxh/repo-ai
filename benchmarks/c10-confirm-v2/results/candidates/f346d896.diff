diff --git a/tests/test_cli.py b/tests/test_cli.py
index 0b4b1b5..729c0d8 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -63,6 +63,52 @@ def test_top_json(sample_log, capsys):
     assert json.loads(capsys.readouterr().out) == [{"count": 1, "message": "worker crashed"}]
 
 
+def test_sources_counts_each_file_in_order(sample_log, tmp_path, capsys):
+    other = tmp_path / "other.log"
+    other.write_text("2026-03-05T08:00:00Z CRITICAL db: disk full\n\n", encoding="utf-8")
+    assert main(["sources", str(other), str(sample_log)]) == 0
+    captured = capsys.readouterr()
+    assert captured.err == ""
+    lines = captured.out.splitlines()
+    assert lines[0].split() == ["file", "count"]
+    assert [line.split() for line in lines[1:]] == [[str(other), "1"], [str(sample_log), "8"]]
+
+
+def test_sources_no_header_omits_header_line(sample_log, tmp_path, capsys):
+    other = tmp_path / "other.log"
+    other.write_text("2026-03-05T08:00:00Z CRITICAL db: disk full\n", encoding="utf-8")
+    assert main(["sources", str(sample_log), str(other), "--no-header"]) == 0
+    lines = capsys.readouterr().out.splitlines()
+    assert len(lines) == 2
+    assert [line.split() for line in lines] == [[str(sample_log), "8"], [str(other), "1"]]
+
+
+def test_sources_reports_empty_file_with_zero(tmp_path, capsys):
+    empty = tmp_path / "empty.log"
+    empty.write_text("\n\n", encoding="utf-8")
+    assert main(["sources", str(empty), "--no-header"]) == 0
+    assert capsys.readouterr().out.split() == [str(empty), "0"]
+
+
+def test_sources_lists_repeated_file_twice(sample_log, capsys):
+    assert main(["sources", str(sample_log), str(sample_log), "--no-header"]) == 0
+    lines = capsys.readouterr().out.splitlines()
+    assert [line.split() for line in lines] == [[str(sample_log), "8"], [str(sample_log), "8"]]
+
+
+def test_sources_missing_file_is_an_error(sample_log, tmp_path, capsys):
+    missing = tmp_path / "nope.log"
+    assert main(["sources", str(sample_log), str(missing)]) == 1
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert captured.err == f"logsift: error: cannot read {missing}: No such file or directory\n"
+
+
+def test_sources_requires_a_file(capsys):
+    assert main(["sources"]) == 2
+    assert "FILE" in capsys.readouterr().err
+
+
 def test_export_writes_jsonl(sample_log, tmp_path, capsys):
     out = tmp_path / "errors.jsonl"
     assert main(["export", str(sample_log), "--level", "CRITICAL", "-o", str(out)]) == 0
