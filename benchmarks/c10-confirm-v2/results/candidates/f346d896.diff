diff --git a/logsift/cli.py b/logsift/cli.py
index 6b10833..7815b55 100644
--- a/logsift/cli.py
+++ b/logsift/cli.py
@@ -68,6 +68,13 @@ def cmd_top(args: argparse.Namespace, config: Config) -> int:
     return 0
 
 
+def cmd_sources(args: argparse.Namespace, config: Config) -> int:
+    # Each file is read on its own so that a file with no records still gets a row.
+    rows = [(path, len(read_records([path]))) for path in args.files]
+    sys.stdout.write(render_table(["file", "count"], rows, header=not args.no_header))
+    return 0
+
+
 def cmd_export(args: argparse.Namespace, config: Config) -> int:
     records = filter_records(read_records(args.files), min_level=args.level, ignore=config.ignore)
     write_text(args.output, records_to_jsonl(records), force=args.force)
@@ -103,6 +110,11 @@ def build_parser() -> argparse.ArgumentParser:
     top.add_argument("--format", choices=["text", "json"], default="text", help="output format")
     top.set_defaults(handler=cmd_top)
 
+    sources = commands.add_parser("sources", help="count the records in each file")
+    sources.add_argument("files", nargs="+", metavar="FILE", help="log files to count")
+    sources.add_argument("--no-header", action="store_true", help="omit the header line, for scripts")
+    sources.set_defaults(handler=cmd_sources)
+
     export = commands.add_parser("export", help="write records to a JSON Lines file")
     export.add_argument("files", nargs="+", metavar="FILE", help="log files to read")
     export.add_argument("-o", "--output", required=True, metavar="PATH", help="file to write")
