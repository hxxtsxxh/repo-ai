diff --git a/tests/test_cli.py b/tests/test_cli.py
index 0b4b1b5..6a28400 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -36,6 +36,62 @@ def test_summary_of_several_files(sample_log, tmp_path, capsys):
     ]
 
 
+def test_sources_text_counts_each_file(sample_log, tmp_path, capsys):
+    other = tmp_path / "other.log"
+    other.write_text("2026-03-05T08:00:00Z CRITICAL db: disk full\n", encoding="utf-8")
+    assert main(["sources", str(sample_log), str(other)]) == 0
+    captured = capsys.readouterr()
+    lines = captured.out.splitlines()
+    assert lines[0].split() == ["file", "count"]
+    assert [line.rsplit(maxsplit=1) for line in lines[1:]] == [[str(sample_log), "8"], [str(other), "1"]]
+    assert captured.err == ""
+
+
+def test_sources_no_header(sample_log, tmp_path, capsys):
+    other = tmp_path / "other.log"
+    other.write_text("2026-03-05T08:00:00Z CRITICAL db: disk full\n", encoding="utf-8")
+    assert main(["sources", str(sample_log), str(other), "--no-header"]) == 0
+    lines = capsys.readouterr().out.splitlines()
+    assert [line.rsplit(maxsplit=1) for line in lines] == [[str(sample_log), "8"], [str(other), "1"]]
+
+
+def test_sources_no_header_single_empty_file(tmp_path, capsys):
+    empty = tmp_path / "empty.log"
+    empty.write_text("", encoding="utf-8")
+    assert main(["sources", str(empty), "--no-header"]) == 0
+    assert capsys.readouterr().out == f"{empty}  0\n"
+
+
+def test_sources_orders_by_count_then_path(tmp_path, capsys):
+    one = "2026-03-05T08:00:00Z CRITICAL db: disk full\n"
+    a, b, c = tmp_path / "a.log", tmp_path / "b.log", tmp_path / "c.log"
+    a.write_text(one, encoding="utf-8")
+    b.write_text(one, encoding="utf-8")
+    c.write_text(one + "2026-03-05T08:01:00Z INFO web: ok\n", encoding="utf-8")
+    assert main(["sources", str(b), str(a), str(c), "--no-header"]) == 0
+    lines = capsys.readouterr().out.splitlines()
+    assert [line.rsplit(maxsplit=1) for line in lines] == [[str(c), "2"], [str(a), "1"], [str(b), "1"]]
+
+
+def test_sources_json(sample_log, tmp_path, capsys):
+    other = tmp_path / "other.log"
+    other.write_text("2026-03-05T08:00:00Z CRITICAL db: disk full\n", encoding="utf-8")
+    assert main(["sources", str(sample_log), str(other), "--format", "json"]) == 0
+    assert json.loads(capsys.readouterr().out) == [
+        {"count": 8, "file": str(sample_log)},
+        {"count": 1, "file": str(other)},
+    ]
+
+
+def test_sources_malformed_line_is_an_error(tmp_path, capsys):
+    path = tmp_path / "bad.log"
+    path.write_text("2026-03-04T10:00:00Z INFO web: ok\nbroken\n", encoding="utf-8")
+    assert main(["sources", str(path)]) == 1
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert captured.err == f"logsift: error: cannot parse {path} line 2: 'broken'\n"
+
+
