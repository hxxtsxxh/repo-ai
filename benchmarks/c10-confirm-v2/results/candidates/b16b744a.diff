index 8962111..40ae8e2 100644
--- a/logsift/stats.py
+++ b/logsift/stats.py
@@ -1,14 +1,40 @@
 """Counting records."""
 
 import re
-from collections import Counter
+from collections import Counter, defaultdict
 from collections.abc import Iterable
+from dataclasses import dataclass
+from datetime import datetime, timedelta
 
 from .records import LogRecord
 
 _DIGITS_RE = re.compile(r"\d+")
 
 
+@dataclass(frozen=True)
+class ComponentSpan:
+    """The records of one component and the time between its earliest and latest."""
+
+    component: str
+    count: int
+    first: datetime
+    last: datetime
+
+    @property
+    def seconds(self) -> int:
+        """The time from first to last, in whole seconds (fractions dropped)."""
+        return (self.last - self.first) // timedelta(seconds=1)
+
+
+def component_spans(records: Iterable[LogRecord]) -> list[ComponentSpan]:
+    """Summarize each component's record count and time range; highest count first, then by name."""
+    times: dict[str, list[datetime]] = defaultdict(list)
+    for record in records:
+        times[record.component].append(record.time)
+    spans = [ComponentSpan(name, len(moments), min(moments), max(moments)) for name, moments in times.items()]
+    return sorted(spans, key=lambda span: (-span.count, span.component))
+
+
 def sort_counts(counts: Counter[str]) -> list[tuple[str, int]]:
     """Order counted keys by count, highest first, then by key."""
     return sorted(counts.items(), key=lambda item: (-item[1], item[0]))
