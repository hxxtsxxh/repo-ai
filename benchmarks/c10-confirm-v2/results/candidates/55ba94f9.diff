 @dataclass(frozen=True)
 class Config:
     ignore: tuple[str, ...] = ()
 
 
+def resolve_config(path: str | None, environ: Mapping[str, str]) -> Config:
+    """Return the effective settings from the config file and environment.
+
+    The config file at ``path`` is read when it is not None. The
+    ``LOGSIFT_IGNORE`` variable, a comma-separated list of components, takes
+    precedence over the file's ``ignore`` list when it is set and non-empty.
+    """
+    config = load_config(path) if path is not None else Config()
+    raw = environ.get(IGNORE_ENV_VAR, "")
+    names = tuple(item.strip() for item in raw.split(",") if item.strip())
+    if names:
+        config = Config(ignore=names)
+    return config
+
