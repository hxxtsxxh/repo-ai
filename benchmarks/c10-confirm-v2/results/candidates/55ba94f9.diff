@@ -0,0 +1,60 @@
+import pytest
+
+from logsift.config import Config, resolve_config
+from logsift.errors import ConfigError
+
+
+def write_config(tmp_path, content):
+    path = tmp_path / "logsift.toml"
+    path.write_text(content, encoding="utf-8")
+    return str(path)
+
+
+def test_no_path_and_no_environment_gives_defaults():
+    assert resolve_config(None, {}) == Config()
+
+
+def test_file_only(tmp_path):
+    path = write_config(tmp_path, '[logsift]\nignore = ["healthcheck"]\n')
+    assert resolve_config(path, {}) == Config(ignore=("healthcheck",))
+
+
+def test_environment_only():
+    assert resolve_config(None, {"LOGSIFT_IGNORE": "web,metrics"}) == Config(
+        ignore=("web", "metrics")
+    )
+
+
+def test_environment_overrides_file(tmp_path):
+    path = write_config(tmp_path, '[logsift]\nignore = ["healthcheck"]\n')
+    assert resolve_config(path, {"LOGSIFT_IGNORE": "web"}) == Config(ignore=("web",))
+
+
+@pytest.mark.parametrize("value", ["", " ", " , ,"])
+def test_empty_environment_value_keeps_file_setting(tmp_path, value):
+    path = write_config(tmp_path, '[logsift]\nignore = ["healthcheck"]\n')
+    assert resolve_config(path, {"LOGSIFT_IGNORE": value}) == Config(ignore=("healthcheck",))
+
+
+def test_environment_list_is_trimmed_and_drops_empty_items():
+    environ = {"LOGSIFT_IGNORE": " web , ,metrics,"}
+    assert resolve_config(None, environ) == Config(ignore=("web", "metrics"))
+
+
+def test_other_environment_variables_are_ignored(tmp_path):
+    path = write_config(tmp_path, '[logsift]\nignore = ["healthcheck"]\n')
+    assert resolve_config(path, {"HOME": "/x", "LOGSIFT_OTHER": "y"}) == Config(
+        ignore=("healthcheck",)
+    )
+
+
+def test_missing_file_raises_config_error(tmp_path):
+    missing = str(tmp_path / "absent.toml")
+    with pytest.raises(ConfigError, match="cannot read"):
+        resolve_config(missing, {})
+
+
+def test_invalid_file_still_raises_even_with_environment_value(tmp_path):
+    path = write_config(tmp_path, '[logsift]\ncolour = true\n')
+    with pytest.raises(ConfigError, match="unknown setting 'colour'"):
+        resolve_config(path, {"LOGSIFT_IGNORE": "web"})
