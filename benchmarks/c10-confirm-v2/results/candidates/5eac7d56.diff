diff --git a/tests/test_cli.py b/tests/test_cli.py
index 0b4b1b5..1288b7e 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -114,6 +114,56 @@ def test_malformed_line_is_an_error(tmp_path, capsys):
     assert captured.err == f"logsift: error: cannot parse {path} line 2: 'broken'\n"
 
 
+BAD_LOG = (
+    "2026-03-04T10:00:00Z INFO web: ok\n"
+    "broken\n"
+    "\n"
+    "2026-03-04T10:01:00Z ERROR db: connection lost\n"
+    "2026-03-04T10:0\n"
+    "2026-03-04T10:02:00 WARNING db: no zone\n"
+)
+
+
+def test_summary_fails_on_malformed_line_by_default(tmp_path, capsys):
+    path = tmp_path / "bad.log"
+    path.write_text(BAD_LOG, encoding="utf-8")
+    assert main(["summary", str(path)]) == 1
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert captured.err == f"logsift: error: cannot parse {path} line 2: 'broken'\n"
+
+
+def test_skip_invalid_counts_valid_records_and_reports_each_skipped_line(tmp_path, capsys):
+    path = tmp_path / "bad.log"
+    path.write_text(BAD_LOG, encoding="utf-8")
+    assert main(["summary", str(path), "--skip-invalid", "--format", "json"]) == 0
+    captured = capsys.readouterr()
+    assert {row["level"]: row["count"] for row in json.loads(captured.out)} == {"INFO": 1, "ERROR": 1}
+    assert captured.err == (
+        f"logsift: skipped cannot parse {path} line 2: 'broken'\n"
+        f"logsift: skipped cannot parse {path} line 5: '2026-03-04T10:0'\n"
+        f"logsift: skipped cannot parse {path} line 6: '2026-03-04T10:02:00 WARNING db: no zone'\n"
+    )
+
+
+def test_skip_invalid_on_clean_file_changes_nothing(sample_log, capsys):
+    assert main(["summary", str(sample_log), "--skip-invalid", "--by", "component", "--format", "json"]) == 0
+    captured = capsys.readouterr()
+    assert json.loads(captured.out) == [
+        {"component": "db", "count": 4},
+        {"component": "web", "count": 3},
+        {"component": "healthcheck", "count": 1},
+    ]
+    assert captured.err == ""
+
+
+def test_skip_invalid_only_applies_to_summary(tmp_path, capsys):
+    path = tmp_path / "bad.log"
+    path.write_text(BAD_LOG, encoding="utf-8")
+    assert main(["filter", str(path), "--skip-invalid"]) == 2
+    assert "unrecognized arguments: --skip-invalid" in capsys.readouterr().err
+
+
 def test_config_ignore_applies_to_reports(sample_log, tmp_path, capsys):
     config = tmp_path / "logsift.toml"
     config.write_text('[logsift]\nignore = ["healthcheck"]\n', encoding="utf-8")
