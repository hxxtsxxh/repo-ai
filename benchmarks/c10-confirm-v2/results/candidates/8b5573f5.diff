diff --git a/tests/test_cli.py b/tests/test_cli.py
index 0b4b1b5..5e39103 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -49,6 +49,72 @@ def test_filter_grep(sample_log, capsys):
     assert capsys.readouterr().out == "2026-03-04T10:01:00Z WARNING db: slow query took 1200 ms\n"
 
 
+def test_filter_output_writes_matching_lines_to_file(sample_log, tmp_path, capsys):
+    out = tmp_path / "web-errors.log"
+    assert main(["filter", str(sample_log), "--level", "error", "--component", "web", "-o", str(out)]) == 0
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert captured.err == f"logsift: wrote 2 lines to {out}\n"
+    assert out.read_text(encoding="utf-8") == (
+        "2026-03-04T10:04:00Z ERROR web: request 991 failed\n"
+        "2026-03-04T10:05:00Z CRITICAL web: worker crashed\n"
+    )
+
+
+def test_filter_output_long_option_and_single_line_wording(sample_log, tmp_path, capsys):
+    out = tmp_path / "slow.log"
+    assert main(["filter", str(sample_log), "--grep", "slow", "--output", str(out)]) == 0
+    assert capsys.readouterr().err == f"logsift: wrote 1 line to {out}\n"
+    assert out.read_text(encoding="utf-8") == "2026-03-04T10:01:00Z WARNING db: slow query took 1200 ms\n"
+
+
+def test_filter_output_with_no_matches_writes_empty_file(sample_log, tmp_path, capsys):
+    out = tmp_path / "none.log"
+    assert main(["filter", str(sample_log), "--grep", "no such text", "-o", str(out)]) == 0
+    assert capsys.readouterr().err == f"logsift: wrote 0 lines to {out}\n"
+    assert out.read_bytes() == b""
+
+
+def test_filter_output_refuses_existing_file(sample_log, tmp_path, capsys):
+    out = tmp_path / "keep.log"
+    out.write_text("keep\n", encoding="utf-8")
+    assert main(["filter", str(sample_log), "-o", str(out)]) == 1
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert captured.err == f"logsift: error: {out} already exists (use --force to overwrite)\n"
+    assert out.read_text(encoding="utf-8") == "keep\n"
+
+
+def test_filter_output_force_replaces_existing_file(sample_log, tmp_path, capsys):
+    out = tmp_path / "old.log"
+    out.write_text("old\n", encoding="utf-8")
+    assert main(["filter", str(sample_log), "--grep", "slow", "-o", str(out), "--force"]) == 0
+    assert capsys.readouterr().err == f"logsift: wrote 1 line to {out}\n"
+    assert out.read_text(encoding="utf-8") == "2026-03-04T10:01:00Z WARNING db: slow query took 1200 ms\n"
+
+
+def test_filter_dry_run_writes_nothing(sample_log, tmp_path, capsys):
+    out = tmp_path / "planned.log"
+    assert main(["filter", str(sample_log), "--level", "error", "-o", str(out), "--dry-run"]) == 0
+    captured = capsys.readouterr()
+    assert captured.out == f"would write {out}\n"
+    assert captured.err == ""
+    assert not out.exists()
+
+
+def test_filter_dry_run_still_refuses_existing_file(sample_log, tmp_path, capsys):
+    out = tmp_path / "keep.log"
+    out.write_text("keep\n", encoding="utf-8")
+    assert main(["filter", str(sample_log), "-o", str(out), "--dry-run"]) == 1
+    assert capsys.readouterr().err == f"logsift: error: {out} already exists (use --force to overwrite)\n"
+    assert out.read_text(encoding="utf-8") == "keep\n"
+
+
+def test_filter_force_without_output_is_usage_error(sample_log, capsys):
+    assert main(["filter", str(sample_log), "--force"]) == 2
+    assert "--force and --dry-run require -o/--output" in capsys.readouterr().err
+
+
