diff --git a/logsift/stats.py b/logsift/stats.py
index 8962111..7cb50db 100644
--- a/logsift/stats.py
+++ b/logsift/stats.py
@@ -1,8 +1,9 @@
 """Counting records."""
 
 import re
-from collections import Counter
+from collections import Counter, defaultdict
 from collections.abc import Iterable
+from datetime import datetime, timedelta
 
 from .records import LogRecord
 
@@ -19,6 +20,25 @@ def count_by(records: Iterable[LogRecord], field: str) -> list[tuple[str, int]]:
     return sort_counts(Counter(getattr(record, field) for record in records))
 
 
+def span_by_component(
+    records: Iterable[LogRecord],
+) -> list[tuple[str, int, datetime, datetime, timedelta]]:
+    """For each component, return ``(component, count, first, last, duration)``.
+
+    Components are ordered by name; ``duration`` is the time from the first
+    record to the last one.
+    """
+    times: dict[str, list[datetime]] = defaultdict(list)
+    for record in records:
+        times[record.component].append(record.time)
+    spans = []
+    for component in sorted(times):
+        stamps = times[component]
+        first, last = min(stamps), max(stamps)
+        spans.append((component, len(stamps), first, last, last - first))
+    return spans
+
+
 def normalize_message(message: str) -> str:
     """Replace every run of digits with ``#`` so that similar messages group together."""
     return _DIGITS_RE.sub("#", message)
