+def test_span_text(sample_log, capsys):
+    assert main(["span", str(sample_log)]) == 0
+    captured = capsys.readouterr()
+    lines = [line.split() for line in captured.out.splitlines()]
+    assert lines == [
+        ["component", "count", "first", "last", "duration"],
+        ["db", "4", "2026-03-04T10:00:05+00:00", "2026-03-04T10:02:30+00:00", "145.0"],
+        ["healthcheck", "1", "2026-03-04T10:03:00+00:00", "2026-03-04T10:03:00+00:00", "0.0"],
+        ["web", "3", "2026-03-04T10:00:00+00:00", "2026-03-04T10:05:00+00:00", "300.0"],
+    ]
+    assert captured.err == ""
+
+
