diff --git a/tests/test_cli.py b/tests/test_cli.py
index 0b4b1b5..d82128c 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -114,6 +114,78 @@ def test_malformed_line_is_an_error(tmp_path, capsys):
     assert captured.err == f"logsift: error: cannot parse {path} line 2: 'broken'\n"
 
 
+MIXED = (
+    "2026-03-04T10:00:00Z INFO web: ok\n"
+    "broken\n"
+    "\n"
+    "2026-03-04T10:01:00Z ERROR db: connection lost\n"
+    "2026-03-04T10:02:00 INFO web: no zone in timestamp\n"
+)
+
+
+def test_summary_fails_on_bad_line_without_skip_invalid(tmp_path, capsys):
+    path = tmp_path / "mixed.log"
+    path.write_text(MIXED, encoding="utf-8")
+    assert main(["summary", str(path), "--format", "json"]) == 1
+    captured = capsys.readouterr()
+    assert captured.out == ""
+    assert captured.err == f"logsift: error: cannot parse {path} line 2: 'broken'\n"
+
+
+def test_summary_skip_invalid_counts_valid_records_and_warns(tmp_path, capsys):
+    path = tmp_path / "mixed.log"
+    path.write_text(MIXED, encoding="utf-8")
+    assert main(["summary", str(path), "--skip-invalid", "--format", "json"]) == 3
+    captured = capsys.readouterr()
+    assert json.loads(captured.out) == [
+        {"count": 1, "level": "ERROR"},
+        {"count": 1, "level": "INFO"},
+    ]
+    assert captured.err == (
+        f"logsift: warning: {path}:2: skipped unparseable line\n"
+        f"logsift: warning: {path}:5: skipped unparseable line\n"
+    )
+
+
+def test_summary_skip_invalid_text_report(tmp_path, capsys):
+    path = tmp_path / "mixed.log"
+    path.write_text(MIXED, encoding="utf-8")
+    assert main(["summary", str(path), "--skip-invalid"]) == 3
+    captured = capsys.readouterr()
+    assert captured.out.splitlines()[0].split() == ["level", "count"]
+    assert captured.out.count("\n") == 3
+    assert captured.err.count("logsift: warning: ") == 2
+
+
+def test_summary_skip_invalid_reports_each_file_in_order(tmp_path, capsys):
+    first = tmp_path / "first.log"
+    second = tmp_path / "second.log"
+    first.write_text("junk\n2026-03-04T10:00:00Z INFO web: ok\n", encoding="utf-8")
+    second.write_text("2026-03-04T10:01:00Z ERROR db: lost\nnope\n", encoding="utf-8")
+    assert main(["summary", str(first), str(second), "--skip-invalid", "--format", "json"]) == 3
+    captured = capsys.readouterr()
+    assert json.loads(captured.out) == [
+        {"count": 1, "level": "ERROR"},
+        {"count": 1, "level": "INFO"},
+    ]
+    assert captured.err == (
+        f"logsift: warning: {first}:1: skipped unparseable line\n"
+        f"logsift: warning: {second}:2: skipped unparseable line\n"
+    )
+
+
+def test_summary_skip_invalid_without_bad_lines_is_quiet(sample_log, capsys):
+    assert main(["summary", str(sample_log), "--skip-invalid", "--format", "json"]) == 0
+    captured = capsys.readouterr()
+    assert json.loads(captured.out)[0] == {"count": 3, "level": "ERROR"}
+    assert captured.err == ""
+
+
+def test_skip_invalid_is_only_for_summary(sample_log, capsys):
+    assert main(["filter", str(sample_log), "--skip-invalid"]) == 2
+    assert "unrecognized arguments: --skip-invalid" in capsys.readouterr().err
+
+
