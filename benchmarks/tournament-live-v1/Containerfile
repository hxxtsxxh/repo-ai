FROM docker.io/library/python:3.12-slim@sha256:b224e2fe306f9d303251ada22961635e5b52a69c0414a0050611be31c59f5f5b
RUN apt-get update -q && apt-get install -y -q --no-install-recommends nodejs && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir pytest && node --version && python -m pytest --version
