{
  "py-shop": {
    "language": "python",
    "visible_tests": [
      [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-t",
        "."
      ]
    ],
    "toolchain": [
      "python"
    ]
  },
  "ts-workspace": {
    "language": "typescript",
    "visible_tests": [
      [
        "{node}",
        "--test",
        "{glob:packages/*/test/*.test.ts}"
      ]
    ],
    "toolchain": [
      "node"
    ]
  },
  "java-ledger": {
    "language": "java",
    "visible_tests": [
      [
        "javac",
        "-d",
        "{out}",
        "{glob:src/main/java/**/*.java}",
        "{glob:src/test/java/**/*.java}"
      ],
      [
        "java",
        "-cp",
        "{out}",
        "com.example.ledger.AllTests"
      ]
    ],
    "toolchain": [
      "javac",
      "java"
    ]
  },
