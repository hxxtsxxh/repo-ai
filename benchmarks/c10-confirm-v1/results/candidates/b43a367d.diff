+def movement_lines(inventory, sku=None):
+    """One line per movement: "<timestamp> <SKU> <delta> <reason>".
+
+    The timestamp is ISO 8601 (so it contains no spaces) and the delta
+    always carries an explicit sign (``+5``, ``-2``). With ``sku`` given,
+    only that item's movements are listed.
+    """
+    return tuple(
+        f"{m.at.isoformat()} {m.sku} {m.delta:+d} {m.reason}"
+        for m in inventory.history(sku)
+    )
