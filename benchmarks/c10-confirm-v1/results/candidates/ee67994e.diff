@@ -56,6 +57,26 @@ class Inventory:
         self._movements.append(Movement(sku, -qty, "issue", at))
         return self._on_hand[sku]
 
+    def issue_many(self, lines, at):
+        """Issue several ``(sku, qty)`` lines as one batch and return the batch id.
+
+        Each line is issued exactly like :meth:`issue`, in order. The batch is
+        all-or-nothing: if any line fails, earlier lines are rolled back and the
+        error propagates. Batch ids look like ``BAT-0001``.
+        """
+        lines = tuple(lines)
+        on_hand = dict(self._on_hand)
+        mark = len(self._movements)
+        try:
+            for sku, qty in lines:
+                self.issue(sku, qty, at)
+        except Exception:
+            self._on_hand = on_hand
+            del self._movements[mark:]
+            raise
+        self._batch_count += 1
+        return f"BAT-{self._batch_count:04d}"
+
