+def test_issue_many(inv):
+    inv.receive("BLT-0001", 10, T0)
+    inv.receive("NUT-0001", 10, T0)
+    batch = inv.issue_many([("blt-0001", 3), ("NUT-0001", 4), ("BLT-0001", 2)], T0)
+    assert batch == "BAT-0001"
+    assert inv.on_hand("BLT-0001") == 5
+    assert inv.on_hand("NUT-0001") == 6
+    assert [(m.sku, m.delta, m.reason, m.at) for m in inv.history()[2:]] == [
+        ("BLT-0001", -3, "issue", T0),
+        ("NUT-0001", -4, "issue", T0),
+        ("BLT-0001", -2, "issue", T0),
+    ]
+    assert inv.issue_many([("BLT-0001", 1)], T0) == "BAT-0002"
+
+
+def test_issue_many_failure_rolls_back(inv):
+    inv.receive("BLT-0001", 5, T0)
+    with pytest.raises(InsufficientStockError):
+        inv.issue_many([("BLT-0001", 3), ("BLT-0001", 3)], T0)
+    assert inv.on_hand("BLT-0001") == 5
+    assert len(inv.history()) == 1
+
+
