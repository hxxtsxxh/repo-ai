+from datetime import timedelta
+
 import pytest
 
 from conftest import T0
 from stockroom import (
     DuplicateSkuError,
     InsufficientStockError,
+    InvalidPeriodError,
     InvalidQuantityError,
     Item,
     UnknownSkuError,
@@ -55,6 +58,28 @@ def test_history_order_and_sign(inv):
     assert [m.delta for m in inv.history("blt-0001")] == [5, -2]
 
 
+def test_movements_between_is_half_open(inv):
+    t1, t2, t3 = T0 + timedelta(hours=1), T0 + timedelta(hours=2), T0 + timedelta(hours=3)
+    inv.receive("BLT-0001", 10, T0)
+    inv.receive("WSH-0001", 7, t1)
+    inv.issue("BLT-0001", 2, t2)
+    inv.receive("BLT-0001", 1, t3)
+
+    result = inv.movements_between(t1, t3)
+    assert isinstance(result, tuple)
+    assert [(m.sku, m.delta) for m in result] == [("WSH-0001", 7), ("BLT-0001", -2)]
+    assert [m.delta for m in inv.movements_between(T0, t3, sku="blt-0001")] == [10, -2]
+    assert inv.movements_between(t3 + timedelta(hours=1), t3 + timedelta(hours=2)) == ()
+
+
+def test_movements_between_invalid_period(inv):
+    with pytest.raises(InvalidPeriodError) as exc:
+        inv.movements_between(T0, T0)
+    assert str(exc.value) == "period start must be before end"
+    with pytest.raises(UnknownSkuError):
+        inv.movements_between(T0, T0 + timedelta(days=1), sku="ZZZ-9999")
+
+
 def test_items_sorted_by_sku(inv):
     inv.add_item(Item("AAA-0001", "Anchor", 100))
     assert [i.sku for i in inv.items()] == ["AAA-0001", "BLT-0001", "NUT-0001", "WSH-0001"]
