+def test_issue_many(inv):
+    inv.receive("BLT-0001", 10, T0)
+    inv.receive("NUT-0001", 5, T0)
+    assert inv.issue_many([("blt-0001", 4), ("NUT-0001", 5), ("BLT-0001", 1)], T0) == "BAT-000001"
+    assert inv.issue_many([("BLT-0001", 1)], T0) == "BAT-000002"
+    assert [(m.sku, m.delta) for m in inv.history()][2:6] == [
+        ("BLT-0001", -4),
+        ("NUT-0001", -5),
+        ("BLT-0001", -1),
+        ("BLT-0001", -1),
+    ]
+    assert inv.on_hand("BLT-0001") == 4
+
+
+def test_issue_many_is_all_or_nothing(inv):
+    inv.receive("BLT-0001", 5, T0)
+    before = inv.history()
+    with pytest.raises(InsufficientStockError) as exc:
+        inv.issue_many([("BLT-0001", 3), ("BLT-0001", 3), ("ZZZ-9999", 1)], T0)
+    assert str(exc.value) == "insufficient stock for BLT-0001: requested 3, on hand 2"
+    with pytest.raises(UnknownSkuError):
+        inv.issue_many([("BLT-0001", 1), ("ZZZ-9999", 1)], T0)
+    assert inv.on_hand("BLT-0001") == 5
+    assert inv.history() == before
+    assert inv.issue_many([("BLT-0001", 1)], T0) == "BAT-000001"
+
+
