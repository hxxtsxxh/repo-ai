@@ -1,5 +1,9 @@
 """Stock valuation at unit cost. All amounts are integer cents."""
 
+from decimal import ROUND_HALF_UP, Decimal
+
+from stockroom.skus import normalize_sku
+
 
 def item_value_cents(inventory, sku):
     item = inventory.item(sku)
@@ -8,3 +12,18 @@ def item_value_cents(inventory, sku):
 
 def total_value_cents(inventory):
     return sum(item_value_cents(inventory, item.sku) for item in inventory.items())
+
+
+def value_share_percent(inventory, sku):
+    """Return the item's share of total stock value as a percentage.
+
+    The result is a ``Decimal`` on a 0-100 scale with one decimal place
+    (ROUND_HALF_UP), or ``None`` if the total stock value is zero.
+    """
+    sku = normalize_sku(sku)
+    item_cents = item_value_cents(inventory, sku)  # raises UnknownSkuError
+    total_cents = total_value_cents(inventory)
+    if total_cents == 0:
+        return None
+    share = Decimal(item_cents) * 100 / Decimal(total_cents)
+    return share.quantize(Decimal("0.1"), rounding=ROUND_HALF_UP)
