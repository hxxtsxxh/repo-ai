+    def record_count(self, counts, at):
+        """Apply a physical stock count and return its identifier (``CNT-nnnn``).
+
+        ``counts`` maps SKU to the counted number of units (a non-negative
+        int). Each SKU whose count differs from the on-hand level is set to
+        the counted quantity, with a ``count_adjust`` movement for the
+        difference. Matching SKUs get no movement. All input is validated
+        before anything is changed.
+        """
+        resolved = {}
+        for sku, counted in counts.items():
+            sku = self.item(sku).sku
+            if sku in resolved:
+                raise ValueError(f"duplicate SKU in count: {sku}")
+            if isinstance(counted, bool) or not isinstance(counted, int) or counted < 0:
+                raise InvalidQuantityError(
+                    f"counted quantity must be a non-negative integer, got {counted!r}"
+                )
+            resolved[sku] = counted
+
+        self._count_seq += 1
+        for sku, counted in resolved.items():
+            previous = self._on_hand[sku]
+            if counted != previous:
+                self._on_hand[sku] = counted
+                self._movements.append(Movement(sku, counted - previous, "count_adjust", at))
+        return f"CNT-{self._count_seq:04d}"
+
