+def test_record_count(inv):
+    inv.receive("BLT-0001", 10, T0)
+    inv.receive("NUT-0001", 4, T0)
+    cid = inv.record_count({"blt-0001": 7, "NUT-0001": 4, "WSH-0001": 3}, T0)
+    assert cid.startswith("CNT")
+    assert [inv.on_hand(s) for s in ("BLT-0001", "NUT-0001", "WSH-0001")] == [7, 4, 3]
+    adjustments = [(m.sku, m.delta, m.at) for m in inv.history() if m.reason == "count_adjust"]
+    assert adjustments == [("BLT-0001", -3, T0), ("WSH-0001", 3, T0)]
+    assert inv.record_count({"BLT-0001": 7}, T0) != cid
+    assert len(inv.history()) == 4
+
+
+def test_record_count_invalid_changes_nothing(inv):
+    inv.receive("BLT-0001", 10, T0)
+    for bad in (-1, 1.5, True, "3"):
+        with pytest.raises(InvalidQuantityError):
+            inv.record_count({"BLT-0001": 2, "NUT-0001": bad}, T0)
+    with pytest.raises(UnknownSkuError):
+        inv.record_count({"BLT-0001": 2, "ZZZ-9999": 1}, T0)
+    assert inv.on_hand("BLT-0001") == 10
+    assert len(inv.history()) == 1
+
