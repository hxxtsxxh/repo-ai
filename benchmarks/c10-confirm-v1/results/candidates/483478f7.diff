@@ -0,0 +1,19 @@
+"""Report the fastest-moving items over a period."""
+
+from stockroom.errors import InvalidPeriodError
+
+
+def top_movers(inventory, start, end, n):
+    """Return up to ``n`` ``(sku, units_issued)`` pairs, most issued first.
+
+    Only ``"issue"`` movements with ``start <= at < end`` count. Ties are
+    broken by SKU ascending. SKUs with no issues in the period are omitted.
+    """
+    if start >= end:
+        raise InvalidPeriodError("period start must be before end")
+    issued = {}
+    for movement in inventory.history():
+        if movement.reason == "issue" and start <= movement.at < end:
+            issued[movement.sku] = issued.get(movement.sku, 0) - movement.delta
+    ranked = sorted(issued.items(), key=lambda pair: (-pair[1], pair[0]))
+    return tuple(ranked[: max(n, 0)])
