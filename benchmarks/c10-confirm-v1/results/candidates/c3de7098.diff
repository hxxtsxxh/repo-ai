+    def record_count(self, counts, at):
+        """Apply a physical stock count and return its ``CNT-nnnnnn`` identifier.
+
+        ``counts`` maps SKU to the counted number of units. Every line is
+        validated first; if any fails, nothing is changed. SKUs whose count
+        equals the on-hand level get no movement.
+        """
+        validated = {}
+        for raw_sku, counted in counts.items():
+            sku = self.item(raw_sku).sku
+            validated[sku] = require_non_negative_quantity(counted)
+
+        for sku, counted in validated.items():
+            delta = counted - self._on_hand[sku]
+            if delta == 0:
+                continue
+            self._on_hand[sku] = counted
+            self._movements.append(Movement(sku, delta, "count_adjust", at))
+            if delta < 0:
+                logger.warning("count_adjust %d x %s", -delta, sku)
+
+        return self._next_id("CNT")
+
+    def _next_id(self, prefix):
+        n = self._counters.get(prefix, 0) + 1
+        self._counters[prefix] = n
+        return f"{prefix}-{n:06d}"
+
