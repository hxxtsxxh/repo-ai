+def test_record_count(inv, caplog):
+    inv.receive("BLT-0001", 10, T0)
+    inv.receive("NUT-0001", 5, T0)
+    inv.receive("WSH-0001", 4, T0)
+    with caplog.at_level("WARNING", logger="stockroom"):
+        cid = inv.record_count({"blt-0001": 7, "NUT-0001": 8, "WSH-0001": 4}, T0)
+    assert cid == "CNT-000001"
+    assert [inv.on_hand(s) for s in ("BLT-0001", "NUT-0001", "WSH-0001")] == [7, 8, 4]
+    adjusts = [m for m in inv.history() if m.reason == "count_adjust"]
+    assert [(m.sku, m.delta, m.at) for m in adjusts] == [
+        ("BLT-0001", -3, T0),
+        ("NUT-0001", 3, T0),
+    ]
+    assert [r.getMessage() for r in caplog.records] == ["count_adjust 3 x BLT-0001"]
+    assert inv.record_count({"BLT-0001": 7}, T0) == "CNT-000002"
+
+
+def test_record_count_is_all_or_nothing(inv):
+    inv.receive("BLT-0001", 10, T0)
+    before = inv.history()
+    with pytest.raises(UnknownSkuError):
+        inv.record_count({"BLT-0001": 1, "ZZZ-9999": 2}, T0)
+    with pytest.raises(InvalidQuantityError):
+        inv.record_count({"BLT-0001": 1, "NUT-0001": -1}, T0)
+    assert inv.on_hand("BLT-0001") == 10
+    assert inv.history() == before
+    assert inv.record_count({}, T0) == "CNT-000001"
+
+
