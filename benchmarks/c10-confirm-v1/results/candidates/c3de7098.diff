diff --git a/stockroom/quantities.py b/stockroom/quantities.py
index 1f77ad1..f47fe48 100644
--- a/stockroom/quantities.py
+++ b/stockroom/quantities.py
@@ -11,3 +11,15 @@ def require_positive_quantity(qty):
     if isinstance(qty, bool) or not isinstance(qty, int) or qty <= 0:
         raise InvalidQuantityError(f"quantity must be a positive integer, got {qty!r}")
     return qty
+
+
+def require_non_negative_quantity(qty):
+    """Return ``qty`` unchanged if it is an int >= 0, else raise.
+
+    ``bool`` is rejected even though it is a subclass of ``int``.
+    """
+    if isinstance(qty, bool) or not isinstance(qty, int) or qty < 0:
+        raise InvalidQuantityError(
+            f"quantity must be a non-negative integer, got {qty!r}"
+        )
+    return qty
