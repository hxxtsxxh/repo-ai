         return tuple(m for m in self._movements if m.sku == sku)
+
+    def movements_between(self, start, end, sku=None):
+        """Return movements with ``start <= at < end``, in recorded order.
+
+        With ``sku`` given, only that item's movements are returned.
+        Raises ``InvalidPeriodError`` if ``start`` is not before ``end``.
+        """
+        if start >= end:
+            raise InvalidPeriodError()
+        return tuple(m for m in self.history(sku) if start <= m.at < end)
diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 567f0ba..1ba379a 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -1,15 +1,39 @@
+from datetime import timedelta
+
 import pytest
 
 from conftest import T0
 from stockroom import (
     DuplicateSkuError,
     InsufficientStockError,
+    InvalidPeriodError,
     InvalidQuantityError,
     Item,
     UnknownSkuError,
 )
 
 
+def test_movements_between_is_half_open_and_filters_sku(inv):
+    t1, t2, t3 = (T0 + timedelta(hours=h) for h in (1, 2, 3))
+    inv.receive("BLT-0001", 10, T0)
+    inv.receive("NUT-0001", 5, t1)
+    inv.issue("BLT-0001", 4, t2)
+    inv.receive("BLT-0001", 1, t3)
+
+    got = inv.movements_between(t1, t3)
+    assert isinstance(got, tuple)
+    assert [m.at for m in got] == [t1, t2]  # start inclusive, end exclusive
+    assert [m.at for m in inv.movements_between(t1, t3, sku="blt-0001")] == [t2]
+
+
+def test_movements_between_invalid_period(inv):
+    with pytest.raises(InvalidPeriodError) as exc:
+        inv.movements_between(T0, T0)
+    assert str(exc.value) == "period start must be before end"
+    with pytest.raises(UnknownSkuError):
+        inv.movements_between(T0, T0 + timedelta(hours=1), sku="ZZZ-9999")
+
+
 def test_receive_and_issue(inv):
     assert inv.receive("blt-0001", 50, T0) == 50
     assert inv.issue("BLT-0001", 20, T0) == 30
