@@ -8,3 +10,15 @@ def item_value_cents(inventory, sku):
 
 def total_value_cents(inventory):
     return sum(item_value_cents(inventory, item.sku) for item in inventory.items())
+
+
+def average_unit_cost_cents(inventory):
+    """Weighted average unit cost of stock on hand, in whole cents.
+
+    Rounded half-even. Returns None when no units are on hand.
+    """
+    total_units = sum(inventory.on_hand(item.sku) for item in inventory.items())
+    if total_units == 0:
+        return None
+    average = Decimal(total_value_cents(inventory)) / Decimal(total_units)
+    return int(average.quantize(Decimal(1), rounding=ROUND_HALF_EVEN))
