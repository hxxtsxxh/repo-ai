@@ -56,6 +57,25 @@ class Inventory:
         self._movements.append(Movement(sku, -qty, "issue", at))
         return self._on_hand[sku]
 
+    def issue_many(self, lines, at):
+        """Issue every ``(sku, qty)`` line at time ``at`` and return a batch id.
+
+        Each line is recorded exactly like :meth:`issue`, in line order. The
+        batch is all-or-nothing: if any line is invalid or stock is
+        insufficient (counting earlier lines for the same SKU), nothing is
+        issued. Batch ids look like ``BAT-0001`` and are unique per Inventory.
+        """
+        lines = [(self.item(sku).sku, require_positive_quantity(qty)) for sku, qty in lines]
+        remaining = dict(self._on_hand)
+        for sku, qty in lines:
+            if qty > remaining[sku]:
+                raise InsufficientStockError(sku, qty, remaining[sku])
+            remaining[sku] -= qty
+        for sku, qty in lines:
+            self.issue(sku, qty, at)
+        self._batch_count += 1
+        return f"BAT-{self._batch_count:04d}"
+
