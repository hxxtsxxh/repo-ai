diff --git a/tests/test_issue_many.py b/tests/test_issue_many.py
new file mode 100644
index 0000000..374c5fd
--- /dev/null
+++ b/tests/test_issue_many.py
@@ -0,0 +1,46 @@
+import pytest
+
+from conftest import T0
+from stockroom import InsufficientStockError, InvalidQuantityError, UnknownSkuError
+
+
+def test_issue_many_records_in_order_and_returns_batch_id(inv):
+    inv.receive("BLT-0001", 10, T0)
+    inv.receive("NUT-0001", 10, T0)
+    before = len(inv.history())
+    assert inv.issue_many([("nut-0001", 3), ("BLT-0001", 4)], T0) == "BAT-000001"
+    assert [(m.sku, m.delta, m.reason, m.at) for m in inv.history()[before:]] == [
+        ("NUT-0001", -3, "issue", T0),
+        ("BLT-0001", -4, "issue", T0),
+    ]
+    assert inv.on_hand("NUT-0001") == 7
+    assert inv.on_hand("BLT-0001") == 6
+    assert inv.issue_many([("BLT-0001", 1)], T0) == "BAT-000002"
+
+
+def test_issue_many_is_all_or_nothing(inv):
+    inv.receive("BLT-0001", 5, T0)
+    inv.receive("NUT-0001", 1, T0)
+    before = inv.history()
+    with pytest.raises(InsufficientStockError) as exc:
+        inv.issue_many([("BLT-0001", 2), ("NUT-0001", 2), ("ZZZ-9999", 1)], T0)
+    assert str(exc.value) == "insufficient stock for NUT-0001: requested 2, on hand 1"
+    assert inv.on_hand("BLT-0001") == 5
+    assert inv.history() == before
+
+
+def test_issue_many_counts_repeated_sku_cumulatively(inv):
+    inv.receive("BLT-0001", 5, T0)
+    with pytest.raises(InsufficientStockError) as exc:
+        inv.issue_many([("BLT-0001", 3), ("BLT-0001", 3)], T0)
+    assert str(exc.value) == "insufficient stock for BLT-0001: requested 3, on hand 2"
+    assert inv.on_hand("BLT-0001") == 5
+
+
+def test_issue_many_first_failing_line_wins_and_no_id_consumed(inv):
+    inv.receive("BLT-0001", 5, T0)
+    with pytest.raises(UnknownSkuError):
+        inv.issue_many([("ZZZ-9999", 1), ("BLT-0001", 0)], T0)
+    with pytest.raises(InvalidQuantityError):
+        inv.issue_many([("BLT-0001", 0)], T0)
+    assert inv.issue_many([("BLT-0001", 1)], T0) == "BAT-000001"
