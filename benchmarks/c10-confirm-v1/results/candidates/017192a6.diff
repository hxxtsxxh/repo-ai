+    def issue_many(self, lines, at):
+        """Issue several ``(sku, qty)`` lines at once and return a batch ID.
+
+        All-or-nothing: every line is validated first (accounting for earlier
+        lines of the same SKU); the first failing line's error is raised and
+        nothing changes. The batch ID looks like ``BAT-000001``.
+        """
+        planned = []
+        remaining = {}
+        for sku, qty in lines:
+            sku = self.item(sku).sku
+            qty = require_positive_quantity(qty)
+            current = remaining.get(sku, self._on_hand[sku])
+            if qty > current:
+                raise InsufficientStockError(sku, qty, current)
+            remaining[sku] = current - qty
+            planned.append((sku, qty))
+        for sku, qty in planned:
+            self.issue(sku, qty, at)
+        return self._next_id("BAT")
+
+    def _next_id(self, prefix):
+        n = self._counters.get(prefix, 0) + 1
+        self._counters[prefix] = n
+        return f"{prefix}-{n:06d}"
+
