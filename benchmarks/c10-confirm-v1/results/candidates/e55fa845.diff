+    def _next_id(self, prefix):
+        self._counters[prefix] = self._counters.get(prefix, 0) + 1
+        return f"{prefix}-{self._counters[prefix]:06d}"
+
+    def issue_many(self, lines, at):
+        """Issue several ``(sku, qty)`` lines at once and return a ``BAT-`` batch ID.
+
+        All-or-nothing: every line is validated first (in input order, taking
+        earlier lines of the same batch into account); the first failing line's
+        error is raised and nothing is changed.
+        """
+        remaining = {}
+        validated = []
+        for sku, qty in lines:
+            sku = self.item(sku).sku
+            qty = require_positive_quantity(qty)
+            current = remaining.get(sku, self._on_hand[sku])
+            if qty > current:
+                raise InsufficientStockError(sku, qty, current)
+            remaining[sku] = current - qty
+            validated.append((sku, qty))
+        for sku, qty in validated:
+            self.issue(sku, qty, at)
+        return self._next_id("BAT")
+
