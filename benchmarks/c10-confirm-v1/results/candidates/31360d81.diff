+    def _next_id(self, prefix):
+        """Return the next generated identifier for ``prefix`` (``PFX-000001``)."""
+        n = self._counters.get(prefix, 0) + 1
+        self._counters[prefix] = n
+        return f"{prefix}-{n:06d}"
+
+    def record_count(self, counts, at):
+        """Apply a physical stock count and return its ``CNT-`` identifier.
+
+        ``counts`` maps SKU to the counted units (a non-negative int). Every
+        line is validated first; if any fails, its error is raised and nothing
+        changes. SKUs whose count differs from on hand are set to the counted
+        quantity and get a ``count_adjust`` movement; matching SKUs get none.
+        """
+        planned = []
+        for raw_sku, counted in counts.items():
+            sku = self.item(raw_sku).sku
+            if isinstance(counted, bool) or not isinstance(counted, int) or counted < 0:
+                raise InvalidQuantityError(
+                    f"count must be a non-negative integer, got {counted!r}"
+                )
+            planned.append((sku, counted))
+
+        count_id = self._next_id("CNT")
+        for sku, counted in planned:
+            previous = self._on_hand[sku]
+            if counted == previous:
+                continue
+            self._on_hand[sku] = counted
+            self._movements.append(Movement(sku, counted - previous, "count_adjust", at))
+            if counted < previous:
+                logger.warning("count_adjust %d x %s", previous - counted, sku)
+        return count_id
+
