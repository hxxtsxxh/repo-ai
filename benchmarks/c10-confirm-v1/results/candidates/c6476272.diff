+
+def movement_lines(inventory, sku=None):
+    """One line per movement, in recorded order: "<timestamp> <SKU> <delta> <reason>".
+
+    With ``sku`` given, only that item's movements are rendered.
+    """
+    return tuple(
+        f"{m.at.astimezone(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')} "
+        f"{m.sku} {m.delta:+d} {m.reason}"
+        for m in inventory.history(sku)
+    )
