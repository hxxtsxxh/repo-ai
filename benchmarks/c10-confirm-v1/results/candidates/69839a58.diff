+    def _next_id(self, prefix):
+        n = self._counters.get(prefix, 0) + 1
+        self._counters[prefix] = n
+        return f"{prefix}-{n:06d}"
+
+    def record_count(self, counts, at):
+        """Apply a physical stock count and return the generated count ID.
+
+        ``counts`` maps SKU to the counted number of units (a non-negative
+        int). Every SKU whose count differs from the on-hand level is set to
+        the counted quantity and gets a ``count_adjust`` movement. The call is
+        all-or-nothing: the first invalid line (in input order) raises and
+        nothing is changed.
+        """
+        planned = []
+        seen = set()
+        for raw_sku, counted in counts.items():
+            sku = self.item(raw_sku).sku
+            if sku in seen:
+                raise DuplicateSkuError(sku)
+            seen.add(sku)
+            if isinstance(counted, bool) or not isinstance(counted, int) or counted < 0:
+                raise InvalidQuantityError(
+                    f"count must be a non-negative integer, got {counted!r}"
+                )
+            previous = self._on_hand[sku]
+            if counted != previous:
+                planned.append((sku, counted, counted - previous))
+
+        for sku, counted, delta in planned:
+            self._on_hand[sku] = counted
+            self._movements.append(Movement(sku, delta, "count_adjust", at))
+            if delta < 0:
+                logger.warning("count_adjust %d x %s", -delta, sku)
+        return self._next_id("CNT")
+
