+
+
+def value_share_percent(inventory, sku):
+    """Item's share of total stock value as a percentage (25 == a quarter).
+
+    Returns 0.0 when the total stock value is zero.
+    """
+    total = total_value_cents(inventory)
+    if total == 0:
+        return 0.0
+    return item_value_cents(inventory, sku) * 100 / total
