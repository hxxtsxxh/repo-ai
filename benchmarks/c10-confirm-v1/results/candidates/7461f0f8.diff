+    def write_off(self, sku, qty, at):
+        """Write off ``qty`` damaged, lost or expired units; return the new level."""
+        sku = self.item(sku).sku
+        qty = require_positive_quantity(qty)
+        current = self._on_hand[sku]
+        if qty > current:
+            raise InsufficientStockError(sku, qty, current)
+        self._on_hand[sku] = current - qty
+        self._movements.append(Movement(sku, -qty, "write_off", at))
+        logger.warning("write_off %d x %s", qty, sku)
+        return self._on_hand[sku]
+
