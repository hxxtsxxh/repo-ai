+def test_write_off(inv, caplog):
+    inv.receive("BLT-0001", 10, T0)
+    with caplog.at_level("WARNING", logger="stockroom"):
+        assert inv.write_off("blt-0001", 3, T0) == 7
+    assert inv.on_hand("BLT-0001") == 7
+    last = inv.history("BLT-0001")[-1]
+    assert (last.delta, last.reason, last.at) == (-3, "write_off", T0)
+    assert [r.getMessage() for r in caplog.records] == ["write_off 3 x BLT-0001"]
+
+
+def test_write_off_more_than_on_hand(inv, caplog):
+    inv.receive("BLT-0001", 2, T0)
+    with caplog.at_level("WARNING", logger="stockroom"):
+        with pytest.raises(InsufficientStockError) as exc:
+            inv.write_off("BLT-0001", 3, T0)
+    assert str(exc.value) == "insufficient stock for BLT-0001: requested 3, on hand 2"
+    assert inv.on_hand("BLT-0001") == 2
+    assert len(inv.history("BLT-0001")) == 1
+    assert not caplog.records
+
+
+@pytest.mark.parametrize("qty", [0, -1, 1.5, True, "3"])
+def test_write_off_bad_quantities(inv, qty):
+    inv.receive("BLT-0001", 5, T0)
+    with pytest.raises(InvalidQuantityError):
+        inv.write_off("BLT-0001", qty, T0)
+    assert inv.on_hand("BLT-0001") == 5
+
+
 def test_unknown_sku(inv):
