+def test_record_count(inv):
+    inv.receive("BLT-0001", 10, T0)
+    inv.receive("WSH-0001", 4, T0)
+    cid = inv.record_count({"blt-0001": 7, "WSH-0001": 4, "NUT-0001": 3}, T0)
+    assert cid.startswith("CNT")
+    assert inv.on_hand("BLT-0001") == 7
+    assert inv.on_hand("WSH-0001") == 4
+    assert inv.on_hand("NUT-0001") == 3
+    adjusts = [(m.sku, m.delta) for m in inv.history() if m.reason == "count_adjust"]
+    assert adjusts == [("BLT-0001", -3), ("NUT-0001", 3)]
+    assert inv.record_count({"BLT-0001": 7}, T0) != cid
+
+
+def test_record_count_invalid_changes_nothing(inv):
+    inv.receive("BLT-0001", 10, T0)
+    with pytest.raises(InvalidQuantityError):
+        inv.record_count({"BLT-0001": 5, "NUT-0001": -1}, T0)
+    with pytest.raises(UnknownSkuError):
+        inv.record_count({"BLT-0001": 5, "ZZZ-9999": 1}, T0)
+    assert inv.on_hand("BLT-0001") == 10
+    assert len(inv.history()) == 1
+
