+    def record_count(self, counts, at):
+        """Apply a physical stock count and return its identifier (``CNT-nnnn``).
+
+        ``counts`` maps SKU to the counted quantity (a non-negative int). Each
+        SKU whose count differs from on-hand is set to the counted quantity and
+        gets a ``count_adjust`` movement; matching SKUs get none. All input is
+        validated before anything is changed.
+        """
+        resolved = {}
+        for raw_sku, counted in counts.items():
+            sku = self.item(raw_sku).sku
+            if isinstance(counted, bool) or not isinstance(counted, int) or counted < 0:
+                raise InvalidQuantityError(
+                    f"count must be a non-negative integer, got {counted!r}"
+                )
+            resolved[sku] = counted
+        self._count_seq += 1
+        for sku, counted in resolved.items():
+            delta = counted - self._on_hand[sku]
+            if delta:
+                self._on_hand[sku] = counted
+                self._movements.append(Movement(sku, delta, "count_adjust", at))
+        return f"CNT-{self._count_seq:04d}"
+
