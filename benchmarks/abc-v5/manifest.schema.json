{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repo-ai/benchmarks/abc-v5/manifest.schema.json",
  "title": "abc-v5 immutable study manifest (stage W or FULL)",
  "type": "object",
  "additionalProperties": false,
  "required": ["study", "manifest_version", "stage", "status", "seed", "tasks", "sha256", "content_sha256", "policy"],
  "properties": {
    "study": {"const": "abc-v5"},
    "manifest_version": {"type": "integer", "enum": [1]},
    "stage": {"type": "string", "enum": ["W", "FULL"]},
    "status": {"type": "string", "enum": ["W_FROZEN_BEFORE_CANDIDATES", "CALIBRATION_FROZEN_BEFORE_ANY_ARM_RUN"]},
    "seed": {"type": "integer"},
    "policy": {"type": "string", "minLength": 20},
    "w_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "arms": {"type": "object", "minProperties": 2, "additionalProperties": {"type": "string"}},
    "decision_rules": {"type": "object", "minProperties": 2, "additionalProperties": {"type": "string"}},
    "grader_outcomes": {"type": "array", "items": {"type": "string", "enum": ["CORRECT", "FALSE_GREEN", "FAIL", "INVALID"]}, "minItems": 4},
    "primary_candidate_draw": {"type": "object", "additionalProperties": {"type": "string"}},
    "expected_control_grades": {
      "type": "object",
      "additionalProperties": {"type": "object", "additionalProperties": {"type": "string", "enum": ["CORRECT", "FALSE_GREEN", "FAIL", "INVALID"]}}
    },
    "tasks": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z0-9][a-z0-9-]{2,63}$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cluster", "language", "split", "write_paths", "test_command", "requirement_ids", "provenance_kind"],
          "properties": {
            "cluster": {"type": "string", "pattern": "^[a-z0-9_]+$"},
            "language": {"type": "string", "enum": ["python", "node"]},
            "split": {"type": "string", "enum": ["calibration", "confirmatory"]},
            "write_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Za-z0-9_./-]+$"}},
            "test_command": {"type": "string", "enum": ["python -m pytest", "node --test"]},
            "requirement_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^R[0-9]+$"}},
            "provenance_kind": {"type": "string", "enum": ["synthetic", "upstream"]},
            "upstream_url": {"type": ["string", "null"]},
            "upstream_commit": {"type": ["string", "null"]},
            "licence": {"type": "string"}
          }
        }
      },
      "additionalProperties": false
    },
    "sha256": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {"^[A-Za-z0-9_./ -]+$": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
      "additionalProperties": false
    },
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
